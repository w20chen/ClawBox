FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash ca-certificates coreutils curl findutils git grep openssh-server patch sed \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 executor \
 && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash executor \
 && passwd -d executor \
 && mkdir -p /workspace /tmp/openclaw-sandboxes /run/sshd /run/tool-sshd /home/executor/.ssh \
 && touch /home/executor/.ssh/authorized_keys \
 && chmod 0755 /run/sshd \
 && chmod 0700 /home/executor/.ssh \
 && chmod 0600 /home/executor/.ssh/authorized_keys \
 && chown -R 10001:10001 /workspace /tmp/openclaw-sandboxes /run/tool-sshd /home/executor

COPY scripts/two-sandbox/tool-entrypoint.sh /usr/local/bin/tool-entrypoint
COPY scripts/two-sandbox/tool-command.sh /usr/local/bin/tool-command
RUN chmod 0755 /usr/local/bin/tool-entrypoint /usr/local/bin/tool-command

USER 10001:10001
WORKDIR /workspace
EXPOSE 2222
ENTRYPOINT ["/usr/local/bin/tool-entrypoint"]
