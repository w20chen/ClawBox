# syntax=docker/dockerfile:1
# Production Tool image overlay for the currently supported Ubuntu 22.04
# SWE-ReBench base. The collector runs in this container and therefore loads
# BPF into the Kata/Firecracker guest kernel, never the physical host kernel.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG APT_MIRROR=
ARG KERNEL_VERSION
ARG KERNEL_SOURCE_SHA256
ARG KERNEL_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/kernel/v6.x
ARG CLAWTUNE_REVISION=unknown

USER root
RUN . /etc/os-release \
 && test "${ID}" = ubuntu \
 && test "${VERSION_ID}" = 22.04 \
 && if [ -n "${APT_MIRROR}" ]; then \
      mirror_host="${APT_MIRROR#https://}"; mirror_host="${mirror_host#http://}"; \
      sed -i -E "s@https?://(archive|ports|security)\.ubuntu\.com@http://${mirror_host}@g" \
        /etc/apt/sources.list; \
    fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      bpfcc-tools python3-bpfcc clang llvm libelf-dev \
      ca-certificates curl make gcc flex bison bc libssl-dev kmod \
      python3 python3-dev python3-pip python3-venv python3-numpy \
 && rm -rf /var/lib/apt/lists/*

COPY .artifacts/kata-debug.config /tmp/kata-debug.config
RUN test -n "${KERNEL_VERSION}" \
 && test -n "${KERNEL_SOURCE_SHA256}" \
 && curl -fL --retry 4 --connect-timeout 15 --max-time 1800 \
      "${KERNEL_MIRROR}/linux-${KERNEL_VERSION}.tar.xz" -o /tmp/linux.tar.xz \
 && printf '%s  %s\n' "${KERNEL_SOURCE_SHA256}" /tmp/linux.tar.xz | sha256sum -c - \
 && tar -C /usr/src -xf /tmp/linux.tar.xz \
 && rm /tmp/linux.tar.xz \
 && cp /tmp/kata-debug.config "/usr/src/linux-${KERNEL_VERSION}/.config" \
 && rm /tmp/kata-debug.config \
 && make -C "/usr/src/linux-${KERNEL_VERSION}" olddefconfig prepare modules_prepare \
 && mkdir -p "/lib/modules/${KERNEL_VERSION}" \
 && ln -s "/usr/src/linux-${KERNEL_VERSION}" "/lib/modules/${KERNEL_VERSION}/build"

COPY --from=clawtune services/sidecar /opt/clawtune-guest/services/sidecar
RUN sed -i 's/\r$//' \
      /opt/clawtune-guest/services/sidecar/src/tool_resource/_mvdan_adapter/build.sh \
 && XDG_CACHE_HOME=/opt/clawtune/cache /bin/sh \
      /opt/clawtune-guest/services/sidecar/src/tool_resource/_mvdan_adapter/build.sh \
 && chmod -R a+rX /opt/clawtune/cache \
 && /usr/bin/python3 -m venv --system-site-packages /opt/clawtune/venv \
 && /opt/clawtune/venv/bin/python -c \
      "import sys; sys.path.insert(0, '/opt/clawtune-guest/services/sidecar/src'); from tool_resource.telemetry import _ensure_bcc_importable; print(_ensure_bcc_importable().__file__)"

COPY --from=clawtune tools/guest_collector_server.py /opt/clawtune-guest/tools/guest_collector_server.py
COPY --chmod=0555 .artifacts/tool-bridge-overlay /usr/local/bin/tool-bridge
COPY scripts/validate-toolbridge-guest-artifacts.py /opt/clawbox/validate-toolbridge-guest-artifacts.py
LABEL org.opencontainers.image.source.clawtune.revision="${CLAWTUNE_REVISION}"

ENV PYTHONPATH=/opt/clawtune-guest/services/sidecar/src \
    XDG_CACHE_HOME=/opt/clawtune/cache \
    BCC_KERNEL_SOURCE=/lib/modules/${KERNEL_VERSION}/build \
    CLAWTUNE_GUEST_COLLECTOR_HELPER=/opt/clawtune-guest/tools/guest_collector_server.py \
    CLAWTUNE_GUEST_COLLECTOR_PYTHON=/opt/clawtune/venv/bin/python
USER 10001:10001
WORKDIR /testbed
