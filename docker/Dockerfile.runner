# syntax=docker/dockerfile:1
# docker/Dockerfile.runner
# ARM64 runner image for the Kata/Firecracker multi-tenant OpenClaw prototype.
# Contains: Node.js + OpenClaw CLI, the current project's OpenClaw plugin,
# the Python scheduler sidecar (+ deps), the project code, a read-only base
# KB, and scripts/run-once.sh as the container entrypoint.
#
# The image does NOT contain any LLM model. The LLM is reached over HTTP via
# the sidecar's proxy (AGENT_SCHEDULER_LLM_UPSTREAM_*).
#
# Pass the ClawTune checkout as the named build context "clawtune", for example:
#   docker build --build-context clawtune=../ClawTune \
#     -f docker/Dockerfile.runner -t claw-runner .

ARG OPENCLAW_VERSION=2026.7.1

# ── stage 1: build the OpenClaw plugin (dist/) ────────────────────────
FROM node:22-bookworm-slim AS plugin-build
WORKDIR /src/plugin
COPY --from=clawtune packages/openclaw-plugin/package.json ./
COPY --from=clawtune packages/openclaw-plugin/package-lock.json ./
RUN npm ci
COPY --from=clawtune packages/openclaw-plugin/tsconfig.json ./
COPY --from=clawtune packages/openclaw-plugin/src ./src
RUN npm run build

# ── stage 2: runtime ──────────────────────────────────────────────────
FROM node:22-bookworm-slim

ARG OPENCLAW_VERSION
ENV OPENCLAW_VERSION=${OPENCLAW_VERSION} \
    DEBIAN_FRONTEND=noninteractive \
    HOME=/root

# Python for the sidecar + tooling. build-essential covers any native wheel
# gap on arm64 and openclaw's optional native postinstall steps.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip python3-dev \
      build-essential git curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# OpenClaw CLI (Node). Pinned to the version ClawTune targets.
RUN npm install -g "openclaw@${OPENCLAW_VERSION}" \
 && openclaw --version

# Current project code (ClawTune): scheduler sidecar + plugin + entrypoint.
WORKDIR /opt/clawtune
COPY --from=clawtune services/scheduler ./services/scheduler
COPY --from=plugin-build /src/plugin/dist ./packages/openclaw-plugin/dist
COPY --from=clawtune packages/openclaw-plugin/openclaw.plugin.json ./packages/openclaw-plugin/
COPY --from=clawtune packages/openclaw-plugin/package.json ./packages/openclaw-plugin/
COPY --from=clawtune packages/openclaw-plugin/README.md ./packages/openclaw-plugin/

# Sidecar virtualenv (no BCC/eBPF: the base install does not need it).
RUN python3 -m venv /opt/clawtune/venv \
 && /opt/clawtune/venv/bin/pip install --no-cache-dir ./services/scheduler \
 && /opt/clawtune/venv/bin/clawtune-sidecar --help >/dev/null 2>&1 || true

# Read-only base KB: a minimal sqlite file that run-once.sh copies per tenant
# into /state/<tenant>/kb.sqlite. Created with the same Python as the sidecar
# so no extra sqlite3 CLI dependency is required.
RUN /opt/clawtune/venv/bin/python - <<'PY'
import sqlite3
conn = sqlite3.connect("/opt/clawtune/base-kb.sqlite")
conn.execute("create table if not exists meta(key text primary key, value text)")
conn.execute("insert or ignore into meta values ('base_kb', '1')")
conn.commit()
conn.close()
PY

# One-shot runner entrypoint.
COPY scripts/run-once.sh /app/run-once.sh
RUN chmod +x /app/run-once.sh

# Writable agent workspace.
RUN mkdir -p /workspace && chmod 0777 /workspace
WORKDIR /workspace

ENTRYPOINT ["/app/run-once.sh"]
