# syntax=docker/dockerfile:1
# Tool CubeSandbox: repository/workspace plus ClawTune eBPF/cgroup/PMU collectors.
FROM cube-sandbox-cn.tencentcloudcr.com/cube-sandbox/sandbox-code@sha256:e1cb43e12ba70b8453b45f0c063306faab8a6974aa3fd76982dc4d019d07c60d AS cube-base

FROM golang:1.25-bookworm AS toolbridge-build
ARG GOPROXY=https://goproxy.cn,direct
WORKDIR /src
COPY toolbridge/go.mod toolbridge/go.sum ./
RUN GOPROXY="${GOPROXY}" go mod download
COPY toolbridge/*.go ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -mod=readonly -trimpath \
      -ldflags='-s -w -buildid=' -o /out/tool-bridge .

FROM 127.0.0.1:5000/clawbox/swe-rebench-arm64@sha256:f74f1cb744c70836966e9162deea8ae237b72547b34b4275855eb50d18cb7423
ARG CUBE_GUEST_KERNEL_DIGEST=unspecified
LABEL io.clawbox.cube-guest-kernel-digest="${CUBE_GUEST_KERNEL_DIGEST}"
USER root
COPY --from=cube-base /usr/bin/envd /usr/bin/envd
COPY --from=toolbridge-build /out/tool-bridge /usr/local/bin/tool-bridge
COPY docker/cube-runtime-entrypoint.sh /usr/local/bin/cube-tool-entrypoint.sh
# Install the complete collector package from the same main export as Runtime.
ARG CLAWTUNE_REVISION=unknown
LABEL org.opencontainers.image.source.clawtune.revision="${CLAWTUNE_REVISION}"
COPY --from=clawtune services/sidecar /opt/clawtune-guest/services/sidecar
COPY --from=clawtune contracts /opt/clawtune-guest/contracts
COPY --from=clawtune seeds /opt/clawtune-guest/seeds
RUN /opt/clawtune/venv/bin/pip install --upgrade --force-reinstall /opt/clawtune-guest/services/sidecar
COPY --from=clawtune tools/guest_collector_server.py /opt/clawtune-guest/tools/guest_collector_server.py
RUN chmod 0755 /usr/bin/envd /usr/local/bin/cube-tool-entrypoint.sh \
 && test -f /opt/clawtune-guest/tools/guest_collector_server.py \
 && mkdir -p /workspace /var/lib/clawtune/artifacts/tool-resource
ENV CLAWBOX_VM_ROLE=tool
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/cube-tool-entrypoint.sh"]
