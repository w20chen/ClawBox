FROM python:3.12-slim
WORKDIR /opt/clawbox
COPY pyproject.toml ./
COPY clawbox ./clawbox
RUN pip install --no-cache-dir . \
 && mkdir -p /workspace \
 && useradd --uid 10001 --create-home tool \
 && chown -R 10001:10001 /workspace
USER 10001:10001
ENV WORKSPACE_PATH=/workspace
EXPOSE 8090
CMD ["clawbox-tool-agent"]
