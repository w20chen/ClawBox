# syntax=docker/dockerfile:1
ARG OPENCLAW_VERSION=2026.7.1-2

FROM node:22-bookworm-slim AS plugin-build
ARG NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /src/plugin
COPY --from=clawtune packages/clawtune-plugin/package.json ./
COPY --from=clawtune packages/clawtune-plugin/package-lock.json ./
RUN npm ci --registry="${NPM_REGISTRY}"
COPY --from=clawtune packages/clawtune-plugin/tsconfig.json ./
COPY --from=clawtune packages/clawtune-plugin/src ./src
RUN npm run build

FROM node:22-bookworm-slim
ARG OPENCLAW_VERSION
ARG CLAWTUNE_REVISION=unknown
ARG CLAWBOX_REVISION=unknown
ARG NPM_REGISTRY=https://registry.npmjs.org
ARG PIP_INDEX_URL=https://pypi.org/simple
# Host (scheme optional) of a Debian mirror that serves both /debian and
# /debian-security, e.g. https://mirrors.tuna.tsinghua.edu.cn. The resulting
# apt URIs are forced to http:// because the slim base image ships no system
# CA certificates, so https verification fails before ca-certificates can be
# installed. Package integrity is still guaranteed by apt's InRelease
# signature check. Empty keeps the official sources.
ARG APT_MIRROR=
LABEL org.opencontainers.image.source.clawtune.revision="${CLAWTUNE_REVISION}"
LABEL org.opencontainers.image.source.clawbox.revision="${CLAWBOX_REVISION}"
ENV DEBIAN_FRONTEND=noninteractive \
    CLAWTUNE_REVISION=${CLAWTUNE_REVISION} \
    CLAWBOX_REVISION=${CLAWBOX_REVISION} \
    XDG_CACHE_HOME=/opt/clawtune/cache \
    HOME=/home/openclaw \
    OPENCLAW_HOME=/home/openclaw/.openclaw

RUN if [ -n "${APT_MIRROR}" ]; then \
      mirror_host="${APT_MIRROR#https://}"; \
      mirror_host="${mirror_host#http://}"; \
      sed -i -E "s|https?://deb\.debian\.org|http://${mirror_host}|g" \
        /etc/apt/sources.list.d/debian.sources \
        /etc/apt/sources.list 2>/dev/null || true; \
    fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git openssh-client \
      python3 python3-dev python3-pip python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g "openclaw@${OPENCLAW_VERSION}" --registry="${NPM_REGISTRY}" \
 && openclaw --version

# Patch openclaw so the SSH sandbox container root is workspaceRoot itself
# (/testbed) instead of <workspaceRoot>/openclaw-ssh-<scope>-<hash>/workspace.
# Without this, read/write/edit tools reject every absolute /testbed path with
# "Sandbox path escapes allowed mounts". The entrypoint pre-creates the
# per-scope marker dir so ensureRuntime skips its destructive workspace copy.
RUN <<'EOT'
set -e
node -e '
    const fs = require("fs"), path = require("path");
    const { execSync } = require("child_process");
    const globalRoot = execSync("npm root -g", { encoding: "utf8" }).trim();
    const dir = path.join(globalRoot, "openclaw", "dist");
    if (!fs.existsSync(dir)) {
      console.error("OPENCLAW_SANDBOX_ROOT_PATCH: no dist at " + dir);
      process.exit(1);
    }
    const patched = [];
    for (const f of fs.readdirSync(dir)) {
      if (!f.endsWith(".js")) continue;
      const p = path.join(dir, f);
      const s = fs.readFileSync(p, "utf8");
      const next = s.replace(
        /remoteWorkspaceDir:\s*path\.posix\.join\(runtimeRootDir,\s*"workspace"\)/g,
        "remoteWorkspaceDir: workspaceRoot");
      if (next !== s) { fs.writeFileSync(p, next); patched.push(f); }
    }
    if (!patched.length) {
      console.error("OPENCLAW_SANDBOX_ROOT_PATCH: no bundle contained the target");
      process.exit(1);
    }
    console.log("OPENCLAW_SANDBOX_ROOT_PATCH applied to: " + patched.join(", "));
  '
node -e '
    const fs = require("fs"), path = require("path");
    const { execSync } = require("child_process");
    const globalRoot = execSync("npm root -g", { encoding: "utf8" }).trim();
    const dir = path.join(globalRoot, "openclaw", "dist");
    let found = 0;
    for (const f of fs.readdirSync(dir)) {
      if (!f.endsWith(".js")) continue;
      if (fs.readFileSync(path.join(dir, f), "utf8").includes("remoteWorkspaceDir: workspaceRoot")) found++;
    }
    if (!found) {
      console.error("OPENCLAW_SANDBOX_ROOT_PATCH verify: replacement missing");
      process.exit(1);
    }
    console.log("OPENCLAW_SANDBOX_ROOT_PATCH verify: OK (" + found + " file(s))");
  '
EOT

WORKDIR /opt/clawtune
COPY --from=clawtune services/sidecar ./services/sidecar
COPY --from=plugin-build /src/plugin/dist ./packages/clawtune-plugin/dist
COPY --from=clawtune packages/clawtune-plugin/openclaw.plugin.json ./packages/clawtune-plugin/
COPY --from=clawtune packages/clawtune-plugin/package.json ./packages/clawtune-plugin/
COPY --from=clawtune packages/clawtune-plugin/README.md ./packages/clawtune-plugin/
COPY --from=clawtune traces/tool-resource ./cold-start/tool-resource
RUN python3 -m venv /opt/clawtune/venv \
 && /opt/clawtune/venv/bin/pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" ./services/sidecar \
 && sed -i 's/\r$//' services/sidecar/src/tool_resource/_mvdan_adapter/build.sh \
 && /bin/sh services/sidecar/src/tool_resource/_mvdan_adapter/build.sh \
 && rm -rf /opt/clawtune/cache/go-toolchain-* /opt/clawtune/cache/go-mod-cache \
 && chmod -R a+rX /opt/clawtune/cache \
 && /opt/clawtune/venv/bin/python -c "import clawtune_sidecar, tool_resource"

COPY scripts/runtime-entrypoint.sh /usr/local/bin/runtime-entrypoint
COPY scripts/clawtune-sidecar-entrypoint.sh /usr/local/bin/clawtune-sidecar-entrypoint
COPY scripts/artifact-uploader.py /usr/local/bin/artifact-uploader
COPY scripts/kb-flush.py /usr/local/bin/kb-flush.py
COPY scripts/native-shadow-report.py /usr/local/bin/native-shadow-report.py
COPY scripts/native-kb-pull.py /usr/local/bin/native-kb-pull.py
COPY scripts/native-shadow-probe.py /usr/local/bin/native-shadow-probe.py
RUN groupadd --gid 10001 openclaw \
 && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash openclaw \
 && chmod 0755 /usr/local/bin/runtime-entrypoint /usr/local/bin/clawtune-sidecar-entrypoint /usr/local/bin/artifact-uploader /usr/local/bin/kb-flush.py /usr/local/bin/native-shadow-report.py /usr/local/bin/native-kb-pull.py /usr/local/bin/native-shadow-probe.py \
 && mkdir -p /state /workspace /home/openclaw/.openclaw \
 && chown -R 10001:10001 /state /workspace /home/openclaw

USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/runtime-entrypoint"]
