# syntax=docker/dockerfile:1
ARG OPENCLAW_VERSION=2026.7.1-2

FROM node:22-bookworm-slim AS plugin-build
WORKDIR /src/plugin
COPY --from=clawtune packages/openclaw-plugin/package.json ./
COPY --from=clawtune packages/openclaw-plugin/package-lock.json ./
RUN npm ci
COPY --from=clawtune packages/openclaw-plugin/tsconfig.json ./
COPY --from=clawtune packages/openclaw-plugin/src ./src
RUN npm run build

FROM node:22-bookworm-slim
ARG OPENCLAW_VERSION
ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/openclaw \
    OPENCLAW_HOME=/home/openclaw/.openclaw

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git openssh-client \
      python3 python3-dev python3-pip python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g "openclaw@${OPENCLAW_VERSION}" \
 && openclaw --version

WORKDIR /opt/clawtune
COPY --from=clawtune services/scheduler ./services/scheduler
COPY --from=plugin-build /src/plugin/dist ./packages/openclaw-plugin/dist
COPY --from=clawtune packages/openclaw-plugin/openclaw.plugin.json ./packages/openclaw-plugin/
COPY --from=clawtune packages/openclaw-plugin/package.json ./packages/openclaw-plugin/
COPY --from=clawtune packages/openclaw-plugin/README.md ./packages/openclaw-plugin/
RUN python3 -m venv /opt/clawtune/venv \
 && /opt/clawtune/venv/bin/pip install --no-cache-dir ./services/scheduler

COPY scripts/two-sandbox/runtime-entrypoint.sh /usr/local/bin/runtime-entrypoint
RUN groupadd --gid 10001 openclaw \
 && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash openclaw \
 && chmod 0755 /usr/local/bin/runtime-entrypoint \
 && mkdir -p /state /workspace /home/openclaw/.openclaw \
 && chown -R 10001:10001 /state /workspace /home/openclaw

USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/runtime-entrypoint"]
