ARG BASE_IMAGE
FROM golang:1.25-bookworm AS toolbridge-build
ARG GOPROXY=https://goproxy.cn,direct
WORKDIR /src
COPY toolbridge/go.mod toolbridge/go.sum ./
RUN GOPROXY="${GOPROXY}" go mod download
COPY toolbridge/*.go ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -mod=readonly -trimpath \
      -ldflags='-s -w -buildid=' -o /out/tool-bridge .

FROM ${BASE_IMAGE}

ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG KERNEL_VERSION
ARG KERNEL_SOURCE_SHA256
ARG KERNEL_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/kernel/v6.x
USER root
RUN mirror_host="${APT_MIRROR#https://}" \
 && mirror_host="${mirror_host#http://}" \
 && { sed -i -E "s|https?://deb\.debian\.org|http://${mirror_host}|g" \
      /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list 2>/dev/null || true; } \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      bpfcc-tools python3-bpfcc clang llvm libelf-dev \
      curl make gcc flex bison bc libssl-dev kmod openssh-client \
 && rm -rf /var/lib/apt/lists/*

# BCC compiles ClawTune's program against internal kernel headers. BTF alone
# is not sufficient for this existing backend, so prepare the exact vanilla
# source and the exact debug config shipped by the pinned Kata release.
COPY kata-debug.config /tmp/kata-debug.config
RUN test -n "${KERNEL_VERSION}" \
 && test -n "${KERNEL_SOURCE_SHA256}" \
 && curl -fL --retry 4 --connect-timeout 15 --max-time 1800 \
      "${KERNEL_MIRROR}/linux-${KERNEL_VERSION}.tar.xz" \
      -o /tmp/linux.tar.xz \
 && printf '%s  %s\n' "${KERNEL_SOURCE_SHA256}" /tmp/linux.tar.xz | sha256sum -c - \
 && tar -C /usr/src -xf /tmp/linux.tar.xz \
 && rm /tmp/linux.tar.xz \
 && cp /tmp/kata-debug.config "/usr/src/linux-${KERNEL_VERSION}/.config" \
 && rm /tmp/kata-debug.config \
 && make -C "/usr/src/linux-${KERNEL_VERSION}" olddefconfig prepare modules_prepare \
 && mkdir -p "/lib/modules/${KERNEL_VERSION}" \
 && ln -s "/usr/src/linux-${KERNEL_VERSION}" "/lib/modules/${KERNEL_VERSION}/build"

COPY sidecar /opt/clawtune-guest/services/sidecar
RUN /opt/clawtune/venv/bin/pip install --no-deps --force-reinstall \
      /opt/clawtune-guest/services/sidecar \
 && /opt/clawtune/venv/bin/python -c \
      "from tool_resource.telemetry import _ensure_bcc_importable; print(_ensure_bcc_importable().__file__)" \
 && /opt/clawtune/venv/bin/python -c \
      "from tool_resource.features import parse_command_clauses; result=parse_command_clauses('true'); assert not result['parse_failed'], result"
COPY check_guest_ebpf.py /opt/clawtune-guest/tools/check_guest_ebpf.py
COPY guest_collector_server.py /opt/clawtune-guest/tools/guest_collector_server.py
COPY validate-toolbridge-guest-artifacts.py /opt/clawbox/validate-toolbridge-guest-artifacts.py
COPY --from=toolbridge-build /out/tool-bridge /usr/local/bin/tool-bridge

ENV PYTHONPATH=/opt/clawtune-guest/services/sidecar/src
ENV BCC_KERNEL_SOURCE=/lib/modules/${KERNEL_VERSION}/build
ENV CLAWTUNE_GUEST_COLLECTOR_HELPER=/opt/clawtune-guest/tools/guest_collector_server.py
ENV CLAWTUNE_GUEST_COLLECTOR_PYTHON=/opt/clawtune/venv/bin/python
ENTRYPOINT []
CMD ["sleep", "infinity"]
