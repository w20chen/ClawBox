#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_DIR="$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)"

# Daily commands should keep working in a new shell after the documented
# editable install.  An explicit override still wins for remote/client use.
if [[ -n "${CLAWBOX_PYTHON:-}" ]]; then
  PYTHON="${CLAWBOX_PYTHON}"
elif [[ -x "${PROJECT_DIR}/.venv/bin/python" ]]; then
  PYTHON="${PROJECT_DIR}/.venv/bin/python"
else
  PYTHON=python3
fi
export CLAWBOX_PYTHON="${PYTHON}"

case "${1:-}" in
  up|doctor|configure|install|traces)
    exec bash "${SCRIPT_DIR}/clawbox-host.sh" "$@"
    ;;
  -h|--help|help|"")
    bash "${SCRIPT_DIR}/clawbox-host.sh" help
    printf '\nTask commands:\n'
    exec "${PYTHON}" -m clawbox.cli --help
    ;;
esac

# On the Kubernetes host, the common case should not require a second terminal,
# a hand-copied token, or a manually managed port-forward. Explicit API/token
# settings retain the old remote-client behaviour.
explicit_connection=0
for arg in "$@"; do
  case "${arg}" in
    --token|--token=*|--api-url|--api-url=*|-h|--help) explicit_connection=1 ;;
  esac
done
if [[ "${explicit_connection}" == 0 ]] \
  && [[ -z "${CLAWBOX_TOKEN:-}" && -z "${CLAWBOX_API_URL:-}" ]] \
  && command -v kubectl >/dev/null 2>&1 \
  && kubectl get nodes >/dev/null 2>&1; then
  exec bash "${SCRIPT_DIR}/clawbox-host.sh" local-api "$@"
fi

exec "${PYTHON}" -m clawbox.cli "$@"
