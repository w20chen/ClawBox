#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_DIR="$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)"

# Daily commands should keep working in a new shell after the documented
# editable install.  An explicit override still wins for remote/client use.
if [[ -n "${CLAWBOX_PYTHON:-}" ]]; then
  PYTHON="${CLAWBOX_PYTHON}"
elif [[ -x "${PROJECT_DIR}/.venv/bin/python" ]]; then
  PYTHON="${PROJECT_DIR}/.venv/bin/python"
else
  PYTHON=python3
fi
export CLAWBOX_PYTHON="${PYTHON}"

# The shell entry point follows exactly the standalone Python CLI. It must
# never auto-detect a cluster or start a historical deployment helper.
exec "${PYTHON}" -m clawbox.cli "$@"
