#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_DIR="$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)"

# Load the same machine settings in every terminal, before privilege escalation.
# Wrapper flags precede the ordinary CLI arguments.
MACHINE_ENV=${CLAWBOX_MACHINE_ENV:-${HOME}/.config/clawbox/machine.env}
AS_ROOT=0
MACHINE_ENV_EXPLICIT=0
while (( $# )); do
  case "$1" in
    --machine-env)
      (( $# >= 2 )) || { echo '--machine-env requires a path' >&2; exit 2; }
      MACHINE_ENV=$2; MACHINE_ENV_EXPLICIT=1; shift 2 ;;
    --sudo) AS_ROOT=1; shift ;;
    *) break ;;
  esac
done
if [[ -f "$MACHINE_ENV" ]]; then
  export CLAWBOX_MACHINE_ENV="$MACHINE_ENV"
  set -a
  source "$MACHINE_ENV"
  set +a
elif [[ -n "${CLAWBOX_MACHINE_ENV:-}" || "$MACHINE_ENV_EXPLICIT" == 1 ]]; then
  echo "Machine configuration not found: $MACHINE_ENV" >&2
  exit 2
fi

# Large experiments can have one sampler and several sockets per active VM.
# Apply an explicitly saved per-process descriptor limit before sudo so every
# invocation from this wrapper inherits the same reviewed host setting.
if [[ -n "${CLAWBOX_NOFILE_LIMIT:-}" ]]; then
  if [[ ! "$CLAWBOX_NOFILE_LIMIT" =~ ^[1-9][0-9]*$ ]]; then
    echo 'CLAWBOX_NOFILE_LIMIT must be a positive integer (open files per process).' >&2
    exit 2
  fi
  NOFILE_HARD=$(ulimit -Hn)
  if [[ "$NOFILE_HARD" != unlimited ]] && (( CLAWBOX_NOFILE_LIMIT > NOFILE_HARD )); then
    echo "CLAWBOX_NOFILE_LIMIT=$CLAWBOX_NOFILE_LIMIT exceeds the hard limit $NOFILE_HARD; raise the host hard limit or choose a smaller value." >&2
    exit 2
  fi
  if ! ulimit -Sn "$CLAWBOX_NOFILE_LIMIT"; then
    echo "Could not set the open-file soft limit to CLAWBOX_NOFILE_LIMIT=$CLAWBOX_NOFILE_LIMIT." >&2
    exit 1
  fi
fi

# Daily commands should keep working in a new shell after the documented
# editable install.  An explicit override still wins for remote/client use.
if [[ -n "${CLAWBOX_PYTHON:-}" ]]; then
  PYTHON="${CLAWBOX_PYTHON}"
elif [[ -x "${PROJECT_DIR}/.venv/bin/python" ]]; then
  PYTHON="${PROJECT_DIR}/.venv/bin/python"
else
  PYTHON=python3
fi
export CLAWBOX_PYTHON="${PYTHON}"
export PYTHONPATH="${PROJECT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
if ! "$PYTHON" -c 'import clawbox.cli' >/dev/null 2>&1; then
  echo 'Python environment is incomplete. Run bash scripts/bootstrap-python.sh (see docs/installation.md).' >&2
  exit 1
fi

# The shell entry point follows exactly the standalone Python CLI. It must
# never auto-detect a cluster or start a historical deployment helper.
if (( AS_ROOT && EUID != 0 )); then
  exec sudo -E env "HOME=$HOME" "PATH=$PATH" "PYTHONPATH=$PYTHONPATH" \
    "CLAWBOX_MACHINE_ENV=$MACHINE_ENV" "CLAWBOX_PYTHON=$PYTHON" "$PYTHON" -m clawbox.cli "$@"
fi
exec "${PYTHON}" -m clawbox.cli "$@"
