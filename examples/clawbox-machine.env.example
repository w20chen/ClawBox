# Copy outside the repository, edit locally, and source with `set -a`.
# Do not put provider or Cube database credentials in this file.

CUBE_API_URL='http://<cube-control-host>:3000'
CUBE_PROXY_NODE_IP='<cube-proxy-transport-address>'
CUBE_PROXY_PORT_HTTP='<cube-proxy-http-port>'
CLAWBOX_CONTROL_HOST='<address-reachable-from-runtime-vms>'
CLAWBOX_MODEL_GATEWAY_HOST='<address-reachable-from-runtime-vms>'
CLAWBOX_OUTPUT_ROOT=/data/clawbox-results
CLAWTUNE_ROOT=/absolute/path/to/ClawTune
CLAWTUNE_SIDECAR_SRC=/absolute/path/to/ClawTune/services/sidecar/src
CUBE_NODE='<CubeSandbox-compute-node-name>'
CLAWBOX_RUNTIME_TEMPLATE='<immutable-runtime-template-id>'
CLAWBOX_TOOL_TEMPLATE='<immutable-tool-template-id>'
CLAWBOX_RUNTIME_IMAGE='<registry>/clawbox/runtime@sha256:<digest-from-registry>'
CLAWBOX_TOOL_IMAGE='<registry>/clawbox/tool@sha256:<digest-from-registry>'
CLAWBOX_WARM_ROOT=/data/clawbox/warm
CLAWBOX_COLD_ROOT=/data/clawbox/cold
CUBE_SOURCE_DIR=/absolute/path/to/CubeSandbox
NO_PROXY='<cube-control-host>,<cube-proxy-host>,localhost,127.0.0.1'
no_proxy='<cube-control-host>,<cube-proxy-host>,localhost,127.0.0.1'

# Bounded template/pair provisioning only; this is not Agent admission.
CLAWBOX_SANDBOX_CREATE_CONCURRENCY=8
