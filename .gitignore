# Build context / ClawTune checkout
clawtune/
clawtune-*/

# Rendered / generated k8s artifacts
*.rendered.yaml

# Python test/runtime caches
__pycache__/
*.py[cod]
.pytest-tmp-root/
.pytest_cache/

# Local Python environment / editable-install metadata
.venv/
*.egg-info/

# Local test DB state (tests use a per-PID temp DB; never commit one)
test-clawbox.db

# Local temp / debug staging (scp'd helper scripts, remote experiments)
.tmp-remote/
.clawbox-workspaces/

# Local secrets — never commit
.env
.env.*
*.key
