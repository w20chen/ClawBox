+func TestColdBaseReuseAndIndependentLifetime(t *testing.T) {
+	root := t.TempDir()
+	base := reuseBase(t, root, "base.mem", 'A')
+	source := baseReuseFixture(t, root, base)
+	original, _ := os.Stat(base)
+	for _, name := range []string{"first", "second"} {
+		dest := filepath.Join(root, name)
+		moved, err := copyLogicalSnapshot(source, dest, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if moved != int64(4*os.Getpagesize()) {
+			t.Fatalf("base copied unnecessarily: moved=%d", moved)
+		}
+		target, err := os.Stat(filepath.Join(dest+".layers", "000000.mem"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !os.SameFile(original, target) {
+			t.Fatal("base must share storage")
+		}
+		verifyReuseState(t, dest, 'A')
+	}
+	cleanupDirectMemorySnapshot(source)
+	if err := os.Remove(base); err != nil {
+		t.Fatal(err)
+	}
+	cleanupDirectMemorySnapshot(filepath.Join(root, "first"))
+	verifyReuseState(t, filepath.Join(root, "second"), 'A')
+	cleanupDirectMemorySnapshot(filepath.Join(root, "second"))
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 0 {
+		t.Fatalf("last reference cleanup leaked files: %v", entries)
+	}
+}
