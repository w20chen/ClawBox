+func TestColdBaseReuseConcurrentAndDistinctBases(t *testing.T) {
+	root := t.TempDir()
+	sources := make([]string, 2)
+	for i := range sources {
+		base := reuseBase(t, root, fmt.Sprintf("base%d.mem", i), byte('A'+i))
+		sources[i] = baseReuseFixture(t, filepath.Join(root, fmt.Sprintf("source%d", i)), base)
+	}
+	var wg sync.WaitGroup
+	errors := make(chan error, 24)
+	for i := 0; i < 24; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			dest := filepath.Join(root, fmt.Sprintf("dest%d", i))
+			moved, err := copyLogicalSnapshot(sources[i%2], dest, true)
+			if err != nil {
+				errors <- err
+				return
+			}
+			if moved != int64(4*os.Getpagesize()) {
+				errors <- fmt.Errorf("copied base: %d", moved)
+			}
+		}(i)
+	}
+	wg.Wait()
+	close(errors)
+	for err := range errors {
+		t.Error(err)
+	}
+	for i := 0; i < 24; i++ {
+		verifyReuseState(t, filepath.Join(root, fmt.Sprintf("dest%d", i)), byte('A'+i%2))
+	}
+	a, _ := os.Stat(filepath.Join(root, "dest0.layers/000000.mem"))
+	b, _ := os.Stat(filepath.Join(root, "dest1.layers/000000.mem"))
+	c, _ := os.Stat(filepath.Join(root, "dest2.layers/000000.mem"))
+	if a == nil || b == nil || c == nil || os.SameFile(a, b) || !os.SameFile(a, c) {
+		t.Fatal("base identities conflated or not reused")
+	}
+}
