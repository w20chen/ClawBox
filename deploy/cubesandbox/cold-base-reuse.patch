+	if err := f.Truncate(int64(size)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := f.WriteAt([]byte("base-marker"), 0); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
