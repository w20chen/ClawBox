+func baseReuseFixture(t *testing.T, root, base string) string {
+	t.Helper()
+	source := filepath.Join(root, "source.mem")
+	if err := os.MkdirAll(source+".layers", 0755); err != nil {
+		t.Fatal(err)
+	}
+	data := bytes.Repeat([]byte("D"), os.Getpagesize()*4)
+	delta := filepath.Join(source+".layers", "000001.mem")
+	if err := os.WriteFile(delta, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Link(delta, source); err != nil {
+		t.Fatal(err)
+	}
+	manifest := map[string]interface{}{
+		"schema_version": 1, "logical_bytes": len(data), "full_base": false,
+		"layers": []map[string]interface{}{
+			{"name": "000000.mem", "external_path": base},
+			{"name": "000001.mem", "ranges": []memoryLayerRange{{Offset: uint64(os.Getpagesize()), Length: uint64(os.Getpagesize())}}},
+		},
+	}
+	encoded, err := json.Marshal(manifest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(source+".lineage.json", encoded, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return source
+}
