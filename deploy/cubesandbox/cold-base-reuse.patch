+func reuseBase(t *testing.T, root, name string, value byte) string {
+	t.Helper()
+	path := filepath.Join(root, name)
+	if err := os.WriteFile(path, bytes.Repeat([]byte{value}, 4*os.Getpagesize()), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func verifyReuseState(t *testing.T, destination string, baseValue byte) {
+	t.Helper()
+	base, err := os.ReadFile(filepath.Join(destination+".layers", "000000.mem"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	delta, err := os.ReadFile(filepath.Join(destination+".layers", "000001.mem"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Resolve the declared ranges as a restore does: base except for the dirty page.
+	page := os.Getpagesize()
+	copy(base[page:2*page], delta[page:2*page])
+	expected := bytes.Repeat([]byte{baseValue}, 4*page)
+	copy(expected[page:2*page], bytes.Repeat([]byte("D"), page))
+	if !bytes.Equal(base, expected) {
+		t.Fatal("restored layer contents differ")
+	}
+	head, err := os.Stat(destination)
+	if err != nil {
+		t.Fatal(err)
+	}
+	last, err := os.Stat(filepath.Join(destination+".layers", "000001.mem"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !os.SameFile(head, last) {
+		t.Fatal("head no longer points to the last layer")
+	}
+	raw, err := os.ReadFile(destination + ".lineage.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(raw, []byte("external_path")) {
+		t.Fatal("destination retains a source pathname dependency")
+	}
+}
