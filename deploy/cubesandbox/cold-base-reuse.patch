+	file.Close()
+	if err := os.Link(delta, source); err != nil {
+		t.Fatal(err)
+	}
+	metadata := map[string]interface{}{
+		"schema_version": 1, "logical_bytes": 8 * page,
+		"layers": []map[string]interface{}{
+			{"name": "000000.mem", "external_path": external},
+			{"name": "000001.mem"},
+		},
+	}
+	data, _ := json.Marshal(metadata)
+	if err := os.WriteFile(source+".lineage.json", data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	transferred, err := copyLogicalSnapshot(source, dest, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if transferred != page {
+		t.Fatalf("expected only the dirty delta to be copied: %d", transferred)
+	}
+	original, err := os.Stat(external)
+	if err != nil {
+		t.Fatal(err)
+	}
+	owned, err := os.Stat(filepath.Join(dest+".layers", "000000.mem"))
+	if err != nil || !os.SameFile(original, owned) {
+		t.Fatalf("base was not retained by an owned hardlink: %v", err)
+	}
+	copied, err := os.ReadFile(dest + ".lineage.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var manifest struct {
+		Layers []struct {
+			ExternalPath *string `json:"external_path"`
+		} `json:"layers"`
+	}
+	if err := json.Unmarshal(copied, &manifest); err != nil {
+		t.Fatal(err)
+	}
+	for _, layer := range manifest.Layers {
+		if layer.ExternalPath != nil {
+			t.Fatal("COLD lineage retained external WARM dependency")
+		}
+	}
+}
