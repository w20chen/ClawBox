+// Only EXDEV permits copying instead of linking: permission, collision and
+// filesystem errors must remain actionable failures, not hidden extra I/O.
+func linkSnapshotBase(source, destination string) (bool, error) {
+	before, err := os.Lstat(source)
+	if err != nil {
+		return false, err
+	}
+	if !before.Mode().IsRegular() {
+		return false, fmt.Errorf("template RAM base is not a regular file")
+	}
+	if err := os.Link(source, destination); err != nil {
+		if errors.Is(err, unix.EXDEV) {
+			return false, nil
+		}
+		return false, err
+	}
+	after, err := os.Lstat(destination)
+	if err != nil || !after.Mode().IsRegular() || !os.SameFile(before, after) {
+		_ = os.Remove(destination)
+		return false, fmt.Errorf("template RAM base changed while linking: %v", err)
+	}
+	return true, nil
+}
+
