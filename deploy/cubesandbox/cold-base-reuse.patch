+func TestColdBaseReusePrivateRestoreWritesDoNotChangePeer(t *testing.T) {
+	root := t.TempDir()
+	base := reuseBase(t, root, "base.mem", 'A')
+	source := baseReuseFixture(t, root, base)
+	for _, name := range []string{"first", "second"} {
+		if _, err := copyLogicalSnapshot(source, filepath.Join(root, name), true); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// The VMM restores immutable lineage files with writable MAP_PRIVATE maps.
+	file, err := os.Open(filepath.Join(root, "first.layers", "000000.mem"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	mapping, err := unix.Mmap(int(file.Fd()), 0, 4*os.Getpagesize(), unix.PROT_READ|unix.PROT_WRITE, unix.MAP_PRIVATE)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Munmap(mapping)
+	mapping[0] = 'Z'
+	if mapping[0] != 'Z' {
+		t.Fatal("private mapping was not writable")
+	}
+	verifyReuseState(t, filepath.Join(root, "second"), 'A')
+	data, err := os.ReadFile(base)
+	if err != nil || data[0] != 'A' {
+		t.Fatal("private restore write modified shared base")
+	}
+}
