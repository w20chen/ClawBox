+			root := t.TempDir()
+			base := reuseBase(t, root, "base.mem", 'A')
+			source := baseReuseFixture(t, root, base)
+			switch mode {
+			case "missing":
+				if err := os.Remove(base); err != nil {
+					t.Fatal(err)
+				}
+			case "truncated":
+				if err := os.Truncate(base, 1); err != nil {
+					t.Fatal(err)
+				}
+			case "symlink":
+				if err := os.Rename(base, base+".real"); err != nil {
+					t.Fatal(err)
