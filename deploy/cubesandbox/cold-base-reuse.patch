-	path := filepath.Join(source + ".layers", name)
+	path := filepath.Join(source+".layers", name)
 	info, err := os.Lstat(path)
-	if err != nil { return err }
+	if err != nil {
+		return err
+	}
 	if !info.Mode().IsRegular() || uint64(info.Size()) != logical {
 		return fmt.Errorf("missing or truncated RAM layer %s", name)
 	}
 	if checkHead {
 		head, err := os.Lstat(source)
-		if err != nil { return err }
-		if !os.SameFile(head, info) { return fmt.Errorf("RAM head is not the latest layer") }
+		if err != nil {
+			return err
+		}
+		if !os.SameFile(head, info) {
+			return fmt.Errorf("RAM head is not the latest layer")
+		}
 	}
 	return nil
 }
