+	dest := filepath.Join(root, "cold")
+	moved, err := copyLogicalSnapshot(source, dest, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if moved != int64(size) {
+		t.Fatal("sparse base incorrectly charged as transfer", moved)
+	}
+	raw, err := os.ReadFile(dest + ".lineage.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var m struct {
+		Reused int64 `json:"reused_base_allocated_bytes"`
+	}
+	if err := json.Unmarshal(raw, &m); err != nil {
+		t.Fatal(err)
+	}
+	before, _ := os.Stat(base)
+	after, _ := os.Stat(filepath.Join(dest+".layers", "000000.mem"))
+	if !os.SameFile(before, after) || m.Reused <= 0 || m.Reused >= int64(size) {
+		t.Fatalf("invalid sparse sharing accounting: %+v", m)
+	}
