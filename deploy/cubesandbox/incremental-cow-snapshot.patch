+// Preserve the complete immutable RAM dependency closure, not only the delta
+// named by MemoryVol. Layer names are relative, so relocation needs no parent
+// path rewrites and never leaves hidden references back into volatile WARM.
+func copyLogicalSnapshot(source, destination string, requireLineage bool) (int64, error) {
+	data, err := os.ReadFile(source + ".lineage.json")
+	if os.IsNotExist(err) {
+		if requireLineage { return 0, fmt.Errorf("missing committed RAM lineage") }
+		return copySnapshot(source, destination)
+	}
+	if err != nil { return 0, err }
+	var manifest map[string]json.RawMessage
+	if err := json.Unmarshal(data, &manifest); err != nil { return 0, err }
+	var layers []struct {
+		Name string `json:"name"`
+		Ranges []memoryLayerRange `json:"ranges"`
+	}
+	if err := json.Unmarshal(manifest["layers"], &layers); err != nil { return 0, err }
+	if len(layers) == 0 { return 0, fmt.Errorf("empty RAM lineage") }
+	var logical uint64
+	if err := json.Unmarshal(manifest["logical_bytes"], &logical); err != nil || logical == 0 {
+		return 0, fmt.Errorf("invalid RAM logical size")
+	}
+	if err := validateSnapshotLayer(source, layers[len(layers)-1].Name, logical, true); err != nil {
+		return 0, err
+	}
+	for i, layer := range layers {
+		if layer.Name != fmt.Sprintf("%06d.mem", i) {
+			return 0, fmt.Errorf("invalid RAM layer name")
+		}
+		if err := validateSnapshotLayer(source, layer.Name, logical, false); err != nil {
+			return 0, err
+		}
+		var previousEnd uint64
+		for _, r := range layer.Ranges {
+			if r.Length == 0 || r.Offset < previousEnd || r.Offset >= logical || r.Length > logical-r.Offset {
+				return 0, fmt.Errorf("invalid RAM layer range")
+			}
+			previousEnd = r.Offset + r.Length
+		}
+	}
+	if err := os.Mkdir(destination + ".layers", 0755); err != nil { return 0, err }
+	var transferred, allocated int64
+	for i, layer := range layers {
+		if layer.Name != fmt.Sprintf("%06d.mem", i) { return transferred, fmt.Errorf("invalid RAM layer name") }
+		target := filepath.Join(destination + ".layers", layer.Name)
+		count, err := copySnapshot(filepath.Join(source + ".layers", layer.Name), target)
+		transferred += count
+		if err != nil { return transferred, err }
+		var stat unix.Stat_t
+		if err := unix.Stat(target, &stat); err != nil { return transferred, err }
+		allocated += stat.Blocks * 512
+	}
+	if err := os.Link(filepath.Join(destination + ".layers", layers[len(layers)-1].Name), destination); err != nil {
+		return transferred, err
+	}
+	manifest["transferred_bytes"], _ = json.Marshal(transferred)
+	manifest["allocated_bytes"], _ = json.Marshal(allocated)
+	out, err := os.OpenFile(destination + ".lineage.json", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0644)
+	if err != nil { return transferred, err }
+	err = json.NewEncoder(out).Encode(manifest)
+	if err == nil { err = out.Sync() }
+	closeErr := out.Close()
+	if err == nil { err = closeErr }
+	if err == nil { err = syncSnapshotDirectory(destination + ".layers") }
+	return transferred, err
+}
+
+func validateSnapshotLayer(source, name string, logical uint64, checkHead bool) error {
+	path := filepath.Join(source + ".layers", name)
+	info, err := os.Lstat(path)
+	if err != nil { return err }
+	if !info.Mode().IsRegular() || uint64(info.Size()) != logical {
+		return fmt.Errorf("missing or truncated RAM layer %s", name)
+	}
+	if checkHead {
+		head, err := os.Lstat(source)
+		if err != nil { return err }
+		if !os.SameFile(head, info) { return fmt.Errorf("RAM head is not the latest layer") }
+	}
+	return nil
+}
