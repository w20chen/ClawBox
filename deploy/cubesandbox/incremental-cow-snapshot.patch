index 0000000..c687029
--- /dev/null
+++ b/hypervisor/vmm/src/snapshot_lineage.rs
@@ -0,0 +1,244 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Immutable RAM layers for filesystems without reflink (notably NUMA tmpfs).
+//! Dirty ranges are supplied by the existing KVM/VMM bitmap implementation.
+//! This module never compares RAM contents or uses process soft-dirty bits.
+
+use serde::{Deserialize, Serialize};
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Write};
+use std::os::unix::fs::MetadataExt;
+use std::os::unix::io::AsRawFd;
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+pub struct Range {
+    pub gpa: u64,
+    pub offset: u64,
+    pub length: u64,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Layer {
+    pub name: String,
+    pub ranges: Vec<Range>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Lineage {
+    pub schema_version: u32,
+    pub logical_bytes: u64,
+    pub allocated_bytes: u64,
+    pub dirty_bytes: Option<u64>,
+    pub transferred_bytes: u64,
+    pub full_base: bool,
+    pub layers: Vec<Layer>,
+}
+
+pub fn sidecar(path: &Path) -> PathBuf {
+    let mut name = path.as_os_str().to_os_string();
+    name.push(".lineage.json");
+    name.into()
+}
+
+pub fn layer_dir(path: &Path) -> PathBuf {
+    let mut name = path.as_os_str().to_os_string();
+    name.push(".layers");
+    name.into()
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+
+pub fn volatile(file: &File) -> io::Result<bool> {
+    let mut stat: libc::statfs = unsafe { std::mem::zeroed() };
+    if unsafe { libc::fstatfs(file.as_raw_fd(), &mut stat) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(stat.f_type == libc::TMPFS_MAGIC)
+}
+
+pub fn allocate_warm(path: &Path, ranges: &[Range]) -> io::Result<()> {
+    use std::net::Shutdown;
+    use std::os::unix::net::UnixStream;
+    use std::time::Duration;
+    let mut socket = path.as_os_str().to_os_string();
+    socket.push(".allocate.sock");
+    let mut stream = UnixStream::connect(PathBuf::from(socket))?;
+    stream.set_read_timeout(Some(Duration::from_secs(120)))?;
+    stream.set_write_timeout(Some(Duration::from_secs(120)))?;
+    serde_json::to_writer(&mut stream, ranges)?;
+    stream.shutdown(Shutdown::Write)?;
+    let response: serde_json::Value = serde_json::from_reader(stream)?;
+    if response.get("ok").and_then(|v| v.as_bool()) != Some(true) {
+        return Err(io::Error::new(io::ErrorKind::Other, format!("WARM allocation failed: {response}")));
+    }
+    Ok(())
+}
+
+impl Lineage {
+    pub fn load(path: &Path, layout: &[Range], page_size: u64) -> io::Result<Option<Self>> {
+        let file = match File::open(sidecar(path)) {
+            Ok(file) => file,
+            Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(None),
+            Err(e) => return Err(e),
+        };
+        let lineage: Self = serde_json::from_reader(file)?;
+        if lineage.schema_version != 1 || lineage.layers.is_empty()
+            || lineage.layers[0].ranges != layout
+            || lineage.logical_bytes != layout.iter().map(|r| r.length).sum::<u64>()
+            || page_size == 0
+        {
+            return Err(invalid("incomplete RAM lineage or incompatible guest layout"));
+        }
+        for (index, layer) in lineage.layers.iter().enumerate() {
+            if layer.name != format!("{:06}.mem", index) {
+                return Err(invalid("invalid RAM layer name"));
+            }
+            let metadata = fs::symlink_metadata(layer_dir(path).join(&layer.name))?;
+            if !metadata.is_file() || metadata.len() != lineage.logical_bytes {
+                return Err(invalid("missing or truncated RAM layer"));
+            }
+            let mut previous_end = 0;
+            for range in &layer.ranges {
+                let end = range.offset.checked_add(range.length)
+                    .ok_or_else(|| invalid("RAM range overflow"))?;
+                if range.length == 0 || range.offset < previous_end
+                    || range.offset % page_size != 0 || range.length % page_size != 0
+                    || !layout.iter().any(|region| {
+                        range.offset >= region.offset
+                            && end <= region.offset + region.length
+                            && range.gpa == region.gpa + range.offset - region.offset
+                    })
+                {
+                    return Err(invalid("RAM layer range outside guest mapping"));
+                }
+                previous_end = end;
+            }
+        }
+        Ok(Some(lineage))
+    }
+
+    /// Give the new snapshot its own names for every immutable dependency.
+    /// Unlinking the predecessor then cannot break this snapshot or a live mmap.
+    /// Cross-filesystem inheritance is deliberately rejected: the lifecycle
+    /// must relocate the complete snapshot first, or explicitly create a base.
+    pub fn inherit(path: &Path, parent: Option<(&Path, &Self)>, logical_bytes: u64)
+        -> io::Result<Self>
+    {
+        fs::create_dir(layer_dir(path))?;
+        let mut layers = Vec::new();
+        if let Some((parent_path, parent)) = parent {
+            for layer in &parent.layers {
+                fs::hard_link(layer_dir(parent_path).join(&layer.name),
+                              layer_dir(path).join(&layer.name))?;
+                layers.push(layer.clone());
+            }
+        }
+        Ok(Self {
+            schema_version: 1, logical_bytes, allocated_bytes: 0,
+            dirty_bytes: None, transferred_bytes: 0, full_base: parent.is_none(), layers,
+        })
+    }
+
+    /// Publish only after RAM writes finish. Cubelet still owns the overall
+    /// commit transaction including frozen vCPU/device state and rootfs.
+    pub fn publish(mut self, path: &Path, ranges: Vec<Range>, durable: bool)
+        -> io::Result<()>
+    {
+        self.transferred_bytes = ranges.iter().map(|r| r.length).sum();
+        self.dirty_bytes = if self.full_base { None } else { Some(self.transferred_bytes) };
+        let name = format!("{:06}.mem", self.layers.len());
+        fs::hard_link(path, layer_dir(path).join(&name))?;
+        self.layers.push(Layer { name, ranges });
+        for layer in &self.layers {
+            let file = File::open(layer_dir(path).join(&layer.name))?;
+            self.allocated_bytes += file.metadata()?.blocks() * 512;
+            if durable { file.sync_all()?; }
+        }
+        let target = sidecar(path);
+        let temporary = target.with_extension("json.pending");
+        let mut file = OpenOptions::new().write(true).create_new(true).open(&temporary)?;
+        file.write_all(&serde_json::to_vec(&self)?)?;
+        if durable {
+            file.sync_all()?;
+            File::open(layer_dir(path))?.sync_all()?;
+        }
+        fs::rename(temporary, target)?;
+        if durable { File::open(path.parent().ok_or_else(|| invalid("no parent"))?)?.sync_all()?; }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::FileExt;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    struct Directory(PathBuf);
+    impl Directory {
+        fn new() -> Self {
+            static NEXT: AtomicU64 = AtomicU64::new(0);
+            let path = std::env::temp_dir().join(format!("cube-lineage-test-{}-{}",
+                std::process::id(), NEXT.fetch_add(1, Ordering::SeqCst)));
+            fs::create_dir(&path).unwrap();
+            Self(path)
+        }
+    }
+    impl Drop for Directory {
+        fn drop(&mut self) { let _ = fs::remove_dir_all(&self.0); }
+    }
+
+    #[test]
+    fn zero_dirty_pages_override_base_and_survive_parent_deletion() {
+        let directory = Directory::new();
+        let base = directory.0.join("base.mem");
+        let delta = directory.0.join("delta.mem");
+        let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as u64;
+        let layout = vec![Range { gpa: 0x40000000, offset: 0, length: 3 * page }];
+        fs::write(&base, vec![0x5a; (3 * page) as usize]).unwrap();
+        Lineage::inherit(&base, None, 3 * page).unwrap()
+            .publish(&base, layout.clone(), false).unwrap();
+        let parent = Lineage::load(&base, &layout, page).unwrap().unwrap();
+        let file = File::create(&delta).unwrap();
+        file.set_len(3 * page).unwrap();
+        file.write_all_at(&vec![0; page as usize], page).unwrap();
+        let range = Range { gpa: 0x40000000 + page, offset: page, length: page };
+        Lineage::inherit(&delta, Some((&base, &parent)), 3 * page).unwrap()
+            .publish(&delta, vec![range], false).unwrap();
+        fs::remove_file(&base).unwrap();
+        fs::remove_file(sidecar(&base)).unwrap();
+        fs::remove_dir_all(layer_dir(&base)).unwrap();
+        let child = Lineage::load(&delta, &layout, page).unwrap().unwrap();
+        assert_eq!(child.dirty_bytes, Some(page));
+        assert_eq!(child.transferred_bytes, page);
+        assert!(!child.full_base);
+        assert_eq!(child.logical_bytes, 3 * page);
+        let mut restored = fs::read(layer_dir(&delta).join(&child.layers[0].name)).unwrap();
+        for layer in child.layers.iter().skip(1) {
+            let file = File::open(layer_dir(&delta).join(&layer.name)).unwrap();
+            for r in &layer.ranges {
+                file.read_exact_at(&mut restored[r.offset as usize..(r.offset + r.length) as usize], r.offset).unwrap();
+            }
+        }
+        assert!(restored[..page as usize].iter().all(|v| *v == 0x5a));
+        assert!(restored[page as usize..2 * page as usize].iter().all(|v| *v == 0));
+        assert!(restored[2 * page as usize..].iter().all(|v| *v == 0x5a));
+        // Missing dependencies fail before a VM can resume with zero-filled holes.
+        fs::remove_file(layer_dir(&delta).join(&child.layers[0].name)).unwrap();
+        assert!(Lineage::load(&delta, &layout, page).is_err());
+    }
+
+    #[test]
+    fn changed_guest_layout_cannot_reuse_a_baseline() {
+        let directory = Directory::new();
+        let path = directory.0.join("base.mem");
+        let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as u64;
+        let layout = vec![Range { gpa: 0x40000000, offset: 0, length: page }];
+        fs::write(&path, vec![0; page as usize]).unwrap();
+        Lineage::inherit(&path, None, page).unwrap().publish(&path, layout.clone(), false).unwrap();
+        let changed = vec![Range { gpa: 0x80000000, offset: 0, length: page }];
+        assert!(Lineage::load(&path, &changed, page).is_err());
+    }
+}
