diff --git a/Cubelet/services/cubebox/incremental_memory.go b/Cubelet/services/cubebox/incremental_memory.go
new file mode 100644
index 0000000..baa77e1
--- /dev/null
+++ b/Cubelet/services/cubebox/incremental_memory.go
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: Apache-2.0
+package cubebox
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+type memoryLayerRange struct {
+	GPA uint64 `json:"gpa"`
+	Offset uint64 `json:"offset"`
+	Length uint64 `json:"length"`
+}
+
+// Allocation executes in Cubelet's storage cgroup. The frozen VMM supplies
+// KVM/VMM dirty ranges and waits for the ACK before writing the sparse delta.
+// Allocating in the VMM would charge NUMA1 pool pages to bounded LOCAL memory.
+func serveWarmAllocation(path string, size uint64) (func(), error) {
+	socketPath := path + ".allocate.sock"
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: socketPath, Net: "unix"})
+	if err != nil { return nil, err }
+	if err := os.Chmod(socketPath, 0600); err != nil {
+		listener.Close()
+		return nil, err
+	}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		conn, err := listener.AcceptUnix()
+		if err != nil { return }
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(120 * time.Second))
+		var ranges []memoryLayerRange
+		err = json.NewDecoder(io.LimitReader(conn, 64*1024*1024)).Decode(&ranges)
+		var file *os.File
+		if err == nil { file, err = os.OpenFile(path, os.O_RDWR, 0) }
+		if file != nil { defer file.Close() }
+		var previousEnd uint64
+		pageSize := uint64(os.Getpagesize())
+		for _, r := range ranges {
+			if err != nil { break }
+			if r.Length == 0 || r.Offset < previousEnd || r.Offset > size ||
+				r.Length > size-r.Offset || r.Offset%pageSize != 0 || r.Length%pageSize != 0 {
+				err = fmt.Errorf("invalid dirty allocation range")
+				break
+			}
+			err = unix.Fallocate(int(file.Fd()), 0, int64(r.Offset), int64(r.Length))
+			previousEnd = r.Offset + r.Length
+		}
+		response := map[string]interface{}{"ok": err == nil}
+		if err != nil { response["error"] = err.Error() }
+		_ = json.NewEncoder(conn).Encode(response)
+	}()
+	return func() { listener.Close(); <-done }, nil
+}
+
+// Each committed generation owns hardlink names for its entire dependency
+// closure. Removing these names cannot remove another generation's layers.
+func cleanupDirectMemorySnapshot(path string) {
+	_ = os.Remove(path)
+	_ = os.Remove(path + ".metrics.json")
+	_ = os.Remove(path + ".lineage.json")
+	_ = os.Remove(path + ".lineage.json.pending")
+	_ = os.RemoveAll(path + ".layers")
+}
diff --git a/Cubelet/services/cubebox/incremental_memory_test.go b/Cubelet/services/cubebox/incremental_memory_test.go
new file mode 100644
index 0000000..e839464
--- /dev/null
+++ b/Cubelet/services/cubebox/incremental_memory_test.go
@@ -0,0 +1,101 @@
+package cubebox
+
+import (
+    "encoding/json"
+    "net"
+    "os"
+    "path/filepath"
+    "testing"
+
+    cubebox "github.com/tencentcloud/CubeSandbox/Cubelet/api/services/cubebox/v1"
+    "golang.org/x/sys/unix"
+)
+
+func TestDirectPauseMemoryPathAcceptsConfiguredWarmRoot(t *testing.T) {
+    t.Setenv("CLAWBOX_WARM_SNAPSHOT_ROOT", "/mnt/clawbox-warm")
+    t.Setenv("CLAWBOX_COLD_SNAPSHOT_ROOT", "/data/clawbox-incremental-cold-20260913")
+    req := &cubebox.UpdateCubeSandboxRequest{Annotations: map[string]string{
+        "clawbox.snapshot.tier": "warm",
+        "clawbox.snapshot.memory.path": "/mnt/clawbox-warm/test/g1.mem",
+    }}
+    path, direct, err := directPauseMemoryPath(req)
+    if err != nil || !direct || path != "/mnt/clawbox-warm/test/g1.mem" {
+        t.Fatalf("configured warm path rejected: %q %v %v", path, direct, err)
+    }
+}
+
+func TestWarmAllocationOnlyChargesDirtyRanges(t *testing.T) {
+    path := filepath.Join(t.TempDir(), "ram.mem")
+    page := int64(os.Getpagesize())
+    file, err := os.Create(path)
+    if err != nil { t.Fatal(err) }
+    if err := file.Truncate(16 * page); err != nil { t.Fatal(err) }
+    file.Close()
+    stop, err := serveWarmAllocation(path, uint64(16 * page))
+    if err != nil { t.Fatal(err) }
+    defer stop()
+    conn, err := net.Dial("unix", path + ".allocate.sock")
+    if err != nil { t.Fatal(err) }
+    ranges := []memoryLayerRange{{GPA: 0, Offset: uint64(page), Length: uint64(page)}}
+    if err := json.NewEncoder(conn).Encode(ranges); err != nil { t.Fatal(err) }
+    conn.(*net.UnixConn).CloseWrite()
+    var response struct { OK bool `json:"ok"` }
+    if err := json.NewDecoder(conn).Decode(&response); err != nil { t.Fatal(err) }
+    conn.Close()
+    if !response.OK { t.Fatal("valid dirty allocation rejected") }
+    var stat unix.Stat_t
+    if err := unix.Stat(path, &stat); err != nil { t.Fatal(err) }
+    if stat.Blocks * 512 < page || stat.Blocks * 512 >= 16 * page {
+        t.Fatalf("expected only dirty pages allocated: %d", stat.Blocks * 512)
+    }
+}
+
+func TestMissingRequiredLineageCannotSpillOnlyLatestDelta(t *testing.T) {
+    root := t.TempDir()
+    source := filepath.Join(root, "source.mem")
+    dest := filepath.Join(root, "destination.mem")
+    if err := os.WriteFile(source, []byte("delta"), 0600); err != nil { t.Fatal(err) }
+    transferred, err := copyLogicalSnapshot(source, dest, true)
+    if err == nil || transferred != 0 { t.Fatalf("missing lineage accepted: %d %v", transferred, err) }
+    if _, err := os.Stat(dest); !os.IsNotExist(err) { t.Fatalf("partial COLD file: %v", err) }
+}
+
+func TestSpillCopiesEntireSparseRamLineage(t *testing.T) {
+    root := t.TempDir()
+    source := filepath.Join(root, "source.mem")
+    dest := filepath.Join(root, "destination.mem")
+    layers := source + ".layers"
+    if err := os.Mkdir(layers, 0755); err != nil { t.Fatal(err) }
+    page := int64(os.Getpagesize())
+    base := filepath.Join(layers, "000000.mem")
+    delta := filepath.Join(layers, "000001.mem")
+    if err := os.WriteFile(base, make([]byte, 8 * page), 0600); err != nil { t.Fatal(err) }
+    f, err := os.Create(delta)
+    if err != nil { t.Fatal(err) }
+    if err := f.Truncate(8 * page); err != nil { t.Fatal(err) }
+    if _, err := f.WriteAt(make([]byte, page), 3 * page); err != nil { t.Fatal(err) }
+    f.Close()
+    if err := os.Link(delta, source); err != nil { t.Fatal(err) }
+    metadata := map[string]interface{}{
+        "schema_version": 1, "logical_bytes": 8 * page,
+        "layers": []map[string]interface{}{{"name": "000000.mem"}, {"name": "000001.mem"}},
+    }
+    data, _ := json.Marshal(metadata)
+    if err := os.WriteFile(source + ".lineage.json", data, 0600); err != nil { t.Fatal(err) }
+    transferred, err := copyLogicalSnapshot(source, dest, true)
+    if err != nil { t.Fatal(err) }
+    if transferred < 9 * page || transferred >= 16 * page {
+        t.Fatalf("expected base plus sparse delta: %d", transferred)
+    }
+    for _, name := range []string{"000000.mem", "000001.mem"} {
+        info, err := os.Stat(filepath.Join(dest + ".layers", name))
+        if err != nil || info.Size() != 8 * page { t.Fatalf("missing complete layer %s: %v", name, err) }
+    }
+    copied, err := os.ReadFile(dest + ".lineage.json")
+    if err != nil { t.Fatal(err) }
+    var manifest map[string]interface{}
+    if err := json.Unmarshal(copied, &manifest); err != nil { t.Fatal(err) }
+    if int64(manifest["transferred_bytes"].(float64)) != transferred {
+        t.Fatal("COLD manifest transfer count does not include closure")
+    }
+}
