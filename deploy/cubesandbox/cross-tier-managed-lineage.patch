+// ActivateRecoveryBinding materializes an explicit crash-rollback target as a
+// temporary READY binding. The independent crash-rollback row remains the
+// authority; this binding only lets the normal same-ID resume path rebuild the
+// VM from the last globally committed snapshot.
+func ActivateRecoveryBinding(ctx context.Context, rec *Record) error {
+	client := getDB()
+	if client == nil {
+		return ErrNotReady
+	}
+	if rec == nil || strings.TrimSpace(rec.SandboxID) == "" ||
+		strings.TrimSpace(rec.SnapshotID) == "" {
+		return errors.New("sandboxID and snapshotID are required")
+	}
+	pluginJSON, _ := json.Marshal(uniqueNonEmpty(rec.PluginVolumeIDs))
+	row := &models.PauseSnapshotRecord{
+		SnapshotID:          strings.TrimSpace(rec.SnapshotID),
+		SandboxID:           strings.TrimSpace(rec.SandboxID),
+		NodeID:              strings.TrimSpace(rec.NodeID),
+		NodeIP:              strings.TrimSpace(rec.NodeIP),
+		InstanceType:        strings.TrimSpace(rec.InstanceType),
+		Status:              statusReady,
+		LastError:           strings.TrimSpace(rec.LastError),
+		PluginVolumeIDs:     string(pluginJSON),
+		Backend:             strings.TrimSpace(rec.Backend),
+		RemoteStatus:        strings.TrimSpace(rec.RemoteStatus),
+		OriginHostFactsJSON: rec.OriginHostFactsJSON,
+		ExportUUIDs:         rec.ExportUUIDs,
+	}
+	return client.WithContext(ctx).Table(constants.PauseSnapshotTableName).Create(row).Error
+}
