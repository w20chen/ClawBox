+			Containers: []*cubebox.Container{{
+				Id: sandboxID, State: cubebox.ContainerState_CONTAINER_UNKNOWN,
+			}},
+		}}},
+		"pausing state": {Items: []*cubebox.CubeSandbox{{
+			Id: sandboxID,
+			Containers: []*cubebox.Container{{
+				Id: sandboxID, State: cubebox.ContainerState_CONTAINER_PAUSING,
+			}},
+		}}},
+		"missing container":  {Items: []*cubebox.CubeSandbox{{Id: sandboxID}}},
+		"wrong sandbox item": {Items: []*cubebox.CubeSandbox{{Id: "sb-other"}}},
+	} {
