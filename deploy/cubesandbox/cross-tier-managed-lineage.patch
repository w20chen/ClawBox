+func TestRestartAfterLocalSealCanAbortBeforeCommit(t *testing.T) {
+	db := setupTest(t)
+	ctx := context.Background()
+	first, err := Begin(ctx, "sb-1", "txn-g1", "snap-g1",
+		"node-1", "10.0.0.1", "cubebox", "xfs")
+	require.NoError(t, err)
+	require.NoError(t, Commit(ctx, "sb-1", "txn-g1", "snap-g1", first.Epoch,
+		"node-1", "10.0.0.1", "cubebox", "xfs", `{}`, "", ""))
+	second, err := Begin(ctx, "sb-1", "txn-g2", "snap-g2",
+		"node-1", "10.0.0.1", "cubebox", "xfs")
+	require.NoError(t, err)
+	require.NoError(t, MarkLocalSealed(ctx, "sb-1", "txn-g2", second.Epoch))
+
+	// A new connection models a Master process restart. The local seal is
+	// durable, but g2 is not globally committed and must be explicitly failed
+	// before rollback.
+	Init(db)
+	sealed, err := Get(ctx, "sb-1")
+	require.NoError(t, err)
+	require.Equal(t, StateLocalSealed, sealed.State)
+	require.Equal(t, "snap-g1", sealed.LastSnapshotID)
+	require.NoError(t, Fail(ctx, "sb-1", "txn-g2", sealed.Epoch, "master restart"))
+	failed, err := Get(ctx, "sb-1")
+	require.NoError(t, err)
+	rollback, err := BeginRollback(ctx, "sb-1", "rollback-g1", failed.Epoch)
+	require.NoError(t, err)
+	require.Equal(t, "snap-g1", rollback.LastSnapshotID)
+	require.Equal(t, "snap-g2", rollback.InflightSnapshotID)
+	require.NoError(t, CompleteRollback(
+		ctx, "sb-1", "rollback-g1", rollback.Epoch, "runtime-after-restart",
+	))
+}
