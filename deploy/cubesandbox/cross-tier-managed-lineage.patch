+func TestCrashRollbackUnknownRuntimeHasNoSideEffects(t *testing.T) {
+	db := setupCrashRollbackServiceTest(t)
+	seed := &models.CrashRollbackRecord{
+		SandboxID:          "sb-1",
+		Epoch:              4,
+		State:              crashrollback.StateRollingBack,
+		LastSnapshotID:     "snap-g1",
+		LastNodeIP:         "10.0.0.1",
+		LastBackend:        "xfs",
+		InflightSnapshotID: "snap-g2",
+		RollbackTxnID:      "rollback-1",
+	}
+	require.NoError(t, db.Create(seed).Error)
+	require.NoError(t, db.Create(&models.PauseSnapshotRecord{
+		SnapshotID: "snap-g2",
+		SandboxID:  "sb-1",
+		Status:     pausesnap.StatusFailed,
+		Backend:    "xfs",
+	}).Error)
+	before, err := crashrollback.Get(context.Background(), "sb-1")
+	require.NoError(t, err)
+
+	counts := map[string]int{}
+	rsp := crashRollbackFromRecordWithDeps(
+		context.Background(),
+		crashRollbackTestRequest(),
+		"10.0.0.1",
+		noOpCrashRollbackDependencies(
+			crashRollbackRuntimeObservation{State: crashRollbackRuntimeUnknown},
+			counts,
+		),
+	)
+	require.Equal(t, int(errorcode.ErrorCode_ReqCubeAPIFailed), rsp.Ret.RetCode)
+	require.Contains(t, rsp.Ret.RetMsg, "state is unknown")
+	require.Zero(t, counts["destroy"])
+	require.Zero(t, counts["cleanup"])
+	require.Zero(t, counts["resume"])
+
+	after, err := crashrollback.Get(context.Background(), "sb-1")
+	require.NoError(t, err)
+	require.Equal(t, before.State, after.State)
+	require.Equal(t, before.Epoch, after.Epoch)
+	require.Equal(t, before.RollbackTxnID, after.RollbackTxnID)
+	binding, err := pausesnap.GetBySandbox(context.Background(), "sb-1")
+	require.NoError(t, err)
+	require.Equal(t, "snap-g2", binding.SnapshotID)
+	require.Equal(t, pausesnap.StatusFailed, binding.Status)
+}
