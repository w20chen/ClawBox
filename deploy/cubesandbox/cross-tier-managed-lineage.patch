+func TestRetireAndRollbackAcknowledgementsAreIdempotent(t *testing.T) {
+	setupTest(t)
+	ctx := context.Background()
+	first, err := Begin(ctx, "sb-1", "txn-g1", "snap-g1",
+		"node-1", "10.0.0.1", "cubebox", "xfs")
+	require.NoError(t, err)
+	require.NoError(t, Commit(ctx, "sb-1", "txn-g1", "snap-g1", first.Epoch,
+		"node-1", "10.0.0.1", "cubebox", "xfs", `{}`, "snap-old", "xfs"))
+	require.NoError(t, ClearRetire(ctx, "sb-1", "snap-old"))
+	require.NoError(t, ClearRetire(ctx, "sb-1", "snap-old"))
+	require.NoError(t, ClearRetire(ctx, "sb-1", "different-snapshot"))
+
+	second, err := Begin(ctx, "sb-1", "txn-g2", "snap-g2",
+		"node-1", "10.0.0.1", "cubebox", "xfs")
+	require.NoError(t, err)
+	require.NoError(t, Fail(ctx, "sb-1", "txn-g2", second.Epoch, "vmm died"))
+	failed, err := Get(ctx, "sb-1")
+	require.NoError(t, err)
+	rollback, err := BeginRollback(ctx, "sb-1", "rollback-g1", failed.Epoch)
+	require.NoError(t, err)
+	require.NoError(t, CompleteRollback(
+		ctx, "sb-1", "rollback-g1", rollback.Epoch, "runtime-2",
+	))
+	// This is the response-lost case: the first completion committed, but the
+	// client repeats the same request. A direct stale CAS is rejected; the
+	// lifecycle layer then observes the same runtime and treats it as success.
+	require.ErrorIs(t, CompleteRollback(
+		ctx, "sb-1", "rollback-g1", rollback.Epoch, "runtime-2",
+	), ErrCasConflict)
+	complete, err := Get(ctx, "sb-1")
+	require.NoError(t, err)
+	require.Equal(t, StateIDLE, complete.State)
+	require.Equal(t, "runtime-2", complete.RuntimeIncarnation)
+}
