diff --git a/Cubelet/services/cubebox/managed_memory_layers.go b/Cubelet/services/cubebox/managed_memory_layers.go
new file mode 100644
index 0000000..a13490a
--- /dev/null
+++ b/Cubelet/services/cubebox/managed_memory_layers.go
@@ -0,0 +1,338 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package cubebox
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	managedMemoryLayerDirName    = "layers"
+	managedMemoryLayerLockName   = ".gc.lock"
+	managedMemoryLayerMarkerPref = ".pending-"
+	managedMemoryLayerGCGrace    = 0
+)
+
+type managedMemoryLayerGCStats struct {
+	Scanned       int
+	Deleted       int
+	UnlinkedBytes uint64
+	Retained      int
+}
+
+func managedMemoryLayerRoots() []string {
+	seen := map[string]struct{}{}
+	roots := make([]string, 0, 2)
+	for _, name := range []string{"CLAWBOX_COLD_SNAPSHOT_ROOT", "CLAWBOX_WARM_SNAPSHOT_ROOT"} {
+		root := filepath.Clean(strings.TrimSpace(os.Getenv(name)))
+		if root == "." || !filepath.IsAbs(root) || root == string(filepath.Separator) {
+			continue
+		}
+		if _, ok := seen[root]; ok {
+			continue
+		}
+		seen[root] = struct{}{}
+		roots = append(roots, root)
+	}
+	return roots
+}
+
+type managedMemoryLineage struct {
+	SchemaVersion uint32 `json:"schema_version"`
+	Layers        []struct {
+		ExternalPath *string `json:"external_path,omitempty"`
+		LayerID      *string `json:"layer_id,omitempty"`
+		Managed      bool    `json:"managed,omitempty"`
+	} `json:"layers"`
+}
+
+type managedMemoryCrashRollbackManifest struct {
+	Objects []struct {
+		Path     string `json:"path"`
+		Category string `json:"category"`
+	} `json:"objects"`
+}
+
+func managedMemoryLayerReferences(roots []string) (map[string]struct{}, error) {
+	references := map[string]struct{}{}
+	for _, root := range roots {
+		err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {
+			if walkErr != nil {
+				if errors.Is(walkErr, fs.ErrNotExist) {
+					return nil
+				}
+				return walkErr
+			}
+			if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".lineage.json") {
+				return nil
+			}
+			raw, err := os.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			var lineage managedMemoryLineage
+			if err := json.Unmarshal(raw, &lineage); err != nil {
+				return fmt.Errorf("decode %s: %w", path, err)
+			}
+			if lineage.SchemaVersion != 1 && lineage.SchemaVersion != 2 {
+				return fmt.Errorf("unsupported RAM lineage schema %d in %s", lineage.SchemaVersion, path)
+			}
+			for _, layer := range lineage.Layers {
+				if layer.ExternalPath == nil || !layer.Managed {
+					continue
+				}
+				if layer.LayerID == nil || strings.ContainsAny(*layer.LayerID, `/\`) {
+					return fmt.Errorf("invalid managed RAM layer identity in %s", path)
+				}
+				references[filepath.Clean(*layer.ExternalPath)] = struct{}{}
+			}
+			return nil
+		})
+		if err != nil && !errors.Is(err, fs.ErrNotExist) {
+			return nil, err
+		}
+		err = filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {
+			if walkErr != nil {
+				if errors.Is(walkErr, fs.ErrNotExist) {
+					return nil
+				}
+				return walkErr
+			}
+			if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".crash-rollback.json") {
+				return nil
+			}
+			raw, err := os.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			var manifest managedMemoryCrashRollbackManifest
+			if err := json.Unmarshal(raw, &manifest); err != nil {
+				return fmt.Errorf("decode %s: %w", path, err)
+			}
+			for _, object := range manifest.Objects {
+				clean := filepath.Clean(strings.TrimSpace(object.Path))
+				switch object.Category {
+				case "lineage_layer":
+					references[clean] = struct{}{}
+				case "pending_marker":
+					references[filepath.Join(filepath.Dir(clean), "000000.mem")] = struct{}{}
+				}
+			}
+			return nil
+		})
+		if err != nil && !errors.Is(err, fs.ErrNotExist) {
+			return nil, err
+		}
+	}
+	return references, nil
+}
+
+func managedMemoryLayerGrace() time.Duration {
+	value := strings.TrimSpace(os.Getenv("CLAWBOX_MANAGED_LAYER_GC_GRACE_SECONDS"))
+	if value == "" {
+		return managedMemoryLayerGCGrace
+	}
+	seconds, err := strconv.ParseInt(value, 10, 64)
+	if err != nil || seconds < 0 {
+		return managedMemoryLayerGCGrace
+	}
+	return time.Duration(seconds) * time.Second
+}
+
+func lockManagedMemoryLayerRoot(root string) (*os.File, error) {
+	if err := os.MkdirAll(root, 0755); err != nil {
+		return nil, err
+	}
+	lock, err := os.OpenFile(filepath.Join(root, managedMemoryLayerLockName), os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	if err := unix.Flock(int(lock.Fd()), unix.LOCK_EX); err != nil {
+		lock.Close()
+		return nil, err
+	}
+	return lock, nil
+}
+
+func hasManagedMemoryLayerMarker(directory string) (bool, error) {
+	entries, err := os.ReadDir(directory)
+	if err != nil {
+		return false, err
+	}
+	for _, entry := range entries {
+		if strings.HasPrefix(entry.Name(), managedMemoryLayerMarkerPref) {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// abortDeadManagedMemoryLayerMarkers releases transaction ownership only
+// when the publisher process is conclusively gone. Stable sidecar and
+// crash-rollback manifest references remain authoritative for layer deletion.
+func abortDeadManagedMemoryLayerMarkers() (int, error) {
+	removed := 0
+	for _, tierRoot := range managedMemoryLayerRoots() {
+		layerRoot := filepath.Join(tierRoot, managedMemoryLayerDirName)
+		if _, err := os.Stat(layerRoot); errors.Is(err, fs.ErrNotExist) {
+			continue
+		} else if err != nil {
+			return removed, err
+		}
+		lock, err := lockManagedMemoryLayerRoot(layerRoot)
+		if err != nil {
+			return removed, err
+		}
+		directories, readErr := os.ReadDir(layerRoot)
+		if readErr != nil {
+			_ = unix.Flock(int(lock.Fd()), unix.LOCK_UN)
+			_ = lock.Close()
+			return removed, readErr
+		}
+		for _, entry := range directories {
+			if !entry.IsDir() {
+				continue
+			}
+			directory := filepath.Join(layerRoot, entry.Name())
+			markers, globErr := filepath.Glob(filepath.Join(
+				directory, managedMemoryLayerMarkerPref+"*",
+			))
+			if globErr != nil {
+				_ = unix.Flock(int(lock.Fd()), unix.LOCK_UN)
+				_ = lock.Close()
+				return removed, globErr
+			}
+			for _, marker := range markers {
+				suffix := strings.TrimPrefix(
+					filepath.Base(marker), managedMemoryLayerMarkerPref,
+				)
+				pidText := strings.SplitN(suffix, "-", 2)[0]
+				pid, parseErr := strconv.Atoi(pidText)
+				if parseErr != nil || pid <= 0 {
+					continue
+				}
+				if killErr := syscall.Kill(pid, 0); !errors.Is(killErr, syscall.ESRCH) {
+					continue
+				}
+				if err := os.Remove(marker); err != nil && !errors.Is(err, fs.ErrNotExist) {
+					_ = unix.Flock(int(lock.Fd()), unix.LOCK_UN)
+					_ = lock.Close()
+					return removed, err
+				}
+				removed++
+			}
+		}
+		_ = unix.Flock(int(lock.Fd()), unix.LOCK_UN)
+		_ = lock.Close()
+	}
+	return removed, nil
+}
+
+func gcManagedMemoryLayers() (managedMemoryLayerGCStats, error) {
+	return gcManagedMemoryLayersAt(time.Now(), managedMemoryLayerGrace())
+}
+
+// Managed layers are referenced by pathname, so link count alone cannot prove
+// liveness. Scan published lineage sidecars while holding the same layer-root
+// lock used by takeover, then delete only unreferenced, non-pending layers.
+func gcManagedMemoryLayersAt(now time.Time, grace time.Duration) (managedMemoryLayerGCStats, error) {
+	var stats managedMemoryLayerGCStats
+	roots := managedMemoryLayerRoots()
+	sort.Strings(roots)
+	locks := make([]*os.File, 0, len(roots))
+	layerRoots := make([]string, 0, len(roots))
+	defer func() {
+		for index := len(locks) - 1; index >= 0; index-- {
+			_ = unix.Flock(int(locks[index].Fd()), unix.LOCK_UN)
+			_ = locks[index].Close()
+		}
+	}()
+	for _, tierRoot := range roots {
+		if _, err := os.Stat(tierRoot); errors.Is(err, fs.ErrNotExist) {
+			continue
+		} else if err != nil {
+			return stats, err
+		}
+		layerRoot := filepath.Join(tierRoot, managedMemoryLayerDirName)
+		lock, err := lockManagedMemoryLayerRoot(layerRoot)
+		if err != nil {
+			return stats, err
+		}
+		locks = append(locks, lock)
+		layerRoots = append(layerRoots, layerRoot)
+	}
+	references, err := managedMemoryLayerReferences(roots)
+	if err != nil {
+		return stats, err
+	}
+	for _, layerRoot := range layerRoots {
+		entries, readErr := os.ReadDir(layerRoot)
+		if readErr != nil {
+			return stats, readErr
+		}
+		for _, entry := range entries {
+			if !entry.IsDir() {
+				continue
+			}
+			stats.Scanned++
+			directory := filepath.Join(layerRoot, entry.Name())
+			pending, err := hasManagedMemoryLayerMarker(directory)
+			if err != nil {
+				return stats, err
+			}
+			target := filepath.Join(directory, "000000.mem")
+			if pending {
+				stats.Retained++
+				continue
+			}
+			if _, retained := references[target]; retained {
+				stats.Retained++
+				continue
+			}
+			info, err := os.Lstat(directory)
+			if err != nil {
+				return stats, err
+			}
+			if now.Sub(info.ModTime()) < grace {
+				stats.Retained++
+				continue
+			}
+			fileInfo, err := os.Lstat(target)
+			if errors.Is(err, fs.ErrNotExist) {
+				if err := os.Remove(directory); err == nil {
+					stats.Deleted++
+				}
+				continue
+			}
+			if err != nil || !fileInfo.Mode().IsRegular() {
+				stats.Retained++
+				continue
+			}
+			var allocated unix.Stat_t
+			if err := unix.Stat(target, &allocated); err != nil {
+				return stats, err
+			}
+			if err := os.Remove(target); err != nil {
+				return stats, err
+			}
+			if err := os.Remove(directory); err != nil {
+				return stats, err
+			}
+			stats.Deleted++
+			stats.UnlinkedBytes += uint64(allocated.Blocks) * 512
+		}
+	}
+	return stats, nil
+}
