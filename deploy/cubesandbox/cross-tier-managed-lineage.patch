+func TestSafeManagedMemoryReclaimPathRejectsEscapes(t *testing.T) {
+	root := t.TempDir()
+	outside := t.TempDir()
+	t.Setenv("CLAWBOX_COLD_SNAPSHOT_ROOT", root)
+	t.Setenv("CLAWBOX_WARM_SNAPSHOT_ROOT", "")
+	inside := filepath.Join(root, "sandbox", "runtime.mem")
+	if err := os.MkdirAll(filepath.Dir(inside), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(inside, nil, 0600); err != nil {
+		t.Fatal(err)
