+		rsp.Ret.RetCode = int(errorcode.ErrorCode_ReqCubeAPIFailed)
+		rsp.Ret.RetMsg =
+			"resume completed but runtime state is unknown; rollback remains retryable"
+		return rsp
+	}
+	if runtime.State != crashRollbackRuntimeRunning ||
+		!runtimeMatchesRecoveryTarget(rollback, runtime) {
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_Conflict)
+		rsp.Ret.RetMsg =
+			"resume completed but the recovered runtime could not be verified"
+		return rsp
+	}
+	if err := crashrollback.CompleteRollback(
+		ctx, req.SandboxID, req.RequestID, rollback.Epoch, runtime.Incarnation,
+	); err != nil {
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_DBError)
+		rsp.Ret.RetMsg = fmt.Sprintf(
+			"sandbox resumed from %s but crash rollback record completion failed: %v",
+			targetID, err,
+		)
+		return rsp
+	}
+	rsp.Ret.RetMsg = fmt.Sprintf(
+		"crash rollback resumed last committed snapshot %s", targetID)
+	return rsp
+}
