+
+	inflightG2, err := Begin(ctx, "sb-1", "txn-g2", "snap-g2",
+		"node-1", "10.0.0.1", "cubebox", "xfs")
+	require.NoError(t, err)
+	require.Equal(t, "snap-g1", inflightG2.LastSnapshotID)
+	require.Equal(t, StatePreparing, inflightG2.State)
+
+	require.NoError(t, Fail(ctx, "sb-1", "txn-g2", inflightG2.Epoch, "ttrpc: closed"))
+	failed, err := Get(ctx, "sb-1")
+	require.NoError(t, err)
+	require.Equal(t, StateFailed, failed.State)
+	require.Equal(t, "snap-g1", failed.LastSnapshotID)
+	require.Equal(t, "snap-g2", failed.InflightSnapshotID)
+
+	_, err = Begin(ctx, "sb-1", "txn-g3", "snap-g3",
+		"node-1", "10.0.0.1", "cubebox", "xfs")
+	require.ErrorIs(t, err, ErrNotAllowed)
+
+	rollback, err := BeginRollback(ctx, "sb-1", "rollback-1", failed.Epoch)
+	require.NoError(t, err)
+	require.Equal(t, StateRollingBack, rollback.State)
+	require.Equal(t, "snap-g1", rollback.LastSnapshotID)
+
+	require.NoError(t, CompleteRollback(ctx, "sb-1", "rollback-1", rollback.Epoch, "runtime-2"))
+	complete, err := Get(ctx, "sb-1")
