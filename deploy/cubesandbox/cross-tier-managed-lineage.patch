+	require.NoError(t, MarkLocalSealed(ctx, "sb-1", "txn-g1", first.Epoch))
+	require.NoError(t, Commit(ctx, "sb-1", "txn-g1", "snap-g1", first.Epoch,
+		"node-1", "10.0.0.1", "cubebox", "xfs", `{"sealed":true}`, "", ""))
