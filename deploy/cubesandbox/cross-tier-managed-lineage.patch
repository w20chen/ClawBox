+func observeCrashRollbackRuntime(
+	ctx context.Context,
+	hostIP string,
+	sandboxID string,
+) crashRollbackRuntimeObservation {
+	listRsp, err := listCrashRollbackRuntime(
+		ctx, cubelet.GetCubeletAddr(hostIP), &cubebox.ListCubeSandboxRequest{
+			Id: &sandboxID,
+		},
+	)
+	if err != nil || listRsp == nil {
+		return crashRollbackRuntimeObservation{State: crashRollbackRuntimeUnknown}
+	}
+	return classifyCrashRollbackRuntime(listRsp, sandboxID)
+}
+
+func classifyCrashRollbackRuntime(
+	listRsp *cubebox.ListCubeSandboxResponse,
+	sandboxID string,
+) crashRollbackRuntimeObservation {
+	if listRsp == nil {
+		return crashRollbackRuntimeObservation{State: crashRollbackRuntimeUnknown}
+	}
+	var matched *cubebox.CubeSandbox
+	for _, item := range listRsp.GetItems() {
+		if item.GetId() != sandboxID {
+			continue
+		}
+		if matched != nil {
+			// Duplicate identities cannot establish which runtime is authoritative.
+			return crashRollbackRuntimeObservation{State: crashRollbackRuntimeUnknown}
+		}
+		matched = item
+	}
+	if matched == nil {
+		if len(listRsp.GetItems()) != 0 {
+			return crashRollbackRuntimeObservation{State: crashRollbackRuntimeUnknown}
+		}
+		return crashRollbackRuntimeObservation{State: crashRollbackRuntimeStopped}
+	}
+
+	running := 0
+	stopped := 0
+	var runningContainer *cubebox.Container
+	for _, container := range matched.GetContainers() {
+		if container.GetId() != sandboxID {
+			continue
+		}
+		switch container.GetState() {
+		case cubebox.ContainerState_CONTAINER_RUNNING:
+			running++
+			runningContainer = container
+		case cubebox.ContainerState_CONTAINER_EXITED,
+			cubebox.ContainerState_CONTAINER_PAUSED:
+			stopped++
+		default:
+			// CREATED, UNKNOWN and PAUSING are transitional and cannot be
+			// safely treated as an explicit death signal.
+			return crashRollbackRuntimeObservation{State: crashRollbackRuntimeUnknown}
+		}
+	}
+	if running > 1 {
+		return crashRollbackRuntimeObservation{State: crashRollbackRuntimeUnknown}
+	}
+	if running == 1 {
+		createdAt := matched.GetCreatedAt()
+		containerCreatedAt := runningContainer.GetCreatedAt()
+		if createdAt <= 0 || containerCreatedAt <= 0 {
+			return crashRollbackRuntimeObservation{State: crashRollbackRuntimeUnknown}
+		}
+		labels := matched.GetLabels()
+		restoreSnapshotID := strings.TrimSpace(
+			labels["cube.master.runtime.restore.snapshot.id"],
+		)
+		if restoreSnapshotID == "" {
+			restoreSnapshotID = strings.TrimSpace(
+				labels["cube.master.pause.snapshot.id"],
+			)
+		}
+		return crashRollbackRuntimeObservation{
+			State: crashRollbackRuntimeRunning,
+			Incarnation: fmt.Sprintf(
+				"%s@%d/%d", sandboxID, createdAt, containerCreatedAt,
+			),
+			CreatedAt:         createdAt,
+			RestoreSnapshotID: restoreSnapshotID,
+		}
+	}
+	if stopped > 0 {
+		return crashRollbackRuntimeObservation{State: crashRollbackRuntimeStopped}
+	}
+	return crashRollbackRuntimeObservation{State: crashRollbackRuntimeUnknown}
+}
+
+func runtimeMatchesRecoveryTarget(
+	record *crashrollback.Record,
+	runtime crashRollbackRuntimeObservation,
+) bool {
+	if record == nil || runtime.State != crashRollbackRuntimeRunning {
+		return false
+	}
+	if expected := strings.TrimSpace(record.RuntimeIncarnation); expected != "" {
+		return runtime.Incarnation == expected
+	}
+	if runtime.CreatedAt <= 0 ||
+		runtime.RestoreSnapshotID != strings.TrimSpace(record.LastSnapshotID) {
+		return false
+	}
+	if !record.UpdatedAt.IsZero() &&
+		runtime.CreatedAt < record.UpdatedAt.UnixNano() {
+		return false
+	}
+	return true
+}
