--- a/CubeAPI/src/handlers/sandboxes.rs
+++ b/CubeAPI/src/handlers/sandboxes.rs
@@ -405,6 +405,39 @@ pub async fn resume_sandbox(
 
 // ─── POST /sandboxes/:sandboxID/connect ───────────────────────────────────────
 
+/// Explicitly recover the last globally committed snapshot after a failed
+/// incremental-cow pause. This is intentionally separate from connect/resume.
+#[utoipa::path(
+    post,
+    path = "/sandboxes/{sandboxID}/crash-rollback",
+    params(
+        ("sandboxID" = String, Path, description = "Sandbox identifier")
+    ),
+    request_body = ConnectSandbox,
+    responses(
+        (status = 201, description = "Sandbox recovered from last committed snapshot", body = Sandbox),
+        (status = 400, description = "No recoverable committed snapshot", body = ApiError),
+        (status = 404, description = "Sandbox not found", body = ApiError),
+        (status = 500, description = "Unexpected backend error", body = ApiError)
+    )
+)]
+pub async fn crash_rollback_sandbox(
+    State(state): State<AppState>,
+    Path(sandbox_id): Path<String>,
+    Json(body): Json<ConnectSandbox>,
+) -> AppResult<impl IntoResponse> {
+    let sandbox = state
+        .services
+        .sandboxes
+        .crash_rollback_sandbox(
+            &sandbox_id,
+            body.timeout,
+            body.snapshot_mechanism.as_deref(),
+        )
+        .await?;
+    Ok((StatusCode::CREATED, Json(sandbox)))
+}
+
