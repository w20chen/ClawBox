+fn tier_roots() -> Vec<PathBuf> {
+    ["CLAWBOX_COLD_SNAPSHOT_ROOT", "CLAWBOX_WARM_SNAPSHOT_ROOT"]
+        .iter()
+        .filter_map(|name| std::env::var_os(name).map(PathBuf::from))
+        .filter(|root| root.is_absolute() && root != Path::new("/"))
+        .collect()
+}
+
+fn managed_root_for(source: &Path) -> io::Result<PathBuf> {
+    if let Some(root) = tier_roots()
+        .into_iter()
+        .find(|root| source.starts_with(root))
+    {
+        return Ok(root.join("layers"));
+    }
+    // Shim processes do not always inherit Cubelet's tier-root environment.
+    // A snapshot layer lives at
+    // <tier-root>/<sandbox>/<memory>.layers/<layer>. Infer only from that
+    // exact shape; an unclear root must fail instead of creating a private
+    // layer repository somewhere else.
+    let layers_dir = source.parent()
+        .filter(|directory| directory.file_name()
+            .and_then(|name| name.to_str())
+            .is_some_and(|name| name.ends_with(".layers")))
+        .ok_or_else(|| invalid("RAM layer is not in a .layers directory"))?;
+    let root = layers_dir.parent()
+        .and_then(Path::parent)
+        .filter(|root| root.is_absolute() && *root != Path::new("/"))
+        .map(|root| root.join("layers"))
+        .ok_or_else(|| invalid("cross-tier RAM layer is outside a configured tier root"))?;
+    Ok(root)
