+type crashRollbackRuntimeObservation struct {
+	State             crashRollbackRuntimeState
+	Incarnation       string
+	CreatedAt         int64
+	RestoreSnapshotID string
+}
+
+type crashRollbackDependencies struct {
+	observeRuntime func(ctx context.Context, hostIP, sandboxID string) crashRollbackRuntimeObservation
+	destroy        func(context.Context, string, *cubebox.DestroyCubeSandboxRequest) (*cubebox.DestroyCubeSandboxResponse, error)
+	cleanup        func(context.Context, string, *cubebox.CleanupTemplateRequest) (*cubebox.CleanupTemplateResponse, error)
+	resume         func(context.Context, *types.UpdateRequest, string) *types.Res
+}
+
+var defaultCrashRollbackDependencies = crashRollbackDependencies{
+	observeRuntime: observeCrashRollbackRuntime,
+	destroy:        cubelet.Destroy,
+	cleanup:        cubelet.CleanupTemplate,
+	resume:         resumeFromPauseSnapshot,
+}
+
+var listCrashRollbackRuntime = cubelet.List
+
+// crashRollbackFromRecord is an explicit recovery operation. It never changes
+// the failed inflight snapshot into READY; it activates only the independently
+// persisted last globally committed snapshot and resumes that same sandbox ID.
+func crashRollbackFromRecord(ctx context.Context, req *types.UpdateRequest, hostIP string) *types.Res {
+	return crashRollbackFromRecordWithDeps(
+		ctx, req, hostIP, defaultCrashRollbackDependencies,
+	)
+}
+
+func crashRollbackFromRecordWithDeps(
+	ctx context.Context,
+	req *types.UpdateRequest,
+	hostIP string,
+	deps crashRollbackDependencies,
+) *types.Res {
+	rsp := &types.Res{Ret: &types.Ret{
+		RetCode: int(errorcode.ErrorCode_Success),
+		RetMsg:  errorcode.ErrorCode_Success.String(),
+	}}
+	record, err := crashrollback.Get(ctx, req.SandboxID)
+	if err != nil {
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_MasterParamsError)
+		rsp.Ret.RetMsg = fmt.Sprintf("load crash rollback record: %v", err)
+		return rsp
+	}
+	existing, existingErr := pausesnap.GetBySandbox(ctx, req.SandboxID)
+	if existingErr != nil && !errors.Is(existingErr, pausesnap.ErrNotFound) {
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_DBError)
+		rsp.Ret.RetMsg = fmt.Sprintf("inspect pause binding: %v", existingErr)
+		return rsp
+	}
+	probeIP := strings.TrimSpace(record.LastNodeIP)
+	if probeIP == "" && existing != nil {
+		probeIP = strings.TrimSpace(existing.NodeIP)
+	}
+	if probeIP == "" {
+		probeIP = strings.TrimSpace(hostIP)
+	}
+	runtime := deps.observeRuntime(ctx, probeIP, req.SandboxID)
+	switch runtime.State {
+	case crashRollbackRuntimeUnknown:
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_ReqCubeAPIFailed)
+		rsp.Ret.RetMsg =
+			"runtime state is unknown; refusing crash rollback side effects and retry later"
+		return rsp
+	case crashRollbackRuntimeRunning:
+		if strings.EqualFold(record.State, crashrollback.StateIDLE) &&
+			strings.TrimSpace(record.RuntimeIncarnation) != "" {
+			if runtime.Incarnation != record.RuntimeIncarnation {
+				rsp.Ret.RetCode = int(errorcode.ErrorCode_Conflict)
+				rsp.Ret.RetMsg =
+					"a different runtime with this sandbox ID is already running"
+				return rsp
+			}
+			rsp.Ret.RetMsg = "crash rollback already completed; using the existing runtime"
+			return rsp
+		}
+		if strings.EqualFold(record.State, crashrollback.StateRollingBack) {
+			if !runtimeMatchesRecoveryTarget(record, runtime) {
+				rsp.Ret.RetCode = int(errorcode.ErrorCode_Conflict)
+				rsp.Ret.RetMsg =
+					"running runtime does not match the crash rollback target instance"
+				return rsp
+			}
+			if err := crashrollback.CompleteRollback(
+				ctx, req.SandboxID, record.RollbackTxnID, record.Epoch,
+				runtime.Incarnation,
+			); err != nil {
+				rsp.Ret.RetCode = int(errorcode.ErrorCode_DBError)
+				rsp.Ret.RetMsg = fmt.Sprintf(
+					"runtime recovered but rollback record completion failed: %v", err)
+				return rsp
+			}
+			rsp.Ret.RetMsg = "crash rollback already recovered the runtime"
+			return rsp
+		}
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_Conflict)
+		rsp.Ret.RetMsg =
+			"crash rollback cannot start while a runtime with this sandbox ID is already running"
+		return rsp
+	}
+
+	// A crash after Cubelet sealed the package but before Master committed
+	// leaves the durable record in PREPARING or LOCAL_SEALED. The runtime is
+	// already fenced, so make that abort explicit before entering ROLLING_BACK.
+	if strings.EqualFold(record.State, crashrollback.StatePreparing) ||
+		strings.EqualFold(record.State, crashrollback.StateLocalSealed) {
+		if err := crashrollback.Fail(
+			ctx, req.SandboxID, record.InflightTxnID, record.Epoch,
+			"crash rollback after master restart before commit",
+		); err != nil {
+			rsp.Ret.RetCode = int(errorcode.ErrorCode_DBError)
+			rsp.Ret.RetMsg = fmt.Sprintf(
+				"fail uncommitted crash rollback transaction: %v", err)
+			return rsp
+		}
+		record, err = crashrollback.Get(ctx, req.SandboxID)
+		if err != nil {
+			rsp.Ret.RetCode = int(errorcode.ErrorCode_DBError)
+			rsp.Ret.RetMsg = fmt.Sprintf(
+				"reload failed crash rollback transaction: %v", err)
+			return rsp
+		}
+	}
+
+	var rollback *crashrollback.Record
+	switch {
+	case strings.EqualFold(record.State, crashrollback.StateFailed),
+		strings.EqualFold(record.State, crashrollback.StateRollingBack):
+		rollback, err = crashrollback.BeginRollback(
+			ctx, req.SandboxID, req.RequestID, record.Epoch)
+	case strings.EqualFold(record.State, crashrollback.StateIDLE):
+		// This window exists when Master dies between pausesnap.Begin and
+		// crashrollback.Begin. The pause binding is still CREATING (or was
+		// transitioned READY by a crashed handler), while the authoritative
+		// record remains IDLE on the previous committed snapshot.
+		if existing == nil || strings.TrimSpace(existing.SnapshotID) == "" ||
+			strings.TrimSpace(existing.SnapshotID) ==
+				strings.TrimSpace(record.LastSnapshotID) {
+			rsp.Ret.RetCode = int(errorcode.ErrorCode_MasterParamsError)
+			rsp.Ret.RetMsg =
+				"crash rollback has no uncommitted pause binding to recover"
+			return rsp
+		}
+		rollback, err = crashrollback.BeginOrphanRollback(
+			ctx, req.SandboxID, req.RequestID, record.Epoch)
+	default:
+		err = fmt.Errorf(
+			"crash rollback record state=%s is not recoverable", record.State)
+	}
+	if err != nil {
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_MasterParamsError)
+		rsp.Ret.RetMsg = err.Error()
+		return rsp
+	}
+	targetID := strings.TrimSpace(rollback.LastSnapshotID)
+	if targetID == "" {
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_MasterParamsError)
+		rsp.Ret.RetMsg = "cannot crash rollback: no last committed snapshot"
+		return rsp
+	}
+	var evidence crashRollbackEvidence
+	if raw := strings.TrimSpace(rollback.LastCommitEvidenceJSON); raw != "" {
+		_ = json.Unmarshal([]byte(raw), &evidence)
+	}
+	if evidence.SnapshotID != "" && evidence.SnapshotID != targetID {
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_MasterInternalError)
+		rsp.Ret.RetMsg = "crash rollback evidence snapshot does not match last committed snapshot"
+		return rsp
+	}
+	if strings.EqualFold(record.State, crashrollback.StateFailed) ||
+		strings.EqualFold(record.State, crashrollback.StateRollingBack) {
+		targetIP := strings.TrimSpace(rollback.LastNodeIP)
+		if targetIP == "" {
+			targetIP = hostIP
+		}
+		destroyRsp, destroyErr := deps.destroy(
+			ctx, cubelet.GetCubeletAddr(targetIP),
+			&cubebox.DestroyCubeSandboxRequest{
+				RequestID: req.RequestID,
+				SandboxID: req.SandboxID,
+				Annotations: map[string]string{
+					"cube.debug.cleanup": "true",
+				},
+			},
+		)
+		destroyCode := cubeleterrorcode.ErrorCode_Unknown
+		if destroyRsp != nil && destroyRsp.GetRet() != nil {
+			destroyCode = destroyRsp.GetRet().GetRetCode()
+		}
+		if destroyErr != nil || destroyRsp == nil ||
+			destroyRsp.GetRet() == nil ||
+			(destroyCode != cubeleterrorcode.ErrorCode_Success &&
+				destroyCode != cubeleterrorcode.ErrorCode_OK) {
+			rsp.Ret.RetCode = int(errorcode.ErrorCode_ReqCubeAPIFailed)
+			rsp.Ret.RetMsg = fmt.Sprintf(
+				"fence failed runtime before crash rollback: rsp=%v err=%v",
+				destroyRsp, destroyErr,
+			)
+			return rsp
+		}
+	}
+	inflightID := strings.TrimSpace(rollback.InflightSnapshotID)
+	if inflightID == "" && existing != nil &&
+		strings.TrimSpace(existing.SnapshotID) != targetID {
+		// The pause binding itself is the only durable name for the package
+		// in the orphan window (crashrecord.Begin never ran).
+		inflightID = strings.TrimSpace(existing.SnapshotID)
+	}
+	if inflightID != "" {
+		cleanupIP := strings.TrimSpace(rollback.LastNodeIP)
+		if cleanupIP == "" {
+			cleanupIP = hostIP
+		}
+		cleanupCtx, cleanupCancel := context.WithTimeout(
+			context.WithoutCancel(ctx), 30*time.Second)
+		cleanupRsp, cleanupErr := deps.cleanup(
+			cleanupCtx, cubelet.GetCubeletAddr(cleanupIP),
+			&cubebox.CleanupTemplateRequest{
+				RequestID:  req.RequestID,
+				TemplateID: inflightID,
+				Backend:    rollback.LastBackend,
+				Annotations: map[string]string{
+					"cube.master.crash_rollback.abort_dead_markers": "true",
+				},
+			},
+		)
+		cleanupCancel()
+		cleanupCode := cubeleterrorcode.ErrorCode_Unknown
+		if cleanupRsp != nil && cleanupRsp.GetRet() != nil {
+			cleanupCode = cleanupRsp.GetRet().GetRetCode()
+		}
+		if cleanupErr != nil || cleanupRsp == nil ||
+			cleanupRsp.GetRet() == nil ||
+			(cleanupCode != cubeleterrorcode.ErrorCode_Success &&
+				cleanupCode != cubeleterrorcode.ErrorCode_OK) {
+			reason := fmt.Sprintf(
+				"cleanup failed inflight snapshot %s: rsp=%v err=%v",
+				inflightID, cleanupRsp, cleanupErr,
+			)
+			_ = crashrollback.FailRollback(
+				ctx, req.SandboxID, req.RequestID, rollback.Epoch, reason)
+			rsp.Ret.RetCode = int(errorcode.ErrorCode_ReqCubeAPIFailed)
+			rsp.Ret.RetMsg = reason
+			return rsp
+		}
+	}
+	if existingErr == nil && existing != nil && existing.SnapshotID != targetID {
+		if err := pausesnap.Delete(ctx, existing.SnapshotID); err != nil {
+			rsp.Ret.RetCode = int(errorcode.ErrorCode_DBError)
+			rsp.Ret.RetMsg = fmt.Sprintf("delete failed inflight binding: %v", err)
+			return rsp
+		}
+	}
+	if existingErr != nil || existing == nil || existing.SnapshotID != targetID {
+		nodeIP := strings.TrimSpace(rollback.LastNodeIP)
+		if nodeIP == "" {
+			nodeIP = hostIP
+		}
+		instanceType := strings.TrimSpace(evidence.InstanceType)
+		if instanceType == "" {
+			instanceType = req.InstanceType
+		}
+		backend := strings.TrimSpace(evidence.Backend)
+		if backend == "" {
+			backend = rollback.LastBackend
+		}
+		recovery := &pausesnap.Record{
+			SandboxID:           req.SandboxID,
+			SnapshotID:          targetID,
+			NodeID:              rollback.LastNodeID,
+			NodeIP:              nodeIP,
+			InstanceType:        instanceType,
+			Status:              pausesnap.StatusReady,
+			PluginVolumeIDs:     evidence.PluginVolumeIDs,
+			Backend:             backend,
+			RemoteStatus:        evidence.RemoteStatus,
+			OriginHostFactsJSON: evidence.OriginHostFactsJSON,
+			ExportUUIDs:         evidence.ExportUUIDs,
+		}
+		if err := pausesnap.ActivateRecoveryBinding(ctx, recovery); err != nil {
+			rsp.Ret.RetCode = int(errorcode.ErrorCode_DBError)
+			rsp.Ret.RetMsg = fmt.Sprintf("activate recovery binding: %v", err)
+			return rsp
+		}
+	}
+	resumed := deps.resume(ctx, req, hostIP)
+	if resumed.Ret == nil || resumed.Ret.RetCode != int(errorcode.ErrorCode_Success) {
+		if resumed.Ret != nil {
+			_ = crashrollback.FailRollback(
+				ctx, req.SandboxID, req.RequestID, rollback.Epoch,
+				resumed.Ret.RetMsg,
