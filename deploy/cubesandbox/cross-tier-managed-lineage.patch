+func TestCrashRollbackUnknownAfterResumeDoesNotDestroyOrComplete(t *testing.T) {
+	db := setupCrashRollbackServiceTest(t)
+	seed := &models.CrashRollbackRecord{
+		SandboxID:          "sb-1",
+		Epoch:              4,
+		State:              crashrollback.StateFailed,
+		LastSnapshotID:     "snap-g1",
+		LastNodeIP:         "10.0.0.1",
+		LastBackend:        "xfs",
+		InflightSnapshotID: "snap-g2",
+		InflightTxnID:      "txn-g2",
+	}
+	require.NoError(t, db.Create(seed).Error)
+
+	createdAt := time.Now().Add(time.Second).UnixNano()
+	targetRuntime := crashRollbackRuntimeObservation{
+		State:             crashRollbackRuntimeRunning,
+		Incarnation:       "sb-1@200/201",
+		CreatedAt:         createdAt,
+		RestoreSnapshotID: "snap-g1",
+	}
+	counts := map[string]int{}
+	deps := noOpCrashRollbackDependencies(targetRuntime, counts)
+	deps.observeRuntime = func(context.Context, string, string) crashRollbackRuntimeObservation {
+		counts["observe"]++
+		switch counts["observe"] {
+		case 1:
+			return crashRollbackRuntimeObservation{State: crashRollbackRuntimeStopped}
+		case 2:
+			return crashRollbackRuntimeObservation{State: crashRollbackRuntimeUnknown}
+		default:
+			return targetRuntime
+		}
+	}
+
+	first := crashRollbackFromRecordWithDeps(
+		context.Background(), crashRollbackTestRequest(), "10.0.0.1", deps,
+	)
+	require.Equal(t, int(errorcode.ErrorCode_ReqCubeAPIFailed), first.Ret.RetCode)
+	require.Equal(t, 1, counts["destroy"])
+	require.Equal(t, 1, counts["cleanup"])
+	require.Equal(t, 1, counts["resume"])
+	pending, err := crashrollback.Get(context.Background(), "sb-1")
+	require.NoError(t, err)
+	require.Equal(t, crashrollback.StateRollingBack, pending.State)
+
+	second := crashRollbackFromRecordWithDeps(
+		context.Background(), crashRollbackTestRequest(), "10.0.0.1", deps,
+	)
+	require.Equal(t, int(errorcode.ErrorCode_Success), second.Ret.RetCode)
+	require.Equal(t, 1, counts["destroy"])
+	require.Equal(t, 1, counts["cleanup"])
+	require.Equal(t, 1, counts["resume"])
+	complete, err := crashrollback.Get(context.Background(), "sb-1")
+	require.NoError(t, err)
+	require.Equal(t, crashrollback.StateIDLE, complete.State)
+	require.Equal(t, targetRuntime.Incarnation, complete.RuntimeIncarnation)
+}
