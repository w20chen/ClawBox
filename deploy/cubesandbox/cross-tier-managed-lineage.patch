+fn take_over_managed_layer(source: &Path) -> io::Result<(String, PathBuf, PathBuf)> {
+    let root = managed_root_for(source)?;
+    let _root_lock = ManagedRootLock::acquire(&root)?;
+    let source_file = File::open(source)?;
+    let source_metadata = fs::symlink_metadata(source)?;
+    if !source_metadata.is_file() {
+        return Err(invalid("managed RAM layer is not a regular file"));
+    }
+    let layer_id = managed_layer_identity(&source_metadata);
+    let directory = root.join(&layer_id);
+    fs::create_dir_all(&directory)?;
+    let operation = NEXT_TAKEOVER_MARKER.fetch_add(1, Ordering::Relaxed);
+    let marker = directory.join(format!(
+        ".pending-{}-{}", std::process::id(), operation
+    ));
+    OpenOptions::new().create(true).write(true).truncate(true).open(&marker)?;
