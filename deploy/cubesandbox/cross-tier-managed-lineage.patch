+fn acquire_managed_root_locks(markers: &[PathBuf]) -> io::Result<Vec<ManagedRootLock>> {
+    let mut roots = markers.iter()
+        .filter_map(|marker| marker.parent().and_then(Path::parent).map(Path::to_path_buf))
+        .collect::<Vec<_>>();
+    roots.sort();
+    roots.dedup();
+    roots.into_iter().map(|root| ManagedRootLock::acquire(&root)).collect()
