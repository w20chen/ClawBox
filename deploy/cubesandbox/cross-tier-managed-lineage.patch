diff --git a/CubeMaster/pkg/crashrollback/store.go b/CubeMaster/pkg/crashrollback/store.go
new file mode 100644
index 0000000..439f084
--- /dev/null
+++ b/CubeMaster/pkg/crashrollback/store.go
@@ -0,0 +1,487 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+// Package crashrollback persists the last globally committed incremental-cow
+// recovery point independently from the active pause binding. It intentionally
+// keeps one last-commit row and one inflight transaction per sandbox.
+package crashrollback
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"sync"
+
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/constants"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/db/models"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+const (
+	StateIDLE         = "IDLE"
+	StatePreparing    = "PREPARING"
+	StateLocalSealed  = "LOCAL_SEALED"
+	StateFailed       = "FAILED"
+	StateRollingBack  = "ROLLING_BACK"
+	envCrashRollback  = "CLAWBOX_CRASH_ROLLBACK"
+	phaseIdle         = ""
+	phasePreparing    = "PREPARING"
+	phaseLocalSealed  = "LOCAL_SEALED"
+	phaseFailed       = "FAILED"
+	phaseRollingBack  = "ROLLING_BACK"
+	commitEvidenceMax = 64 << 10
+)
+
+var (
+	mu     sync.RWMutex
+	gormDB *gorm.DB
+
+	ErrNotReady    = errors.New("crash rollback store not initialized")
+	ErrNotFound    = errors.New("crash rollback record not found")
+	ErrCasConflict = errors.New("crash rollback CAS conflict")
+	ErrNotAllowed  = errors.New("crash rollback transition not allowed")
+)
+
+type Record = models.CrashRollbackRecord
+
+func Init(database *gorm.DB) {
+	mu.Lock()
+	defer mu.Unlock()
+	gormDB = database
+}
+
+func getDB() *gorm.DB {
+	mu.RLock()
+	defer mu.RUnlock()
+	return gormDB
+}
+
+// Enabled keeps the research protocol opt-in.
+func Enabled() bool {
+	return strings.TrimSpace(os.Getenv(envCrashRollback)) == "1"
+}
+
+func Get(ctx context.Context, sandboxID string) (*Record, error) {
+	client := getDB()
+	if client == nil {
+		return nil, ErrNotReady
+	}
+	var row Record
+	err := client.WithContext(ctx).Where("sandbox_id = ?", strings.TrimSpace(sandboxID)).
+		First(&row).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &row, nil
+}
+
+func Delete(ctx context.Context, sandboxID string) error {
+	client := getDB()
+	if client == nil {
+		return ErrNotReady
+	}
+	sandboxID = strings.TrimSpace(sandboxID)
+	if sandboxID == "" {
+		return errors.New("sandboxID is required")
+	}
+	return client.WithContext(ctx).Where("sandbox_id = ?", sandboxID).
+		Delete(&Record{}).Error
+}
+
+// Begin records a new pause transaction while preserving the previous
+// committed snapshot. A failed crash record must be explicitly rolled back or
+// destroyed before another pause can begin.
+func Begin(ctx context.Context, sandboxID, txnID, snapshotID, nodeID, nodeIP,
+	instanceType, backend string) (*Record, error) {
+	client := getDB()
+	if client == nil {
+		return nil, ErrNotReady
+	}
+	sandboxID = strings.TrimSpace(sandboxID)
+	txnID = strings.TrimSpace(txnID)
+	snapshotID = strings.TrimSpace(snapshotID)
+	if sandboxID == "" || txnID == "" || snapshotID == "" {
+		return nil, errors.New("sandboxID, txnID and snapshotID are required")
+	}
+	var previous Record
+	err := client.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		loadErr := tx.Clauses(clause.Locking{Strength: "UPDATE"}).
+			Where("sandbox_id = ?", sandboxID).First(&previous).Error
+		if errors.Is(loadErr, gorm.ErrRecordNotFound) {
+			previous = Record{
+				SandboxID:          sandboxID,
+				Epoch:              1,
+				State:              StatePreparing,
+				InflightTxnID:      txnID,
+				InflightSnapshotID: snapshotID,
+				InflightPhase:      phasePreparing,
+			}
+			return tx.Create(&previous).Error
+		}
+		if loadErr != nil {
+			return loadErr
+		}
+		if previous.State == StateFailed || previous.State == StateRollingBack {
+			return fmt.Errorf("%w: previous transaction requires rollback", ErrNotAllowed)
+		}
+		if strings.TrimSpace(previous.InflightTxnID) != "" {
+			return fmt.Errorf("%w: inflight transaction already exists", ErrNotAllowed)
+		}
+		if strings.TrimSpace(previous.RetireSnapshotID) != "" {
+			return fmt.Errorf("%w: previous snapshot retirement is still pending", ErrNotAllowed)
+		}
+		updates := map[string]any{
+			"state":                StatePreparing,
+			"inflight_txn_id":      txnID,
+			"inflight_snapshot_id": snapshotID,
+			"inflight_phase":       phasePreparing,
+			"inflight_last_error":  "",
+			"rollback_txn_id":      "",
+			"runtime_incarnation":  "",
+		}
+		res := tx.Model(&Record{}).
+			Where("sandbox_id = ? AND epoch = ? AND state = ?",
+				sandboxID, previous.Epoch, previous.State).
+			Updates(updates)
+		if res.Error != nil {
+			return res.Error
+		}
+		if res.RowsAffected != 1 {
+			return ErrCasConflict
+		}
+		return tx.Where("sandbox_id = ?", sandboxID).First(&previous).Error
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &previous, nil
+}
+
+func MarkLocalSealed(ctx context.Context, sandboxID, txnID string, epoch uint64) error {
+	return updateInflight(ctx, sandboxID, txnID, epoch, StatePreparing,
+		StateLocalSealed, phaseLocalSealed, "")
+}
+
+func Fail(ctx context.Context, sandboxID, txnID string, epoch uint64, reason string) error {
+	client := getDB()
+	if client == nil {
+		return ErrNotReady
+	}
+	reason = truncate(reason, commitEvidenceMax)
+	res := client.WithContext(ctx).Model(&Record{}).
+		Where("sandbox_id = ? AND epoch = ? AND inflight_txn_id = ? AND state IN ?",
+			strings.TrimSpace(sandboxID), epoch, strings.TrimSpace(txnID),
+			[]string{StatePreparing, StateLocalSealed}).
+		Updates(map[string]any{
+			"epoch":               gorm.Expr("epoch + 1"),
+			"state":               StateFailed,
+			"inflight_phase":      phaseFailed,
+			"inflight_last_error": reason,
+		})
+	if res.Error != nil {
+		return res.Error
+	}
+	if res.RowsAffected != 1 {
+		return ErrCasConflict
+	}
+	return nil
+}
+
+// Commit atomically advances last_committed. The caller must not delete the
+// previous package until this returns nil.
+func Commit(ctx context.Context, sandboxID, txnID, snapshotID string, epoch uint64,
+	nodeID, nodeIP, instanceType, backend, evidenceJSON, retireSnapshotID,
+	retireBackend string) error {
+	client := getDB()
+	if client == nil {
+		return ErrNotReady
+	}
+	res := client.WithContext(ctx).Model(&Record{}).
+		Where("sandbox_id = ? AND epoch = ? AND inflight_txn_id = ? AND inflight_snapshot_id = ? AND state IN ?",
+			strings.TrimSpace(sandboxID), epoch, strings.TrimSpace(txnID),
+			strings.TrimSpace(snapshotID), []string{StatePreparing, StateLocalSealed}).
+		Updates(map[string]any{
+			"epoch":                     gorm.Expr("epoch + 1"),
+			"state":                     StateIDLE,
+			"last_snapshot_id":          strings.TrimSpace(snapshotID),
+			"last_node_id":              strings.TrimSpace(nodeID),
+			"last_node_ip":              strings.TrimSpace(nodeIP),
+			"last_instance_type":        strings.TrimSpace(instanceType),
+			"last_backend":              strings.TrimSpace(backend),
+			"last_commit_evidence_json": truncate(evidenceJSON, commitEvidenceMax),
+			"inflight_txn_id":           "",
+			"inflight_snapshot_id":      "",
+			"inflight_phase":            phaseIdle,
+			"inflight_last_error":       "",
+			"rollback_txn_id":           "",
+			"retire_snapshot_id":        strings.TrimSpace(retireSnapshotID),
+			"retire_backend":            strings.TrimSpace(retireBackend),
+			"retire_last_error":         "",
+		})
+	if res.Error != nil {
+		return res.Error
+	}
+	if res.RowsAffected != 1 {
+		return ErrCasConflict
+	}
+	return nil
+}
+
+func MarkRetireError(ctx context.Context, sandboxID, snapshotID, reason string) error {
+	client := getDB()
+	if client == nil {
+		return ErrNotReady
+	}
+	return client.WithContext(ctx).Model(&Record{}).
+		Where("sandbox_id = ? AND retire_snapshot_id = ?",
+			strings.TrimSpace(sandboxID), strings.TrimSpace(snapshotID)).
+		Update("retire_last_error", truncate(reason, commitEvidenceMax)).Error
+}
+
+func ClearRetire(ctx context.Context, sandboxID, snapshotID string) error {
+	client := getDB()
+	if client == nil {
+		return ErrNotReady
+	}
+	return client.WithContext(ctx).Model(&Record{}).
+		Where("sandbox_id = ? AND retire_snapshot_id = ?",
+			strings.TrimSpace(sandboxID), strings.TrimSpace(snapshotID)).
+		Updates(map[string]any{
+			"retire_snapshot_id": "",
+			"retire_backend":     "",
+			"retire_last_error":  "",
+		}).Error
+}
+
+func BeginRollback(ctx context.Context, sandboxID, rollbackTxnID string,
+	expectedEpoch uint64) (*Record, error) {
+	client := getDB()
+	if client == nil {
+		return nil, ErrNotReady
+	}
+	sandboxID = strings.TrimSpace(sandboxID)
+	rollbackTxnID = strings.TrimSpace(rollbackTxnID)
+	if sandboxID == "" || rollbackTxnID == "" {
+		return nil, errors.New("sandboxID and rollbackTxnID are required")
+	}
+	var row Record
+	err := client.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).
+			Where("sandbox_id = ?", sandboxID).First(&row).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return ErrNotFound
+			}
+			return err
+		}
+		if row.State == StateRollingBack {
+			// A previous explicit rollback yielded no terminal result. The
+			// sandbox lifecycle lock serializes this retry; advance the epoch
+			// so late callbacks from the previous attempt are fenced.
+			res := tx.Model(&Record{}).
+				Where("sandbox_id = ? AND epoch = ? AND state = ?",
+					sandboxID, row.Epoch, StateRollingBack).
+				Updates(map[string]any{
+					"epoch":               gorm.Expr("epoch + 1"),
+					"rollback_txn_id":     rollbackTxnID,
+					"inflight_phase":      phaseRollingBack,
+					"inflight_last_error": "",
+				})
+			if res.Error != nil {
+				return res.Error
+			}
+			if res.RowsAffected != 1 {
+				return ErrCasConflict
+			}
+			return tx.Where("sandbox_id = ?", sandboxID).First(&row).Error
+		}
+		if row.State != StateFailed {
+			return fmt.Errorf("%w: state=%s", ErrNotAllowed, row.State)
+		}
+		if strings.TrimSpace(row.LastSnapshotID) == "" {
+			return fmt.Errorf("%w: no last committed snapshot", ErrNotAllowed)
+		}
+		expected := row.Epoch
+		if expectedEpoch != 0 {
+			expected = expectedEpoch
+		}
+		res := tx.Model(&Record{}).
+			Where("sandbox_id = ? AND epoch = ? AND state = ?", sandboxID, expected, StateFailed).
+			Updates(map[string]any{
+				"epoch":               gorm.Expr("epoch + 1"),
+				"state":               StateRollingBack,
+				"rollback_txn_id":     rollbackTxnID,
+				"inflight_phase":      phaseRollingBack,
+				"inflight_last_error": "",
+			})
+		if res.Error != nil {
+			return res.Error
+		}
+		if res.RowsAffected != 1 {
+			return ErrCasConflict
+		}
+		return tx.Where("sandbox_id = ?", sandboxID).First(&row).Error
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &row, nil
+}
+
+// BeginOrphanRollback fences an IDLE record when a pause binding was created
+// but the Master died before Begin could durably attach its transaction. The
+// caller must first prove the old runtime is dead and that the binding targets
+// a snapshot other than last_snapshot_id.
+func BeginOrphanRollback(ctx context.Context, sandboxID, rollbackTxnID string,
+	expectedEpoch uint64) (*Record, error) {
+	client := getDB()
+	if client == nil {
+		return nil, ErrNotReady
+	}
+	sandboxID = strings.TrimSpace(sandboxID)
+	rollbackTxnID = strings.TrimSpace(rollbackTxnID)
+	if sandboxID == "" || rollbackTxnID == "" {
+		return nil, errors.New("sandboxID and rollbackTxnID are required")
+	}
+	var row Record
+	err := client.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).
+			Where("sandbox_id = ?", sandboxID).First(&row).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return ErrNotFound
+			}
+			return err
+		}
+		if row.State != StateIDLE || strings.TrimSpace(row.InflightTxnID) != "" {
+			return fmt.Errorf("%w: orphan rollback requires IDLE without inflight, state=%s",
+				ErrNotAllowed, row.State)
+		}
+		if strings.TrimSpace(row.RetireSnapshotID) != "" {
+			return fmt.Errorf("%w: previous snapshot retirement is still pending", ErrNotAllowed)
+		}
+		if strings.TrimSpace(row.LastSnapshotID) == "" {
+			return fmt.Errorf("%w: no last committed snapshot", ErrNotAllowed)
+		}
+		expected := row.Epoch
+		if expectedEpoch != 0 {
+			expected = expectedEpoch
+		}
+		res := tx.Model(&Record{}).
+			Where("sandbox_id = ? AND epoch = ? AND state = ? AND inflight_txn_id = ''",
+				sandboxID, expected, StateIDLE).
+			Updates(map[string]any{
+				"epoch":               gorm.Expr("epoch + 1"),
+				"state":               StateRollingBack,
+				"rollback_txn_id":     rollbackTxnID,
+				"inflight_phase":      phaseRollingBack,
+				"inflight_last_error": "",
+			})
+		if res.Error != nil {
+			return res.Error
+		}
+		if res.RowsAffected != 1 {
+			return ErrCasConflict
+		}
+		return tx.Where("sandbox_id = ?", sandboxID).First(&row).Error
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &row, nil
+}
+
+func CompleteRollback(ctx context.Context, sandboxID, rollbackTxnID string, epoch uint64,
+	runtimeIncarnation string) error {
+	client := getDB()
+	if client == nil {
+		return ErrNotReady
+	}
+	res := client.WithContext(ctx).Model(&Record{}).
+		Where("sandbox_id = ? AND epoch = ? AND state = ? AND rollback_txn_id = ?",
+			strings.TrimSpace(sandboxID), epoch, StateRollingBack,
+			strings.TrimSpace(rollbackTxnID)).
+		Updates(map[string]any{
+			"epoch":                gorm.Expr("epoch + 1"),
+			"state":                StateIDLE,
+			"inflight_txn_id":      "",
+			"inflight_snapshot_id": "",
+			"inflight_phase":       phaseIdle,
+			"inflight_last_error":  "",
+			"rollback_txn_id":      "",
+			"runtime_incarnation":  strings.TrimSpace(runtimeIncarnation),
+		})
+	if res.Error != nil {
+		return res.Error
+	}
+	if res.RowsAffected != 1 {
+		return ErrCasConflict
+	}
+	return nil
+}
+
+func FailRollback(ctx context.Context, sandboxID, rollbackTxnID string, epoch uint64,
+	reason string) error {
+	client := getDB()
+	if client == nil {
+		return ErrNotReady
+	}
+	res := client.WithContext(ctx).Model(&Record{}).
+		Where("sandbox_id = ? AND epoch = ? AND state = ? AND rollback_txn_id = ?",
+			strings.TrimSpace(sandboxID), epoch, StateRollingBack,
+			strings.TrimSpace(rollbackTxnID)).
+		Updates(map[string]any{
+			"epoch":               gorm.Expr("epoch + 1"),
+			"state":               StateFailed,
+			"inflight_phase":      phaseFailed,
+			"inflight_last_error": truncate(reason, commitEvidenceMax),
+			"rollback_txn_id":     "",
+			"runtime_incarnation": "",
+		})
+	if res.Error != nil {
+		return res.Error
+	}
+	if res.RowsAffected != 1 {
+		return ErrCasConflict
+	}
+	return nil
+}
+
+func updateInflight(ctx context.Context, sandboxID, txnID string, epoch uint64,
+	fromState, toState, toPhase, reason string) error {
+	client := getDB()
+	if client == nil {
+		return ErrNotReady
+	}
+	res := client.WithContext(ctx).Model(&Record{}).
+		Where("sandbox_id = ? AND epoch = ? AND inflight_txn_id = ? AND state = ?",
+			strings.TrimSpace(sandboxID), epoch, strings.TrimSpace(txnID), fromState).
+		Updates(map[string]any{
+			"state":               toState,
+			"inflight_phase":      toPhase,
+			"inflight_last_error": reason,
+		})
+	if res.Error != nil {
+		return res.Error
+	}
+	if res.RowsAffected != 1 {
+		return ErrCasConflict
+	}
+	return nil
+}
+
+func truncate(value string, max int) string {
+	if len(value) <= max {
+		return value
+	}
+	return value[:max]
+}
+
+// TableName is exposed for diagnostics and migrations.
+func TableName() string {
+	return constants.CrashRollbackTableName
+}
