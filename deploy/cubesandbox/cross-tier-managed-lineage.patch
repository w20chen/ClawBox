     }
 
+    pub async fn crash_rollback_sandbox(
+        &self,
+        sandbox_id: &str,
+        timeout: Option<i32>,
+        snapshot_mechanism: Option<&str>,
+    ) -> AppResult<Sandbox> {
+        let mut update =
+            self.build_update_request(sandbox_id, "crash_rollback", timeout, None);
+        update.snapshot_mechanism = snapshot_mechanism.map(str::to_owned);
+        let resp = self
+            .cubemaster
+            .update_sandbox(&update)
+            .await
+            .map_err(|e| map_update_cubemaster_err(e, sandbox_id))?;
+        ensure_update_result(
+            resp.ret.ret_code,
+            resp.ret.ret_msg,
+            sandbox_id,
+            "crash rollback did not resume a sandbox",
+        )?;
+        let d = self.fetch_sandbox_detail(sandbox_id).await?;
+        let envd_version = envd_version_from_annotations(&d.annotations);
+        Ok(self.sandbox_response(
+            d.template_id,
+            sandbox_id.to_string(),
+            d.host_id,
+            envd_version,
+            None,
+        ))
+    }
