diff --git a/CubeAPI/src/handlers/sandboxes.rs b/CubeAPI/src/handlers/sandboxes.rs
index 911fbef..18e06d6 100644
--- a/CubeAPI/src/handlers/sandboxes.rs
+++ b/CubeAPI/src/handlers/sandboxes.rs
@@ -165,0 +166,49 @@ pub async fn get_sandbox(
+// GET /sandboxes/:sandboxID/ports/:containerPort
+
+#[utoipa::path(
+    get,
+    path = "/sandboxes/{sandboxID}/ports/{containerPort}",
+    params(
+        ("sandboxID" = String, Path, description = "Sandbox identifier"),
+        ("containerPort" = u16, Path, description = "Container port")
+    ),
+    responses(
+        (status = 200, description = "Resolved sandbox host-port endpoint", body = crate::models::SandboxTcpEndpoint),
+        (status = 400, description = "Invalid container port", body = ApiError),
+        (status = 404, description = "Sandbox not found", body = ApiError),
+        (status = 500, description = "Unexpected backend error", body = ApiError)
+    )
+)]
+pub async fn get_sandbox_port(
+    State(state): State<AppState>,
+    Path((sandbox_id, container_port)): Path<(String, u16)>,
+) -> AppResult<impl IntoResponse> {
+    state
+        .logger
+        .log(
+            LogEvent::new(LogLevel::Debug, "api.request")
+                .field("handler", "get_sandbox_port")
+                .field("sandbox_id", &sandbox_id)
+                .field_value("container_port", container_port),
+        )
+        .await;
+
+    let endpoint = state
+        .services
+        .sandboxes
+        .get_sandbox_port_endpoint(&sandbox_id, container_port)
+        .await?;
+
+    state
+        .logger
+        .log(
+            LogEvent::new(LogLevel::Info, "api.response")
+                .field("handler", "get_sandbox_port")
+                .field("sandbox_id", &sandbox_id)
+                .field_value("container_port", container_port)
+                .field("address", &endpoint.address),
+        )
+        .await;
+    Ok(Json(endpoint))
+}
+
