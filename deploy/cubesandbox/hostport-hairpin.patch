+/* Apply the existing exposed-port DNAT on same-node traffic before it leaves
+ * the source TAP. A redirect to the node NIC's egress path will not traverse
+ * from_world on that NIC, so relying on the physical-ingress program creates
+ * a same-node HostPort black hole.
+ */
+static __always_inline int tcp_hairpin_proxy(struct __sk_buff *skb,
+					     struct ethhdr *l2,
+					     struct iphdr *l3,
+					     struct tcphdr *l4,
+					     struct mvm_port *mvm_port)
+{
+	__u32 old_daddr, new_daddr, tcp_csum_off;
+	struct nat_session *sess;
+	struct session_key pkey = {};
+	__u16 old_dport, new_dport;
+	__u16 ip_hlen;
+	__u64 now, flags;
+	long err;
+
+	now = bpf_ktime_get_ns();
+	port_mapping_key(&pkey, l3->saddr, l4->source, mvm_port->listen_port);
+	sess = bpf_map_lookup_elem(&egress_sessions, &pkey);
+	if (sess && session_is_stale(sess)) {
+		bpf_map_delete_elem(&egress_sessions, &pkey);
+		return tcp_send_reset(skb, skb->ingress_ifindex, l3->saddr);
+	}
+	if (!sess) {
+		create_port_mapping_session(
+			l3->saddr, l4->source, mvm_port, l3->daddr, l4->dest,
+			nodenic_ifindex, now,
+			l4->syn && !l4->ack ? TCP_CONNTRACK_SYN_RECV :
+						  TCP_CONNTRACK_ESTABLISHED);
+	} else {
+		sess->access_time = now;
+	}
+
+	old_daddr = l3->daddr;
+	new_daddr = mvm_inner_ip;
+	old_dport = l4->dest;
+	new_dport = mvm_port->listen_port;
+	ip_hlen = BPF_CORE_READ_BITFIELD(l3, ihl);
+	ip_hlen <<= 2;
+	tcp_csum_off = TCP_CSUM_OFF(ip_hlen);
+	set_mac_pair(l2, cubegw0_macaddr_p1, cubegw0_macaddr_p2,
+		     mvm_macaddr_p1, mvm_macaddr_p2);
+
+	flags = BPF_F_PSEUDO_HDR | sizeof(old_daddr);
+	err = bpf_l4_csum_replace(skb, tcp_csum_off, old_daddr, new_daddr, flags);
+	if (err)
+		return TC_ACT_SHOT;
+	err = bpf_l4_csum_replace(skb, tcp_csum_off, old_dport, new_dport,
+				 sizeof(old_dport));
+	if (err)
+		return TC_ACT_SHOT;
+	err = bpf_skb_store_bytes(skb, TCP_DST_OFF(ip_hlen), &new_dport,
+				  sizeof(new_dport), 0);
+	if (err)
+		return TC_ACT_SHOT;
+	err = bpf_l3_csum_replace(skb, IP_CSUM_OFF, old_daddr, new_daddr,
+				 sizeof(old_daddr));
+	if (err)
+		return TC_ACT_SHOT;
+	err = bpf_skb_store_bytes(skb, IP_DADDR_OFF, &new_daddr,
+				  sizeof(new_daddr), 0);
+	if (err)
+		return TC_ACT_SHOT;
+	return bpf_redirect(mvm_port->ifindex, 0);
+}
