diff --git a/Cubelet/storage/peer_domain.go b/Cubelet/storage/peer_domain.go
new file mode 100644
index 0000000..cbb3bda
--- /dev/null
+++ b/Cubelet/storage/peer_domain.go
@@ -0,0 +1,407 @@
+package storage
+
+// ClawBox peer-local-SSD control plane. The Unix socket is root-only and carries
+// metadata, never network payload. Payload transfer is owned by the experiment's
+// two TCP endpoints; publication below allocates through the target CubeCow engine.
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/cubecow"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/pathutil"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/storage/cow"
+	"golang.org/x/sys/unix"
+)
+
+type peerDomain struct {
+	root   string
+	engine *cubecow.Engine
+	store  cow.Store
+}
+
+var peerDomains = map[string]*peerDomain{}
+var peerImportLocks sync.Map
+
+func initPeerDomains() error {
+	raw := strings.TrimSpace(os.Getenv("CLAWBOX_STORAGE_DOMAINS"))
+	if raw == "" {
+		return nil
+	}
+	var roots map[string]string
+	if err := json.Unmarshal([]byte(raw), &roots); err != nil {
+		return err
+	}
+	for name, root := range roots {
+		if _, err := cow.NormalizeBackend("xfs@" + name); err != nil {
+			return err
+		}
+		if !filepath.IsAbs(root) || filepath.Clean(root) == "/" {
+			return fmt.Errorf("invalid domain root %q", root)
+		}
+		root = filepath.Clean(root)
+		var stat unix.Statfs_t
+		if err := unix.Statfs(root, &stat); err != nil {
+			return fmt.Errorf("domain %s must exist on applied pool: %w", name, err)
+		}
+		if stat.Type != unix.XFS_SUPER_MAGIC {
+			return fmt.Errorf("domain %s must be XFS", name)
+		}
+		payload, _ := json.Marshal(map[string]any{"log": localStorage.config.Cow.Log.toMap(), "backend": map[string]any{"kind": "reflink", "reflink": map[string]any{"root_dir": filepath.Join(root, "objects")}}})
+		engine, err := cubecow.InitWithoutLoggingFromJSON(string(payload))
+		if err != nil {
+			return fmt.Errorf("init domain %s: %w", name, err)
+		}
+		peerDomains[name] = &peerDomain{root: root, engine: engine, store: newCowVolumeManager(engine)}
+		SetSnapshotCatalogRootsFor("xfs@"+name, filepath.Join(root, SnapshotKindNormal), filepath.Join(root, SnapshotKindPause))
+	}
+	socket := os.Getenv("CLAWBOX_PEER_CONTROL_SOCKET")
+	if !filepath.IsAbs(socket) {
+		return fmt.Errorf("CLAWBOX_PEER_CONTROL_SOCKET must be absolute")
+	}
+	if err := os.MkdirAll(filepath.Dir(socket), 0700); err != nil {
+		return err
+	}
+	if info, err := os.Lstat(socket); err == nil {
+		if info.Mode()&os.ModeSocket == 0 {
+			return fmt.Errorf("control socket path exists and is not socket")
+		}
+		conn, dialErr := net.Dial("unix", socket)
+		if dialErr == nil {
+			conn.Close()
+			return fmt.Errorf("peer control socket already active")
+		}
+		if err := os.Remove(socket); err != nil {
+			return err
+		}
+	}
+	listener, err := net.Listen("unix", socket)
+	if err != nil {
+		return err
+	}
+	if err := os.Chmod(socket, 0600); err != nil {
+		listener.Close()
+		return err
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/snapshot", peerSnapshotHandler)
+	mux.HandleFunc("/import", peerImportHandler)
+	mux.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) {
+		peerJSON(w, map[string]any{"capability": "CLAWBOX_PEER_DOMAIN_V1", "domains": roots}, nil)
+	})
+	mux.HandleFunc("/cleanup", peerCleanupHandler)
+	go http.Serve(listener, mux)
+	return nil
+}
+
+func pathUnder(root, path string) bool {
+	root, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return false
+	}
+	path, err = filepath.EvalSymlinks(path)
+	if err != nil {
+		return false
+	}
+	relative, err := filepath.Rel(root, path)
+	return err == nil && relative != ".." && !strings.HasPrefix(relative, "../")
+}
+
+func PeerPathAllowed(backend, path string) bool {
+	if domain, ok := peerDomains[strings.TrimPrefix(backend, "xfs@")]; strings.HasPrefix(backend, "xfs@") && ok {
+		return pathUnder(domain.root, path) || (os.Getenv("CLAWBOX_WARM_SNAPSHOT_ROOT") != "" && pathUnder(os.Getenv("CLAWBOX_WARM_SNAPSHOT_ROOT"), path))
+	}
+	return false
+}
+
+func PeerRuntimePath(backend, home, source string) (string, error) {
+	if source == "" {
+		return "", nil
+	}
+	data, err := os.ReadFile(filepath.Join(home, SnapshotMetadataDir, "peer-runtime.json"))
+	if err != nil {
+		return "", fmt.Errorf("domain runtime manifest missing: %w", err)
+	}
+	var paths map[string]string
+	if err = json.Unmarshal(data, &paths); err != nil {
+		return "", err
+	}
+	target := paths[source]
+	if target == "" && PeerPathAllowed(backend, source) {
+		target = source
+	}
+	if target == "" || !PeerPathAllowed(backend, target) {
+		return "", fmt.Errorf("runtime asset %s unavailable in domain %s", source, backend)
+	}
+	return target, nil
+}
+
+func peerJSON(w http.ResponseWriter, v any, err error) {
+	w.Header().Set("Content-Type", "application/json")
+	if err != nil {
+		w.WriteHeader(409)
+		json.NewEncoder(w).Encode(map[string]string{"error": err.Error()})
+		return
+	}
+	json.NewEncoder(w).Encode(v)
+}
+
+func peerSnapshotHandler(w http.ResponseWriter, r *http.Request) {
+	if r.Method != "GET" {
+		w.WriteHeader(405)
+		return
+	}
+	backend := r.URL.Query().Get("backend")
+	if backend == "" {
+		backend = "xfs"
+	}
+	if _, err := requireCowStoreFor(backend); err != nil {
+		peerJSON(w, nil, err)
+		return
+	}
+	id := r.URL.Query().Get("id")
+	if id == "" {
+		memory := r.URL.Query().Get("memory_path")
+		entries, err := ListLocalSnapshotsFor(r.Context(), backend)
+		if err != nil {
+			peerJSON(w, nil, err)
+			return
+		}
+		for _, entry := range entries {
+			if entry.MemoryVol == memory {
+				if id != "" {
+					peerJSON(w, nil, fmt.Errorf("ambiguous memory path"))
+					return
+				}
+				id = entry.SnapshotID
+			}
+		}
+	}
+	if err := pathutil.ValidateSafeID(id); err != nil {
+		peerJSON(w, nil, err)
+		return
+	}
+	value, err := ResolveLocalSnapshotFor(r.Context(), backend, id)
+	peerJSON(w, value, err)
+}
+
+type peerImportRequest struct {
+	Domain   string               `json:"storage_domain"`
+	RunID    string               `json:"run_id"`
+	Catalog  SnapshotCatalogEntry `json:"catalog"`
+	Rootfs   string               `json:"rootfs_path"`
+	Metadata string               `json:"metadata_path"`
+	Memory   string               `json:"memory_path"`
+	Runtime  map[string]string    `json:"runtime_paths"`
+}
+
+func peerImportHandler(w http.ResponseWriter, r *http.Request) {
+	if r.Method != "POST" {
+		w.WriteHeader(405)
+		return
+	}
+	var req peerImportRequest
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 8<<20)).Decode(&req); err != nil {
+		peerJSON(w, nil, err)
+		return
+	}
+	result, err := publishPeerReplica(r.Context(), req)
+	peerJSON(w, result, err)
+}
+
+func publishPeerReplica(ctx context.Context, req peerImportRequest) (*SnapshotCatalogEntryResolved, error) {
+	domain, ok := peerDomains[req.Domain]
+	if !ok {
+		return nil, fmt.Errorf("unknown target domain %q", req.Domain)
+	}
+	backend := "xfs@" + req.Domain
+	id := req.Catalog.SnapshotID
+	if err := pathutil.ValidateSafeID(id); err != nil {
+		return nil, err
+	}
+	lockValue, _ := peerImportLocks.LoadOrStore(backend+"/"+id, &sync.Mutex{})
+	lock := lockValue.(*sync.Mutex)
+	lock.Lock()
+	defer lock.Unlock()
+	if old, err := ResolveLocalSnapshotFor(ctx, backend, id); err == nil {
+		return old, nil
+	}
+	for _, path := range []string{req.Rootfs, req.Metadata, req.Memory} {
+		if path != "" && !PeerPathAllowed(backend, path) {
+			return nil, fmt.Errorf("import path %q escapes target domain", path)
+		}
+	}
+	for _, target := range req.Runtime {
+		if !PeerPathAllowed(backend, target) {
+			return nil, fmt.Errorf("runtime path escapes target domain: %s", target)
+		}
+	}
+	// Reject unresolved source filesystem paths in payload metadata before publish.
+	// The Python exporter/relocator audits all actual payload dependencies.
+	info, err := os.Stat(req.Rootfs)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("rootfs must be frozen regular file")
+	}
+	name := cowTemplateRootfsName(id)
+	dev, err := domain.engine.CreateVolume(name, uint64(info.Size()))
+	if err != nil {
+		return nil, err
+	}
+	committed := false
+	defer func() {
+		if !committed {
+			domain.engine.DeleteVolume(name)
+		}
+	}()
+	// Both files are in the target XFS. Never perform cross-filesystem reflink.
+	in, err := os.Open(req.Rootfs)
+	if err != nil {
+		return nil, err
+	}
+	defer in.Close()
+	out, err := os.OpenFile(dev, os.O_WRONLY, 0600)
+	if err != nil {
+		return nil, err
+	}
+	err = unix.IoctlFileClone(int(out.Fd()), int(in.Fd()))
+	if err == nil {
+		err = out.Sync()
+	}
+	out.Close()
+	if err != nil {
+		return nil, fmt.Errorf("target rootfs reflink: %w", err)
+	}
+	home := SnapshotHome(backend, req.Catalog.Kind, id)
+	if err = os.MkdirAll(home, 0755); err != nil {
+		return nil, err
+	}
+	// Metadata directory is a private, relocated package copy, never the CAS.
+	targetMeta := filepath.Join(home, SnapshotMetadataDir)
+	if err = os.Rename(req.Metadata, targetMeta); err != nil {
+		return nil, err
+	}
+	entry := req.Catalog
+	if req.RunID != "" {
+		entry.ClawBoxRunID = req.RunID
+	}
+	entry.Backend = backend
+	entry.SnapshotPath = home
+	entry.MetaDir = targetMeta
+	entry.RootfsVol = name
+	entry.RootfsKind = cow.KindVolume
+	entry.BuildRootfsVol = ""
+	entry.BuildRootfsKind = ""
+	entry.MetadataVol = ""
+	entry.MetadataKind = ""
+	entry.MemoryVol = req.Memory
+	entry.MemoryKind = "clawbox-direct-file"
+	if req.Memory == "" {
+		entry.MemoryKind = ""
+	}
+	runtimeJSON, _ := json.Marshal(req.Runtime)
+	if err = os.WriteFile(filepath.Join(targetMeta, "peer-runtime.json"), runtimeJSON, 0600); err != nil {
+		return nil, err
+	}
+	if err = EnsureShimSpecDirLink(home, entry.SpecDir); err != nil {
+		return nil, err
+	}
+	if err = WriteSnapshotCatalogFor(backend, &entry); err != nil {
+		return nil, err
+	}
+	committed = true
+	return ResolveLocalSnapshotFor(ctx, backend, id)
+}
+
+// Destructive cleanup is permitted only after all VMM references have ended.
+// A host-idle gate is intentionally conservative for this single-host study.
+func peerCleanupHandler(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		RunID string `json:"run_id"`
+		Apply bool   `json:"apply"`
+	}
+	if r.Method != "POST" {
+		w.WriteHeader(405)
+		return
+	}
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 4096)).Decode(&req); err != nil {
+		peerJSON(w, nil, err)
+		return
+	}
+	if req.RunID == "" {
+		peerJSON(w, nil, fmt.Errorf("run_id is required"))
+		return
+	}
+	entries := map[string][]*SnapshotCatalogEntry{}
+	for domain := range peerDomains {
+		values, err := ListLocalSnapshotsFor(r.Context(), "xfs@"+domain)
+		if err != nil {
+			peerJSON(w, nil, err)
+			return
+		}
+		for _, value := range values {
+			if value.ClawBoxRunID == req.RunID {
+				entries[domain] = append(entries[domain], value)
+			}
+		}
+	}
+	if req.Apply {
+		processes, err := os.ReadDir("/proc")
+		if err != nil {
+			peerJSON(w, nil, err)
+			return
+		}
+		for _, process := range processes {
+			body, err := os.ReadFile(filepath.Join("/proc", process.Name(), "cmdline"))
+			if err != nil {
+				continue
+			}
+			executable := filepath.Base(strings.SplitN(string(body), "\x00", 2)[0])
+			if executable == "containerd-shim-cube-rs" || executable == "cloud-hypervisor" || executable == "cube-hypervisor" {
+				peerJSON(w, nil, fmt.Errorf("VM process %s exists; abort/cleanup VMs before replica GC", process.Name()))
+				return
+			}
+		}
+		for domain, values := range entries {
+			for _, entry := range values {
+				backend := "xfs@" + domain
+				if !pathUnder(peerDomains[domain].root, entry.SnapshotPath) {
+					peerJSON(w, nil, fmt.Errorf("catalog home escapes owning domain"))
+					return
+				}
+				if err := CleanupObjectsFor(r.Context(), backend, []CowObjectRef{{Name: entry.RootfsVol, Kind: entry.RootfsKind, Role: "rootfs"}}); err != nil {
+					peerJSON(w, nil, err)
+					return
+				}
+				if entry.MemoryKind == "clawbox-direct-file" && PeerPathAllowed(backend, entry.MemoryVol) {
+					for _, suffix := range []string{"", ".lineage.json", ".metrics.json", ".zstd-pages.json"} {
+						if err := os.Remove(entry.MemoryVol + suffix); err != nil && !os.IsNotExist(err) {
+							peerJSON(w, nil, err)
+							return
+						}
+					}
+					for _, suffix := range []string{".layers", ".zstd-pages"} {
+						if err := os.RemoveAll(entry.MemoryVol + suffix); err != nil {
+							peerJSON(w, nil, err)
+							return
+						}
+					}
+				}
+				if err := os.RemoveAll(entry.SnapshotPath); err != nil {
+					peerJSON(w, nil, err)
+					return
+				}
+				DeleteSnapshotCatalogFor(backend, entry.SnapshotID)
+			}
+		}
+	}
+	peerJSON(w, map[string]any{"run_id": req.RunID, "applied": req.Apply, "catalogs": entries, "native_references_released": req.Apply}, nil)
+}
