--- /dev/null
+++ b/Cubelet/storage/peer_domain_test.go
@@ -0,0 +1,48 @@
+package storage
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// Explicit host preflight invokes the production constructor against two empty
+// task-owned XFS pools, without starting network or VM services.
+func TestPeerDomainHostPreflight(t *testing.T) {
+	roots := strings.Split(os.Getenv("CLAWBOX_PEER_PREFLIGHT_ROOTS"), ":")
+	if len(roots) != 2 || roots[0] == "" {
+		t.Skip("set CLAWBOX_PEER_PREFLIGHT_ROOTS to two owned XFS roots")
+	}
+	level, format, file, rotation := "info", "compact", filepath.Join(t.TempDir(), "cow.log"), "daily"
+	localStorage.config = &Config{Cow: CowInlineConfig{Log: CowLogConfig{Level: &level, Format: &format, File: &file, Rotation: &rotation}}}
+	domains := map[string]string{"node0": roots[0], "node1": roots[1]}
+	body, _ := json.Marshal(domains)
+	t.Setenv("CLAWBOX_STORAGE_DOMAINS", string(body))
+	t.Setenv("CLAWBOX_PEER_CONTROL_SOCKET", filepath.Join(t.TempDir(), "native.sock"))
+	if err := initPeerDomains(); err != nil {
+		t.Fatal(err)
+	}
+	for name, domain := range peerDomains {
+		volume := fmt.Sprintf("clawbox-preflight-%d-%s", os.Getpid(), name)
+		path, err := domain.engine.CreateVolume(volume, 65536)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !PeerPathAllowed("xfs@"+name, path) {
+			t.Fatalf("own volume rejected: %s", path)
+		}
+		other := "node0"
+		if name == other {
+			other = "node1"
+		}
+		if PeerPathAllowed("xfs@"+other, path) {
+			t.Fatal("foreign domain accepted")
+		}
+		if err = domain.engine.DeleteVolume(volume); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
