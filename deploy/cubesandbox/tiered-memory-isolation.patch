     pub async fn create_sandbox(&mut self) -> CResult<()> {
+        // Join LOCAL before restoring/allocating guest RAM. Moving the shim
+        // only after Create completes leaves those pages charged to Cubelet.
+        if std::env::var("CUBE_RESTORE_PRIVATE_COPY").as_deref() == Ok("1") {
+            let group = self.spec.annotations().as_ref()
+                .and_then(|annotations| annotations.get("cube.sandbox_cgroup_path"))
+                .ok_or_else(|| "missing LOCAL cgroup annotation".to_string())?;
+            let path = PathBuf::from("/sys/fs/cgroup")
+                .join(group.trim_start_matches('/')).join("cgroup.procs");
+            stdfs::write(&path, self.pid.to_string())
+                .map_err(|error| format!("enter LOCAL cgroup {}: {}", path.display(), error))?;
+            infof!(self.log, "entered LOCAL cgroup {} before guest RAM allocation", group);
+        }
         let snapshot = self.start_vm().await?;
 
