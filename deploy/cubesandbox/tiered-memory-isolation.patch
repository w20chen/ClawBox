+// Common study protocol for SSD snapshots (including block-backed snapshots).
+// WARM regular files on tmpfs must retain their pages. This deliberately does
+// not drop host-wide caches or touch unrelated files.
+fn discard_cold_snapshot_cache(file: &File) -> io::Result<()> {
+    if std::env::var("CUBE_RESTORE_PRIVATE_COPY").as_deref() != Ok("1") {
+        return Ok(());
+    }
+    let mut stat: libc::statfs = unsafe { std::mem::zeroed() };
+    if unsafe { libc::fstatfs(file.as_raw_fd(), &mut stat) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if file.metadata()?.is_file() && stat.f_type == libc::TMPFS_MAGIC {
+        return Ok(());
+    }
+    file.sync_all()?;
+    let result = unsafe { libc::posix_fadvise(file.as_raw_fd(), 0, 0, libc::POSIX_FADV_DONTNEED) };
+    if result != 0 {
+        return Err(io::Error::from_raw_os_error(result));
+    }
+    Ok(())
+}
