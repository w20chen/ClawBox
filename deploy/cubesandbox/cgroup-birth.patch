diff --git a/CubeShim/shim/src/placement_start.rs b/CubeShim/shim/src/placement_start.rs
new file mode 100644
--- /dev/null
+++ b/CubeShim/shim/src/placement_start.rs
@@ -0,0 +1,145 @@
+//! Start the existing containerd launcher in its final cgroup before any threads.
+//! Its ordinary spawn then inherits placement; no initialized VM is migrated.
+use std::ffi::CString;
+use std::fs::{self, File};
+use std::io;
+use std::os::fd::AsRawFd;
+use std::os::unix::ffi::OsStrExt;
+use std::path::{Component, Path};
+
+fn normalized_group(group: &str) -> Result<String, String> {
+    let relative = group.trim_start_matches('/');
+    if relative.is_empty()
+        || Path::new(relative)
+            .components()
+            .any(|p| !matches!(p, Component::Normal(_)))
+    {
+        return Err(format!("invalid sandbox cgroup path: {group:?}"));
+    }
+    Ok(format!("/{relative}"))
+}
+
+fn is_member(contents: &str, group: &str) -> bool {
+    contents
+        .lines()
+        .any(|line| line.strip_prefix("0::") == Some(group))
+}
+
+pub fn verify_current(group: &str) -> Result<(), String> {
+    let group = normalized_group(group)?;
+    let membership = fs::read_to_string("/proc/self/cgroup").map_err(|e| e.to_string())?;
+    if !is_member(&membership, &group) {
+        return Err(format!("shim was not born in {group}; install matching CubeShim and Cubelet placement binaries"));
+    }
+    Ok(())
+}
+
+pub fn start_in_cgroup(action: &str) -> Result<(), String> {
+    if action != "start" {
+        return Ok(());
+    }
+    let spec: serde_json::Value = serde_json::from_slice(
+        &fs::read("config.json").map_err(|e| format!("read shim bundle config: {e}"))?,
+    )
+    .map_err(|e| format!("parse shim bundle config: {e}"))?;
+    let annotations = &spec["annotations"];
+    let required = annotations.get("clawbox.numa_node").is_some()
+        || std::env::var("CUBE_RESTORE_PRIVATE_COPY").as_deref() == Ok("1")
+        || std::env::var("CLAWBOX_KVM_DIRTY_TRACKING").as_deref() == Ok("1");
+    if !required {
+        return Ok(());
+    }
+    let group = normalized_group(
+        annotations["cube.sandbox_cgroup_path"]
+            .as_str()
+            .ok_or("missing LOCAL cgroup annotation at shim start")?,
+    )?;
+    if is_member(
+        &fs::read_to_string("/proc/self/cgroup").map_err(|e| e.to_string())?,
+        &group,
+    ) {
+        return Ok(());
+    }
+    // This hook must stay before Tokio, logging workers and all other threads.
+    if fs::read_dir("/proc/self/task")
+        .map_err(|e| e.to_string())?
+        .count()
+        != 1
+    {
+        return Err("cgroup birth must run before creating shim threads".into());
+    }
+    let target = File::open(Path::new("/sys/fs/cgroup").join(group.trim_start_matches('/')))
+        .map_err(|e| format!("open target cgroup {group}: {e}"))?;
+    let executable = CString::new("/proc/self/exe").unwrap();
+    let argv = std::env::args_os()
+        .map(|s| CString::new(s.as_bytes()))
+        .collect::<Result<Vec<_>, _>>()
+        .map_err(|e| e.to_string())?;
+    let env = std::env::vars_os()
+        .map(|(key, value)| {
+            let mut entry = key.as_bytes().to_vec();
+            entry.push(b'=');
+            entry.extend_from_slice(value.as_bytes());
+            CString::new(entry)
+        })
+        .collect::<Result<Vec<_>, _>>()
+        .map_err(|e| e.to_string())?;
+    let mut argv_ptrs: Vec<_> = argv.iter().map(|s| s.as_ptr()).collect();
+    argv_ptrs.push(std::ptr::null());
+    let mut env_ptrs: Vec<_> = env.iter().map(|s| s.as_ptr()).collect();
+    env_ptrs.push(std::ptr::null());
+    let mut args: libc::clone_args = unsafe { std::mem::zeroed() };
+    args.flags = 1u64 << 33; // CLONE_INTO_CGROUP, Linux >= 5.7, cgroup v2.
+    args.exit_signal = libc::SIGCHLD as u64;
+    args.cgroup = target.as_raw_fd() as u64;
+    // No shared VM/files/thread state. Child calls only execve/_exit, using
+    // prebuilt pointers; it never runs Rust allocation or copied lock state.
+    let pid = unsafe { libc::syscall(libc::SYS_clone3, &args, std::mem::size_of_val(&args)) };
+    if pid == -1 {
+        return Err(format!("clone3(CLONE_INTO_CGROUP) for {group}: {}; require cgroup v2 and a host kernel permitting clone3 (Linux >= 5.7)", io::Error::last_os_error()));
+    }
+    if pid == 0 {
+        unsafe {
+            libc::execve(executable.as_ptr(), argv_ptrs.as_ptr(), env_ptrs.as_ptr());
+            libc::_exit(127);
+        }
+    }
+    let mut status = 0;
+    loop {
+        if unsafe { libc::waitpid(pid as i32, &mut status, 0) } != -1 {
+            break;
+        }
+        let error = io::Error::last_os_error();
+        if error.kind() != io::ErrorKind::Interrupted {
+            return Err(format!("wait for cgroup launcher: {error}"));
+        }
+    }
+    let code = if libc::WIFEXITED(status) {
+        libc::WEXITSTATUS(status)
+    } else if libc::WIFSIGNALED(status) {
+        128 + libc::WTERMSIG(status)
+    } else {
+        1
+    };
+    std::process::exit(code);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn membership_requires_exact_unified_group() {
+        assert!(is_member("0::/cube/1\n", "/cube/1"));
+        assert!(!is_member("0::/cube/11\n", "/cube/1"));
+        assert!(!is_member("2:cpuset:/cube/1\n", "/cube/1"));
+    }
+
+    #[test]
+    fn target_cannot_be_root_or_escape_cgroup_mount() {
+        for invalid in ["", "/", "../cube", "/cube/../1"] {
+            assert!(normalized_group(invalid).is_err());
+        }
+        assert_eq!(normalized_group("cube/1").unwrap(), "/cube/1");
+    }
+}
