+func alreadyInUnifiedCgroup(membership []byte, group string) bool {
+	want := "0::/" + strings.TrimLeft(group, "/")
+	for _, line := range strings.Split(string(membership), "\n") {
+		if line == want {
+			return true
+		}
+	}
+	return false
+}
+
 func AddProc(path string, pid uint64) error {
+	// CubeShim may already be born in this group. Even a same-group write
+	// invokes cpuset_post_attach and waits on unrelated migration work.
+	if membership, err := os.ReadFile(fmt.Sprintf("/proc/%d/cgroup", pid)); err == nil &&
+		alreadyInUnifiedCgroup(membership, path) {
+		return nil
+	}
 	if l.poolV1Handle == nil {
 		return fmt.Errorf("cgroup plugin not initialized")
 	}
diff --git a/Cubelet/plugins/cube/internals/cgroup/birth_test.go b/Cubelet/plugins/cube/internals/cgroup/birth_test.go
new file mode 100644
--- /dev/null
+++ b/Cubelet/plugins/cube/internals/cgroup/birth_test.go
@@ -0,0 +1,20 @@
+package cgroup
+
+import "testing"
+
+func TestAlreadyInUnifiedCgroup(t *testing.T) {
+	for _, tc := range []struct {
+		membership, group string
+		want              bool
+	}{
+		{"0::/cube/1\n", "cube/1", true},
+		{"0::/cube/1\n", "/cube/1", true},
+		{"0::/cube/11\n", "cube/1", false},
+		{"2:cpuset:/cube/1\n", "cube/1", false},
+		{"", "cube/1", false},
+	} {
+		if got := alreadyInUnifiedCgroup([]byte(tc.membership), tc.group); got != tc.want {
+			t.Fatalf("membership=%q group=%q: got %v want %v", tc.membership, tc.group, got, tc.want)
+		}
+	}
+}
