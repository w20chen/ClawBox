diff --git a/hypervisor/vmm/src/checkpoint_metrics.rs b/hypervisor/vmm/src/checkpoint_metrics.rs
new file mode 100644
index 0000000..4609b35
--- /dev/null
+++ b/hypervisor/vmm/src/checkpoint_metrics.rs
@@ -0,0 +1,33 @@
+//! Research-only checkpoint phase accounting, independent of log verbosity.
+use std::io::Write;
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+pub fn measure<T, E>(phase: &str, target: &str, bytes: Option<u64>,
+                     operation: impl FnOnce() -> Result<T, E>) -> Result<T, E> {
+    // Timing JSON is diagnostic-only. With no explicit path, bypass clocks,
+    // serialization, file opens, and writes entirely.
+    static LOG_PATH: std::sync::OnceLock<Option<String>> = std::sync::OnceLock::new();
+    let path = match LOG_PATH.get_or_init(||
+        std::env::var("CLAWBOX_CHECKPOINT_LOG").ok().filter(|value| !value.is_empty())) {
+        Some(path) => path,
+        None => return operation(),
+    };
+    let started = Instant::now();
+    let wall = SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_secs_f64();
+    let result = operation();
+    let duration = started.elapsed().as_secs_f64();
+    let row = serde_json::json!({"schema_version":1,"component":"vmm",
+        "pid":std::process::id(),"phase":phase,"target":target,
+        "started_unix_s":wall,"duration_seconds":duration,
+        "bytes_requested":bytes,"status":if result.is_ok(){"ok"}else{"error"}});
+    if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = file.write_all(format!("{}\n", row).as_bytes());
+    }
+    result
+}
+
+pub fn file_target(file: &std::fs::File) -> String {
+    use std::os::unix::io::AsRawFd;
+    std::fs::read_link(format!("/proc/self/fd/{}",file.as_raw_fd()))
+        .map(|p|p.to_string_lossy().into_owned()).unwrap_or_default()
+}

