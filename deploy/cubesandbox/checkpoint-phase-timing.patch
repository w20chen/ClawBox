diff --git a/Cubelet/services/cubebox/checkpoint_destroy_trace.go b/Cubelet/services/cubebox/checkpoint_destroy_trace.go
new file mode 100644
--- /dev/null
+++ b/Cubelet/services/cubebox/checkpoint_destroy_trace.go
@@ -0,0 +1,51 @@
+package cubebox
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/workflow"
+)
+
+type checkpointDestroyStages struct {
+	mu     sync.Mutex
+	stages map[string]checkpointDestroyStage
+}
+
+type checkpointDestroyStage struct {
+	StartedUnixSeconds float64 `json:"started_unix_s"`
+	DurationSeconds    float64 `json:"duration_seconds"`
+	Status             string  `json:"status"`
+	Error              string  `json:"error,omitempty"`
+}
+
+func checkpointDestroyContext(ctx context.Context) (context.Context, *checkpointDestroyStages) {
+	stages := &checkpointDestroyStages{stages: make(map[string]checkpointDestroyStage)}
+	return workflow.WithDestroyStageRecorder(ctx, stages.record), stages
+}
+
+func (s *checkpointDestroyStages) record(stage string, start time.Time, err error) {
+	row := checkpointDestroyStage{StartedUnixSeconds: float64(start.UnixNano()) / 1e9,
+		DurationSeconds: time.Since(start).Seconds(), Status: "ok"}
+	if err != nil {
+		row.Status, row.Error = "error", err.Error()
+	}
+	s.mu.Lock()
+	s.stages[stage] = row
+	s.mu.Unlock()
+}
+
+func checkpointDestroyDetails(stages *checkpointDestroyStages, err error) map[string]interface{} {
+	stages.mu.Lock()
+	snapshot := make(map[string]checkpointDestroyStage, len(stages.stages))
+	for name, row := range stages.stages {
+		snapshot[name] = row
+	}
+	stages.mu.Unlock()
+	fields := map[string]interface{}{"stages": snapshot}
+	if err != nil {
+		fields["error"] = err.Error()
+	}
+	return fields
+}

diff --git a/Cubelet/services/cubebox/checkpoint_destroy_trace_test.go b/Cubelet/services/cubebox/checkpoint_destroy_trace_test.go
