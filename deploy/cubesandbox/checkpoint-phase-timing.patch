+++ b/Cubelet/services/cubebox/checkpoint_destroy_trace_test.go
@@ -0,0 +1,46 @@
+package cubebox
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/tencentcloud/CubeSandbox/Cubelet/plugins/workflow"
+)
+
+func TestCheckpointDestroyConcurrentStages(t *testing.T) {
+	ctx, stages := checkpointDestroyContext(context.Background())
+	cause := errors.New("Delete deadline exceeded")
+	var group sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		group.Add(1)
+		go func(i int) {
+			defer group.Done()
+			workflow.BeginDestroyStage(ctx, fmt.Sprintf("workflow.%d", i))(cause)
+		}(i)
+	}
+	group.Wait()
+	fields := checkpointDestroyDetails(stages, cause)
+	rows := fields["stages"].(map[string]checkpointDestroyStage)
+	if len(rows) != 16 || fields["error"] != cause.Error() {
+		t.Fatalf("incomplete details: %#v", fields)
+	}
+	for _, row := range rows {
+		if row.Status != "error" || row.Error != cause.Error() || row.StartedUnixSeconds <= 0 || row.DurationSeconds < 0 {
+			t.Fatalf("invalid stage: %#v", row)
+		}
+	}
+	if _, err := json.Marshal(fields); err != nil {
+		t.Fatal(err)
+	}
+	workflow.BeginDestroyStage(ctx, "later")(nil)
+	if len(rows) != 16 {
+		t.Fatal("details mutated after snapshot")
+	}
+	if _, exists := checkpointDestroyDetails(stages, nil)["error"]; exists {
+		t.Fatal("success has an error")
+	}
+}

