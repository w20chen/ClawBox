+package workflow
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestDestroyStageRecorderOptional(t *testing.T) {
+	BeginDestroyStage(context.Background(), "disabled")(errors.New("unchanged"))
+	BeginDestroyStage(WithDestroyStageRecorder(context.Background(), nil), "nil")(nil)
+	if allocations := testing.AllocsPerRun(100, func() {
+		BeginDestroyStage(context.Background(), "disabled")(nil)
+	}); allocations != 0 {
+		t.Fatalf("disabled tracing allocated: %v", allocations)
+	}
+}
+
+func TestDestroyStageRecorderPreservesError(t *testing.T) {
+	cause := errors.New("task Delete failed")
+	calls := 0
+	ctx := WithDestroyStageRecorder(context.Background(), func(stage string, start time.Time, err error) {
+		calls++
+		if stage != "task_delete" || start.IsZero() || err != cause {
+			t.Fatalf("unexpected stage %q start %v error %v", stage, start, err)
+		}
+	})
+	BeginDestroyStage(ctx, "task_delete")(cause)
+	if calls != 1 {
+		t.Fatalf("calls=%d", calls)
+	}
+}

