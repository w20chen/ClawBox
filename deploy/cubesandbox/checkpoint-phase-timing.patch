new file mode 100644
--- /dev/null
+++ b/Cubelet/plugins/workflow/destroy_trace.go
@@ -0,0 +1,26 @@
+package workflow
+
+import (
+	"context"
+	"time"
+)
+
+type destroyStageRecorderKey struct{}
+type DestroyStageRecorder func(stage string, start time.Time, err error)
+
+// WithDestroyStageRecorder enables in-memory phase accounting for one pause.
+// Ordinary workflows do not install a recorder or perform timing/file writes.
+func WithDestroyStageRecorder(ctx context.Context, recorder DestroyStageRecorder) context.Context {
+	return context.WithValue(ctx, destroyStageRecorderKey{}, recorder)
+}
+
+func ignoreDestroyStage(error) {}
+
+func BeginDestroyStage(ctx context.Context, stage string) func(error) {
+	recorder, _ := ctx.Value(destroyStageRecorderKey{}).(DestroyStageRecorder)
+	if recorder == nil {
+		return ignoreDestroyStage
+	}
+	start := time.Now()
+	return func(err error) { recorder(stage, start, err) }
+}

