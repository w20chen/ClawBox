+// Keep research timing independent of the deployment's WARN/ERROR log filter.
+func writeCheckpointPhase(start time.Time, phase, sandboxID, requestID, snapshotID string, ok bool) {
+	duration := time.Since(start).Seconds()
+	status := "ok"
+	if !ok {
+		status = "error"
+	}
+	row := map[string]interface{}{"schema_version": 1, "component": "cubelet", "pid": os.Getpid(),
+		"phase": phase, "sandbox_id": sandboxID, "request_id": requestID, "snapshot_id": snapshotID,
+		"started_unix_s": float64(start.UnixNano()) / 1e9, "duration_seconds": duration, "status": status}
+	data, err := json.Marshal(row)
+	if err != nil {
+		return
+	}
+	path := os.Getenv("CLAWBOX_CHECKPOINT_LOG")
+	if path == "" {
+		path = "/data/log/clawbox-checkpoint-phases.jsonl"
+	}
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0644)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	_, _ = f.Write(append(data, '\n'))
+}
