+// Internal client uses the existing authenticated-by-Unix-permissions shim socket.
+// Keeping it in the shim binary avoids an independently installed helper.
+fn handle_numa_control() -> Result<(), Box<dyn std::error::Error>> {
+    use containerd_shim_protos::{api::UpdateTaskRequest, shim_async::{Client, TaskClient}, ttrpc};
+    let args: Vec<String> = std::env::args().skip(2).collect();
+    if args.len() != 3 || !matches!(args[2].as_str(), "prepare" | "finish") {
+        return Err("usage: --clawbox-numa-control SOCKET SANDBOX_ID prepare|finish".into());
+    }
+    Builder::new_current_thread().enable_all().build()?.block_on(async {
+        let client = TaskClient::new(Client::connect(&args[0])?);
+        let mut request = UpdateTaskRequest::new();
+        request.id = args[1].clone();
+        request.annotations.insert("cube.shimapi.update.action".into(),
+            if args[2] == "prepare" { "ClawboxPrepareNuma" } else { "ClawboxFinishNuma" }.into());
+        client.update(ttrpc::context::with_timeout(30_000_000_000), &request).await?;
+        Ok(())
+    })
