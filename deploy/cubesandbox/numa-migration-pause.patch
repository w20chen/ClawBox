+    /// Drop KVM's populated stage-2 mappings once before host NUMA migration.
+    /// Preserve RAM, slot identities, and dirty bits consumed by incremental snapshots.
+    /// The caller must pause both vCPUs and devices throughout this operation.
+    pub fn reset_ram_mappings(&mut self) -> Result<(), Error> {
+        // Read-only device images (notably cube-agent.ext4) are shared by
+        // hundreds of VMs. Whole-process NUMA migration would move their page
+        // cache and invalidate every VM mapping the same pages. Drop only this
+        // VM's read-only file PTEs; the backing data stays intact and is faulted
+        // back from the same shared cache after resume. Writable guest RAM and
+        // private CoW state are not discarded.
+        for region in self.device_memory.memory().iter() {
+            if region.prot() & libc::PROT_WRITE == 0 && region.file_offset().is_some() {
+                let result = unsafe {
+                    libc::madvise(region.as_ptr() as *mut libc::c_void,
+                        region.len() as usize, libc::MADV_DONTNEED)
+                };
+                if result != 0 {
+                    return Err(Error::Dirtylog(MigratableError::MigrateSend(
+                        anyhow!("Release read-only device mappings before NUMA migration: {}",
+                            io::Error::last_os_error()))));
+                }
+            }
+        }
+        let memory = self.guest_memory.memory();
+        for mapping in &self.guest_ram_mappings {
+            let region = memory.find_region(GuestAddress(mapping.gpa))
+                .ok_or_else(|| Error::Dirtylog(MigratableError::MigrateSend(
+                    anyhow!("NUMA migration RAM region missing"))))?;
+            if region.start_addr().raw_value() != mapping.gpa || region.len() != mapping.size {
+                return Err(Error::Dirtylog(MigratableError::MigrateSend(
+                    anyhow!("NUMA migration RAM range mismatch"))));
+            }
+            if self.dirty_log {
+                let bitmap = self.vm.get_dirty_log(mapping.slot, mapping.gpa, mapping.size)
+                    .map_err(|e| Error::Dirtylog(MigratableError::MigrateSend(
+                        anyhow!("NUMA migration dirty log: {}", e))))?;
+                for (word, bits) in bitmap.iter().enumerate() {
+                    let mut remaining = *bits;
+                    while remaining != 0 {
+                        let bit = remaining.trailing_zeros() as usize;
+                        let offset = (word * 64 + bit) * host_page_size() as usize;
+                        if offset < mapping.size as usize {
+                            region.bitmap().mark_dirty(offset, host_page_size() as usize);
+                        }
+                        remaining &= remaining - 1;
+                    }
+                }
+            }
+            let make_region = || self.vm.make_user_memory_region(
+                mapping.slot, mapping.gpa, mapping.size, region.as_ptr() as u64,
+                false, self.log_dirty);
+            self.vm.remove_user_memory_region(make_region())
+                .map_err(Error::RemoveUserMemoryRegion)?;
+        }
+        Ok(())
+    }
+
+    /// Restore the same slots after migration, before resuming guest execution.
+    pub fn restore_ram_mappings(&mut self) -> Result<(), Error> {
+        let memory = self.guest_memory.memory();
+        for mapping in &self.guest_ram_mappings {
+            let region = memory.find_region(GuestAddress(mapping.gpa))
+                .ok_or_else(|| Error::Dirtylog(MigratableError::MigrateSend(
+                    anyhow!("NUMA migration RAM region missing on restore"))))?;
+            let mem_region = self.vm.make_user_memory_region(
+                mapping.slot, mapping.gpa, mapping.size, region.as_ptr() as u64,
+                false, self.log_dirty);
+            self.vm.create_user_memory_region(mem_region)
+                .map_err(Error::CreateUserMemoryRegion)?;
+        }
+        if self.dirty_log {
+            // Use the hypervisor method directly: MemoryManager::start_dirty_log
+            // also clears the VMM bitmap that now holds the saved dirty bits.
+            self.vm.start_dirty_log().map_err(|e| Error::Dirtylog(
+                MigratableError::MigrateSend(anyhow!("Restore dirty tracking: {}", e))))?;
+        }
+        Ok(())
