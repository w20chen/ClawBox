diff --git a/Cubelet/services/cubebox/incremental_memory_reclaim.go b/Cubelet/services/cubebox/incremental_memory_reclaim.go
new file mode 100644
index 0000000..5144552
--- /dev/null
+++ b/Cubelet/services/cubebox/incremental_memory_reclaim.go
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package cubebox
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+type reclaimMemoryRange struct {
+	GPA    uint64 `json:"gpa"`
+	Offset uint64 `json:"offset"`
+	Length uint64 `json:"length"`
+}
+
+type reclaimMemoryLayer struct {
+	Name         string               `json:"name"`
+	Ranges       []reclaimMemoryRange `json:"ranges"`
+	ExternalPath *string              `json:"external_path,omitempty"`
+}
+
+type reclaimMemoryLineage struct {
+	SchemaVersion         uint32               `json:"schema_version"`
+	LogicalBytes          uint64               `json:"logical_bytes"`
+	AllocatedBytes        uint64               `json:"allocated_bytes"`
+	DirtyBytes            *uint64              `json:"dirty_bytes"`
+	TransferredBytes      uint64               `json:"transferred_bytes"`
+	EffectivePrivateBytes uint64               `json:"effective_private_bytes"`
+	ReclaimedBytes        uint64               `json:"reclaimed_bytes"`
+	ReclaimSkippedBytes   uint64               `json:"reclaim_skipped_bytes,omitempty"`
+	FullBase              bool                 `json:"full_base"`
+	Layers                []reclaimMemoryLayer `json:"layers"`
+}
+
+type memoryReclaimStats struct {
+	AllocatedBefore uint64
+	AllocatedAfter  uint64
+	ReclaimedBytes  uint64
+	SkippedBytes    uint64
+	PunchedRanges   int
+}
+
+func reclaimHoles(ranges []reclaimMemoryRange, logical uint64) ([]reclaimMemoryRange, error) {
+	ordered := append([]reclaimMemoryRange(nil), ranges...)
+	sort.Slice(ordered, func(i, j int) bool { return ordered[i].Offset < ordered[j].Offset })
+	var holes []reclaimMemoryRange
+	var cursor uint64
+	for _, current := range ordered {
+		end := current.Offset + current.Length
+		if current.Length == 0 || end < current.Offset || end > logical || current.Offset < cursor {
+			return nil, fmt.Errorf("invalid retained RAM range offset=%d length=%d", current.Offset, current.Length)
+		}
+		if current.Offset > cursor {
+			holes = append(holes, reclaimMemoryRange{Offset: cursor, Length: current.Offset - cursor})
+		}
+		cursor = end
+	}
+	if cursor < logical {
+		holes = append(holes, reclaimMemoryRange{Offset: cursor, Length: logical - cursor})
+	}
+	return holes, nil
+}
+
+// reclaimSupersededMemory runs only after the previous pause snapshot has
+// been successfully removed and the resumed VM has been destroyed. An owned
+// layer must also have exactly one link; otherwise it is left untouched.
+func reclaimSupersededMemory(memoryPath string) (memoryReclaimStats, error) {
+	var stats memoryReclaimStats
+	sidecar := memoryPath + ".lineage.json"
+	raw, err := os.ReadFile(sidecar)
+	if err != nil {
+		return stats, err
+	}
+	var lineage reclaimMemoryLineage
+	if err := json.Unmarshal(raw, &lineage); err != nil {
+		return stats, fmt.Errorf("decode RAM lineage: %w", err)
+	}
+	if lineage.SchemaVersion != 1 || lineage.LogicalBytes == 0 || len(lineage.Layers) == 0 {
+		return stats, fmt.Errorf("invalid RAM lineage schema or layout")
+	}
+
+	var current unix.Stat_t
+	if err := unix.Stat(memoryPath, &current); err != nil {
+		return stats, fmt.Errorf("stat current RAM snapshot: %w", err)
+	}
+	lineage.AllocatedBytes = 0
+	lineage.EffectivePrivateBytes = 0
+	lineage.ReclaimSkippedBytes = 0
+	for index, layer := range lineage.Layers {
+		if layer.Name != fmt.Sprintf("%06d.mem", index) || strings.ContainsAny(layer.Name, `/\\`) {
+			return stats, fmt.Errorf("invalid RAM layer name %q", layer.Name)
+		}
+		if layer.ExternalPath != nil {
+			continue
+		}
+		for _, retained := range layer.Ranges {
+			lineage.EffectivePrivateBytes += retained.Length
+		}
+		layerPath := filepath.Join(memoryPath+".layers", layer.Name)
+		file, err := os.OpenFile(layerPath, os.O_RDWR, 0)
+		if err != nil {
+			return stats, fmt.Errorf("open RAM layer %s: %w", layer.Name, err)
+		}
+		var before unix.Stat_t
+		if err := unix.Fstat(int(file.Fd()), &before); err != nil {
+			file.Close()
+			return stats, fmt.Errorf("stat RAM layer %s: %w", layer.Name, err)
+		}
+		beforeBytes := uint64(before.Blocks) * 512
+		stats.AllocatedBefore += beforeBytes
+		holes, err := reclaimHoles(layer.Ranges, lineage.LogicalBytes)
+		if err != nil {
+			file.Close()
+			return stats, fmt.Errorf("RAM layer %s: %w", layer.Name, err)
+		}
+		isCurrentWriteFile := before.Dev == current.Dev && before.Ino == current.Ino
+		if !isCurrentWriteFile && before.Nlink == 1 {
+			for _, hole := range holes {
+				if hole.Offset > uint64(^uint64(0)>>1) || hole.Length > uint64(^uint64(0)>>1) {
+					file.Close()
+					return stats, fmt.Errorf("RAM reclaim range exceeds int64")
+				}
+				if err := unix.Fallocate(int(file.Fd()), unix.FALLOC_FL_PUNCH_HOLE|unix.FALLOC_FL_KEEP_SIZE,
+					int64(hole.Offset), int64(hole.Length)); err != nil {
+					file.Close()
+					return stats, fmt.Errorf("punch RAM layer %s offset=%d length=%d: %w",
+						layer.Name, hole.Offset, hole.Length, err)
+				}
+				stats.PunchedRanges++
+			}
+			if err := file.Sync(); err != nil {
+				file.Close()
+				return stats, fmt.Errorf("sync reclaimed RAM layer %s: %w", layer.Name, err)
+			}
+		} else if !isCurrentWriteFile && len(holes) != 0 {
+			for _, hole := range holes {
+				lineage.ReclaimSkippedBytes += hole.Length
+			}
+		}
+		var after unix.Stat_t
+		if err := unix.Fstat(int(file.Fd()), &after); err != nil {
+			file.Close()
+			return stats, fmt.Errorf("restat RAM layer %s: %w", layer.Name, err)
+		}
+		if err := file.Close(); err != nil {
+			return stats, err
+		}
+		afterBytes := uint64(after.Blocks) * 512
+		stats.AllocatedAfter += afterBytes
+		lineage.AllocatedBytes += afterBytes
+		if beforeBytes > afterBytes {
+			stats.ReclaimedBytes += beforeBytes - afterBytes
+		}
+	}
+	lineage.ReclaimedBytes += stats.ReclaimedBytes
+	stats.SkippedBytes = lineage.ReclaimSkippedBytes
+
+	updated, err := json.Marshal(&lineage)
+	if err != nil {
+		return stats, err
+	}
+	directory := filepath.Dir(sidecar)
+	temporary, err := os.CreateTemp(directory, filepath.Base(sidecar)+".reclaim-*")
+	if err != nil {
+		return stats, err
+	}
+	temporaryName := temporary.Name()
+	defer os.Remove(temporaryName)
+	if err = temporary.Chmod(0600); err == nil {
+		_, err = temporary.Write(updated)
+	}
+	if err == nil {
+		err = temporary.Sync()
+	}
+	closeErr := temporary.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = os.Rename(temporaryName, sidecar)
+	}
+	if err != nil {
+		return stats, fmt.Errorf("commit reclaimed RAM accounting: %w", err)
+	}
+	if dir, openErr := os.Open(directory); openErr == nil {
+		err = dir.Sync()
+		_ = dir.Close()
+		if err != nil {
+			return stats, fmt.Errorf("sync reclaimed RAM accounting: %w", err)
+		}
+	}
+	return stats, nil
+}
diff --git a/Cubelet/services/cubebox/incremental_memory_reclaim_test.go b/Cubelet/services/cubebox/incremental_memory_reclaim_test.go
new file mode 100644
index 0000000..1a98631
--- /dev/null
+++ b/Cubelet/services/cubebox/incremental_memory_reclaim_test.go
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package cubebox
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func writeReclaimFixture(t *testing.T, shared bool) (string, string, uint64) {
+	t.Helper()
+	directory := t.TempDir()
+	memoryPath := filepath.Join(directory, "memory.mem")
+	layers := memoryPath + ".layers"
+	if err := os.Mkdir(layers, 0700); err != nil {
+		t.Fatal(err)
+	}
+	page := uint64(os.Getpagesize())
+	old := filepath.Join(layers, "000000.mem")
+	if err := os.WriteFile(old, make([]byte, 3*page), 0600); err != nil {
+		t.Fatal(err)
+	}
+	file, err := os.OpenFile(old, os.O_WRONLY, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for offset := uint64(0); offset < 3*page; offset += page {
+		if _, err := file.WriteAt([]byte{0x5a}, int64(offset)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	file.Close()
+	current := filepath.Join(layers, "000001.mem")
+	if err := os.WriteFile(memoryPath, make([]byte, 3*page), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Link(memoryPath, current); err != nil {
+		t.Fatal(err)
+	}
+	if shared {
+		if err := os.Link(old, filepath.Join(directory, "reader.mem")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	lineage := reclaimMemoryLineage{
+		SchemaVersion: 1, LogicalBytes: 3 * page,
+		Layers: []reclaimMemoryLayer{
+			{Name: "000000.mem", Ranges: []reclaimMemoryRange{
+				{Offset: 0, Length: page}, {Offset: 2 * page, Length: page},
+			}},
+			{Name: "000001.mem", Ranges: []reclaimMemoryRange{{Offset: page, Length: page}}},
+		},
+	}
+	raw, _ := json.Marshal(&lineage)
+	if err := os.WriteFile(memoryPath+".lineage.json", raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return memoryPath, old, page
+}
+
+func TestReclaimSupersededMemoryPunchesOnlyUnsharedInheritedPages(t *testing.T) {
+	memoryPath, old, page := writeReclaimFixture(t, false)
+	stats, err := reclaimSupersededMemory(memoryPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stats.PunchedRanges != 1 || stats.ReclaimedBytes < page || stats.SkippedBytes != 0 {
+		t.Fatalf("unexpected reclaim stats: %+v", stats)
+	}
+	content, err := os.ReadFile(old)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if content[0] != 0x5a || content[page] != 0 || content[2*page] != 0x5a {
+		t.Fatalf("retained and reclaimed contents do not match")
+	}
+}
+
+func TestReclaimSupersededMemoryPreservesSharedReader(t *testing.T) {
+	memoryPath, old, page := writeReclaimFixture(t, true)
+	stats, err := reclaimSupersededMemory(memoryPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stats.PunchedRanges != 0 || stats.ReclaimedBytes != 0 || stats.SkippedBytes != page {
+		t.Fatalf("unexpected shared-layer stats: %+v", stats)
+	}
+	content, err := os.ReadFile(old)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if content[page] != 0x5a {
+		t.Fatalf("shared reader content was reclaimed")
+	}
+}
