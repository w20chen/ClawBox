+fn range_end(range: &Range) -> io::Result<u64> {
+    range.offset.checked_add(range.length)
+        .ok_or_else(|| invalid("RAM range overflow"))
+}
+
+fn normalize_ranges(mut ranges: Vec<Range>) -> io::Result<Vec<Range>> {
