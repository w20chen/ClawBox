+        let directory = Directory::new();
+        let base = directory.0.join("base.mem");
+        let child_path = directory.0.join("child.mem");
+        let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as u64;
+        let layout = vec![Range { gpa: 0x40000000, offset: 0, length: 5 * page }];
+        fs::write(&base, vec![0x5a; (5 * page) as usize]).unwrap();
+        Lineage::inherit(&base, None, 5 * page, &layout).unwrap()
+            .publish(&base, layout.clone(), false).unwrap();
+        let parent = Lineage::load(&base, &layout, page).unwrap().unwrap();
+        let replacements = vec![
+            Range { gpa: 0x40000000, offset: 0, length: page },
+            Range { gpa: 0x40000000 + 2 * page, offset: 2 * page, length: 2 * page },
+        ];
+        let inherited = Lineage::inherit(
+            &child_path, Some((&base, &parent)), 5 * page, &replacements).unwrap();
+        assert_eq!(inherited.layers.len(), 1);
+        assert_eq!(inherited.layers[0].ranges, vec![
+            Range { gpa: 0x40000000 + page, offset: page, length: page },
+            Range { gpa: 0x40000000 + 4 * page, offset: 4 * page, length: page },
+        ]);
+        let file = File::create(&child_path).unwrap();
+        file.set_len(5 * page).unwrap();
+        inherited.publish(&child_path, replacements, false).unwrap();
+        let child = Lineage::load(&child_path, &layout, page).unwrap().unwrap();
+        assert_eq!(child.layers.len(), 2);
+        assert_eq!(child.effective_private_bytes, 5 * page);
+        assert_eq!(child.layers.iter().flat_map(|layer| layer.ranges.iter())
+            .map(|range| range.length).sum::<u64>(), 5 * page);
+    }
