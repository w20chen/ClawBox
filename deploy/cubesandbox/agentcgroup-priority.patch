diff --git a/Cubelet/pkg/clawboxplacement/placement.go b/Cubelet/pkg/clawboxplacement/placement.go
new file mode 100644
index 0000000..81301f4
--- /dev/null
+++ b/Cubelet/pkg/clawboxplacement/placement.go
@@ -0,0 +1,153 @@
+// Copyright (c) 2026 ClawBox contributors.
+// SPDX-License-Identifier: Apache-2.0
+// Package clawboxplacement carries only optimization intent into CubeSandbox.
+// CubeSandbox continues to allocate and own the sandbox cgroup.
+package clawboxplacement
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"syscall"
+
+	cubebox "github.com/tencentcloud/CubeSandbox/Cubelet/api/services/cubebox/v1"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/constants"
+)
+
+const registry = "/run/clawbox/cgroups"
+
+var (
+	tokenPattern = regexp.MustCompile(`^[0-9a-f]{32}$`)
+	groupPattern = regexp.MustCompile(`^/cube_sandbox/sandbox/[0-9]+$`)
+)
+
+type Placement struct {
+	Token    string  `json:"-"`
+	NumaNode int32   `json:"numa_node"`
+	Path     *string `json:"path,omitempty"`
+}
+
+func requestToken(req *cubebox.RunCubeSandboxRequest) (string, error) {
+	token := ""
+	if raw := req.GetAnnotations()[constants.MasterAnnotationCreateTimeEnvVars]; raw != "" {
+		var envs map[string]string
+		if err := json.Unmarshal([]byte(raw), &envs); err != nil {
+			return "", fmt.Errorf("invalid create-time environment: %w", err)
+		}
+		if value, exists := envs["CLAWBOX_CGROUP_TOKEN"]; exists {
+			if !tokenPattern.MatchString(value) {
+				return "", fmt.Errorf("invalid ClawBox placement capability")
+			}
+			token = value
+		}
+	}
+	for _, container := range req.GetContainers() {
+		for _, env := range container.GetEnvs() {
+			if env.GetKey() != "CLAWBOX_CGROUP_TOKEN" {
+				continue
+			}
+			value := env.GetValue()
+			if !tokenPattern.MatchString(value) || (token != "" && token != value) {
+				return "", fmt.Errorf("invalid or conflicting ClawBox placement capability")
+			}
+			token = value
+		}
+	}
+	return token, nil
+}
+
+func checkOwned(path string) error {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return err
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != 0 || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0077 != 0 {
+		return fmt.Errorf("unsafe ClawBox placement registry: %s", path)
+	}
+	return nil
+}
+
+func read(token string) (*Placement, error) {
+	if !tokenPattern.MatchString(token) {
+		return nil, fmt.Errorf("invalid ClawBox placement capability")
+	}
+	file := filepath.Join(registry, token)
+	for _, path := range []string{filepath.Dir(registry), registry, file} {
+		if err := checkOwned(path); err != nil {
+			return nil, err
+		}
+	}
+	data, err := os.ReadFile(file)
+	if err != nil {
+		return nil, err
+	}
+	var placement struct {
+		NumaNode *int32  `json:"numa_node"`
+		Path     *string `json:"path,omitempty"`
+	}
+	if err := json.Unmarshal(data, &placement); err != nil {
+		return nil, err
+	}
+	if placement.NumaNode == nil || *placement.NumaNode < 0 {
+		return nil, fmt.Errorf("ClawBox placement requires a non-negative NUMA node")
+	}
+	if placement.Path != nil && *placement.Path != "" {
+		return nil, fmt.Errorf("ClawBox placement capability is already assigned")
+	}
+	return &Placement{Token: token, NumaNode: *placement.NumaNode}, nil
+}
+
+func FromRequest(req *cubebox.RunCubeSandboxRequest) (*Placement, error) {
+	token, err := requestToken(req)
+	if err != nil || token == "" {
+		return nil, err
+	}
+	return read(token)
+}
+
+func Publish(placement *Placement, group string) error {
+	if placement == nil {
+		return nil
+	}
+	if !groupPattern.MatchString(group) || group != filepath.Clean(group) {
+		return fmt.Errorf("CubeSandbox assigned an invalid cgroup path: %s", group)
+	}
+	current, err := read(placement.Token)
+	if err != nil {
+		return err
+	}
+	if current.NumaNode != placement.NumaNode {
+		return fmt.Errorf("ClawBox placement changed while assigning the sandbox")
+	}
+	current.Path = &group
+	tmp := filepath.Join(registry, "."+placement.Token+fmt.Sprintf(".%d", os.Getpid()))
+	file, err := os.OpenFile(tmp, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return err
+	}
+	remove := true
+	defer func() {
+		_ = file.Close()
+		if remove {
+			_ = os.Remove(tmp)
+		}
+	}()
+	encoder := json.NewEncoder(file)
+	if err := encoder.Encode(current); err != nil {
+		return err
+	}
+	if err := file.Sync(); err != nil {
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(tmp, filepath.Join(registry, placement.Token)); err != nil {
+		return err
+	}
+	remove = false
+	return nil
+}
diff --git a/Cubelet/pkg/clawboxplacement/placement_test.go b/Cubelet/pkg/clawboxplacement/placement_test.go
