 	}
+	// ClawBox may temporarily narrow a normal CubeSandbox leaf while a VM
+	// borrows shared NUMA memory. The native pool owns reuse, so return only its
+	// ordinary flat pool to inherited cpus/mems after all processes have left.
+	if h.baseGroup == handle.DefaultPathPoolV1 {
+		for _, name := range []string{"cpuset.cpus", "cpuset.mems"} {
+			file := path.Join(h.root, group, name)
+			value, readErr := os.ReadFile(file)
+			if readErr != nil {
+				if errors.Is(readErr, os.ErrNotExist) {
+					continue
+				}
+				return readErr
+			}
+			if strings.TrimSpace(string(value)) != "" {
+				if writeErr := os.WriteFile(file, []byte("\n"), 0644); writeErr != nil {
+					return fmt.Errorf("reset %s for cgroup reuse: %w", name, writeErr)
+				}
+			}
+		}
+	}
 	return nil
 }
 
