 const ANNO_SANDBOX_DNS: &str = "cube.sandbox.dns";
 const ANNO_ENABLE_IVSHMEM: &str = "cube.master.enable_ivshmem";
+const ANNO_CLAWBOX_NUMA_NODE: &str = "clawbox.numa_node";
 const IVSHMEM_DEFAULT_SIZE: usize = 1 * 1024 * 1024; // 1MB
 
+fn parse_cpu_list(raw: &str) -> CResult<Vec<usize>> {
+    let mut cpus = Vec::new();
+    for item in raw.trim().split(',').filter(|item| !item.is_empty()) {
+        let (first, last) = match item.split_once('-') {
+            Some((first, last)) => (
+                first
+                    .parse::<usize>()
+                    .map_err(|e| format!("invalid CPU list {raw}: {e}"))?,
+                last.parse::<usize>()
+                    .map_err(|e| format!("invalid CPU list {raw}: {e}"))?,
+            ),
+            None => {
+                let cpu = item
+                    .parse::<usize>()
+                    .map_err(|e| format!("invalid CPU list {raw}: {e}"))?;
+                (cpu, cpu)
+            }
+        };
+        if first > last || last >= libc::CPU_SETSIZE as usize {
+            return Err(format!("invalid CPU range in {raw}"));
+        }
+        cpus.extend(first..=last);
+    }
+    if cpus.is_empty() {
+        return Err("NUMA node has an empty CPU list".to_string());
+    }
+    Ok(cpus)
+}
+
+fn apply_clawbox_cpu_affinity(node: u32) -> CResult<()> {
+    let cpulist_path = format!("/sys/devices/system/node/node{node}/cpulist");
+    let cpulist =
+        stdfs::read_to_string(&cpulist_path).map_err(|e| format!("read {cpulist_path}: {e}"))?;
+    let cpus = parse_cpu_list(&cpulist)?;
+    let mut set: libc::cpu_set_t = unsafe { std::mem::zeroed() };
+    unsafe {
+        libc::CPU_ZERO(&mut set);
+        for cpu in cpus {
+            libc::CPU_SET(cpu, &mut set);
+        }
+        if libc::sched_setaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), &set) != 0 {
+            return Err(format!(
+                "set NUMA-node CPU affinity: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+    }
+    Ok(())
+}
+
