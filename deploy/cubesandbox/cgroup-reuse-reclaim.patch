+func (h *handler) reclaimFileCache(group string) error {
+	groupPath := path.Join(h.root, group)
+	raw, err := os.ReadFile(path.Join(groupPath, "memory.stat"))
+	if err != nil {
+		return fmt.Errorf("read memory.stat for reusable cgroup %q: %w", group, err)
+	}
+	var fileBytes uint64
+	var shmemBytes uint64
+	for _, line := range strings.Split(string(raw), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) != 2 || (fields[0] != "file" && fields[0] != "shmem") {
+			continue
+		}
+		value, parseErr := strconv.ParseUint(fields[1], 10, 64)
+		if parseErr != nil {
+			return fmt.Errorf("parse %s for reusable cgroup %q: %w", fields[0], group, parseErr)
+		}
+		if fields[0] == "file" {
+			fileBytes = value
+		} else {
+			shmemBytes = value
+		}
+	}
+	if fileBytes <= shmemBytes {
+		return nil
+	}
+	reclaimBytes := fileBytes - shmemBytes
+	// memory.reclaim returns EAGAIN for partial reclaim. os.File.Write can
+	// interpret it as pollable I/O and wait forever; use one kernel write.
+	fd, err := syscall.Open(path.Join(groupPath, "memory.reclaim"), syscall.O_WRONLY|syscall.O_CLOEXEC, 0)
+	if err != nil {
+		return fmt.Errorf("open memory.reclaim for reusable cgroup %q: %w", group, err)
+	}
+	defer syscall.Close(fd)
+	for {
+		_, err = syscall.Write(fd, []byte(strconv.FormatUint(reclaimBytes, 10)))
+		if !errors.Is(err, syscall.EINTR) {
+			break
+		}
+	}
+	if err != nil && !errors.Is(err, syscall.EAGAIN) {
+		return fmt.Errorf("reclaim %d file-cache bytes from reusable cgroup %q: %w", reclaimBytes, group, err)
+	}
+	// EAGAIN means the kernel reclaimed less than requested. That best-effort
+	// progress is sufficient here; the next reuse cycle can reclaim again.
+	return nil
+}
