 Wants=network-online.target cube-sandbox-cube-egress-net.service
 ConditionPathExists=/usr/local/services/cubetoolbox/.one-click.env
 PartOf=cube-sandbox-control.target cube-sandbox-compute.target
@@ -14,6 +15,11 @@ PartOf=cube-sandbox-control.target cube-sandbox-compute.target
 # Cubelet; without TPROXY rules, no sandbox traffic reaches us anyway,
 # which is the correct state until the first sandbox lands.
 
+# Cubelet startup can recover stale TAPs by deleting their egress policies.
+# Keep the loopback admin API available before Cubelet starts; requiring or
+# ordering cube-egress after Cubelet creates a startup cycle during recovery.
+# The net.service may still finish later when cube-dev appears.
+
 [Service]
 Type=simple
 User=root
