+        """Resolve CubeSandbox's existing L4 host-port mapping.
+
+        This is the control-plane endpoint for callers that need a native
+        TCP connection to a sandbox port. It deliberately does not use
+        get_host(), which returns a virtual HTTP authority.
+        """
+        if isinstance(container_port, bool) or not isinstance(container_port, int):
+            raise ValueError("container_port must be an integer between 1 and 65535")
+        if not 1 <= container_port <= 65535:
+            raise ValueError("container_port must be between 1 and 65535")
+
+        resp = self._session.get(
+            f"{self._config.api_url}/sandboxes/{self.sandbox_id}/ports/{container_port}"
+        )
+        _check_response(resp)
+        mapping = SandboxTcpEndpoint.from_dict(resp.json())
+        if mapping.sandbox_id != self.sandbox_id:
+            raise ApiError(
+                f"endpoint belongs to sandbox {mapping.sandbox_id!r}, "
+                f"not {self.sandbox_id!r}"
+            )
+        if mapping.container_port != container_port:
+            raise ApiError(
+                f"endpoint is for container port {mapping.container_port}, "
+                f"not {container_port}"
+            )
+        return mapping
