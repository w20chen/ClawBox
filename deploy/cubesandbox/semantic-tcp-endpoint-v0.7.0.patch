+    pub async fn get_sandbox_port_endpoint(
+        &self,
+        sandbox_id: &str,
+        container_port: u16,
+    ) -> AppResult<SandboxTcpEndpoint> {
+        if container_port == 0 {
+            return Err(AppError::BadRequest(
+                "container port must be between 1 and 65535".to_string(),
+            ));
+        }
+
+        let response = self
+            .cubemaster
+            .get_sandbox_with_port(
+                sandbox_id,
+                &self.instance_type,
+                Some(i32::from(container_port)),
+            )
+            .await
+            .map_err(|e| sandbox_not_found_or_internal(e, sandbox_id))?;
+
+        let ret_code = response.ret.ret_code;
+        let ret_msg = response.ret.ret_msg;
+        if !is_success_ret_code(ret_code) {
+            if ret_code == RET_CODE_NOT_FOUND {
+                return Err(AppError::NotFound(format!(
+                    "sandbox {} not found",
+                    sandbox_id
+                )));
+            }
+            return Err(AppError::Internal(anyhow::anyhow!(ret_msg)));
+        }
+
+        let item = response
+            .data
+            .into_iter()
+            .find(|item| item.sandbox_id == sandbox_id)
+            .ok_or_else(|| AppError::NotFound(format!("sandbox {} not found", sandbox_id)))?;
+
+        let host_ip: std::net::IpAddr = item.host_ip.parse().map_err(|_| {
+            AppError::Internal(anyhow::anyhow!(format!(
+                "sandbox {} returned invalid HostIP {:?}",
+                sandbox_id, item.host_ip
+            )))
+        })?;
+        if item.exposed_port_mode != "host_port" {
+            return Err(AppError::Internal(anyhow::anyhow!(format!(
+                "sandbox {} returned unsupported port mode {:?}; expected host_port",
+                sandbox_id, item.exposed_port_mode
+            ))));
+        }
+
+        let endpoint: std::net::SocketAddr = item.exposed_port_endpoint.parse().map_err(|_| {
+            AppError::Internal(anyhow::anyhow!(format!(
+                "sandbox {} returned invalid exposed port endpoint {:?}",
+                sandbox_id, item.exposed_port_endpoint
+            )))
+        })?;
+        if endpoint.ip() != host_ip {
+            return Err(AppError::Internal(anyhow::anyhow!(format!(
+                "sandbox {} HostIP {:?} does not match endpoint {:?}",
+                sandbox_id, host_ip, endpoint
+            ))));
+        }
+
+        Ok(SandboxTcpEndpoint {
+            sandbox_id: sandbox_id.to_string(),
+            container_port,
+            address: endpoint.to_string(),
+        })
+    }
