+package cubebox
+
+import (
+	"context"
+	cubebox "github.com/tencentcloud/CubeSandbox/Cubelet/api/services/cubebox/v1"
+	cubeboxstore "github.com/tencentcloud/CubeSandbox/Cubelet/pkg/store/cubebox"
+	"testing"
+)
+
+type noInventoryForInfo struct{ fakeCubeboxAPI }
+
+func (*noInventoryForInfo) List() []*cubeboxstore.CubeBox {
+	panic("single-sandbox Info must not enumerate unrelated sandboxes")
+}
+
+func TestListSingleSandboxDoesNotEnumerateInventory(t *testing.T) {
+	store := &noInventoryForInfo{fakeCubeboxAPI: fakeCubeboxAPI{
+		cb: newCubeboxWithStatusForTest("target", cubeboxstore.Status{}),
+	}}
+	service := &service{cubeboxMgr: &local{cubeboxManger: store}}
+	id := "target"
+	rsp, err := service.List(context.Background(), &cubebox.ListCubeSandboxRequest{Id: &id})
+	if err != nil || len(rsp.Items) != 1 || rsp.Items[0].Id != id {
+		t.Fatalf("single sandbox result: %+v, %v", rsp, err)
+	}
+	missing := "absent"
+	rsp, err = service.List(context.Background(), &cubebox.ListCubeSandboxRequest{Id: &missing})
+	if err != nil || len(rsp.Items) != 0 {
+		t.Fatalf("missing result: %+v, %v", rsp, err)
+	}
+}
