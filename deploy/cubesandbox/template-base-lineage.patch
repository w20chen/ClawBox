+    #[test]
+    fn external_template_base_is_inherited_without_copy_or_charge() {
+        let directory = Directory::new();
+        let template = directory.0.join("template.mem");
+        let delta = directory.0.join("delta.mem");
+        let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as u64;
+        let layout = vec![Range { gpa: 0x40000000, offset: 0, length: 2 * page }];
+        fs::write(&template, vec![0x5a; (2 * page) as usize]).unwrap();
+        let file = File::create(&delta).unwrap();
+        file.set_len(2 * page).unwrap();
+        file.write_all_at(&vec![0; page as usize], page).unwrap();
+        Lineage::inherit(
+            &delta,
+            Some((&template, &Lineage::external_base(template.clone(), layout.clone()))),
+            2 * page,
+        ).unwrap().publish(
+            &delta,
+            vec![Range { gpa: 0x40000000 + page, offset: page, length: page }],
+            false,
+        ).unwrap();
+        let child = Lineage::load(&delta, &layout, page).unwrap().unwrap();
+        assert_eq!(child.layers[0].external_path.as_ref(), Some(&template));
+        assert_eq!(child.allocated_bytes, file.metadata().unwrap().blocks() * 512);
+        assert_eq!(child.dirty_bytes, Some(page));
+        assert!(!layer_dir(&delta).join("000000.mem").exists());
+        fs::remove_file(&template).unwrap();
+        assert!(Lineage::load(&delta, &layout, page).is_err());
+    }
