+func relocatePauseSnapshot(ctx context.Context, req *types.UpdateRequest, hostIP string) *types.Res {
+	rsp := &types.Res{Ret: &types.Ret{RetCode: int(errorcode.ErrorCode_Success), RetMsg: errorcode.ErrorCode_Success.String()}}
+	rec, err := pausesnap.GetBySandbox(ctx, req.SandboxID)
+	if err != nil || rec == nil || !strings.EqualFold(strings.TrimSpace(rec.Status), "READY") {
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_MasterParamsError)
+		rsp.Ret.RetMsg = "paused snapshot is not ready for relocation"
+		return rsp
+	}
+	if strings.TrimSpace(req.SnapshotTier) != "cold" || req.SnapshotGeneration == 0 || strings.TrimSpace(req.MemorySnapshotPath) == "" {
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_MasterParamsError)
+		rsp.Ret.RetMsg = "invalid cold relocation placement"
+		return rsp
+	}
+	targetIP := strings.TrimSpace(rec.NodeIP)
+	if targetIP == "" {
+		targetIP = strings.TrimSpace(hostIP)
+	}
+	cubeReq := &cubebox.UpdateCubeSandboxRequest{
+		RequestID: req.RequestID,
+		SandboxID: req.SandboxID,
+		Annotations: map[string]string{
+			constants.CubeAnnotationsUpdateAction:   "relocate_snapshot",
+			constants.CubeAnnotationPauseSnapshotID: rec.SnapshotID,
+			"clawbox.snapshot.tier":                 "cold",
+			"clawbox.snapshot.memory.path":          req.MemorySnapshotPath,
+			"clawbox.snapshot.generation":           strconv.FormatUint(req.SnapshotGeneration, 10),
+		},
+	}
+	cubeRsp, callErr := cubelet.UpdateWithTimeout(ctx, cubelet.GetCubeletAddr(targetIP), cubeReq, pauseCubeletRPCTimeout)
+	if callErr != nil || cubeRsp == nil || cubeRsp.GetRet() == nil {
+		rsp.Ret.RetCode = int(errorcode.ErrorCode_ReqCubeAPIFailed)
+		if callErr != nil {
+			rsp.Ret.RetMsg = callErr.Error()
+		} else {
+			rsp.Ret.RetMsg = "cubelet relocation response is nil"
+		}
+		return rsp
+	}
+	rsp.Ret.RetCode = int(cubeRsp.GetRet().GetRetCode())
+	rsp.Ret.RetMsg = cubeRsp.GetRet().GetRetMsg()
+	return rsp
+}
