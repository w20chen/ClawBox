# Copy to a file outside Git, fill the three secrets, then source it.
# This is the complete operator input for the single-node paper deployment.
export CUBE_MYSQL_PASSWORD='replace-me'
export CUBE_MYSQL_ROOT_PASSWORD='replace-me'
export CUBE_REDIS_PASSWORD='replace-me'

export CUBE_API_URL='http://127.0.0.1:30030'
export CUBE_PROXY_NODE_IP='127.0.0.1'
export CUBE_PROXY_PORT_HTTP='30080'
export CLAWBOX_CONTROL_HOST='replace-with-kunpeng-address-reachable-from-runtime'
export CLAWBOX_MODEL_GATEWAY_HOST="$CLAWBOX_CONTROL_HOST"
export CLAWTUNE_ROOT="$HOME/ClawTune"

# Defaults below match the evaluated Kunpeng 920B artifact.
export CUBE_NAMESPACE='cube-system'
export CUBE_RELEASE='cube'
export CLAWBOX_REGISTRY='127.0.0.1:5000/clawbox'
export CLAWBOX_GUEST_REGISTRY='172.17.0.1:5001/clawbox'
export CUBE_GUEST_KERNEL_DIGEST='f84e3fa28ae692f34645aa3c7034999242760eb25aab0ea667b43f16ac12c27f'

